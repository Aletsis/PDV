@inherits LayoutComponentBase
@using PDV.WebUI.Theme
@inject PDV.WebUI.Services.ConnectionMonitor ConnectionMonitor
@inject PDV.WebUI.Services.ShiftSessionService ShiftSession
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@implements IDisposable
@inject IServiceProvider ServiceProvider
@using Microsoft.EntityFrameworkCore
@using PDV.Application.Common.Interfaces


<MudThemeProvider Theme="PremiumTheme.Theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <img src="/api/logos/app" alt="Logo" class="ml-2 mr-1" style="height: 38px; width: auto; max-width: 120px; object-fit: contain; border-radius: 4px;" />
        <MudText Typo="Typo.h6" Class="ml-2 d-none d-md-inline">CARNICERIA LA BLANQUITA</MudText>
        <MudText Typo="Typo.subtitle1" Class="ml-2 d-inline d-md-none">LA BLANQUITA</MudText>
        <MudSpacer />
        @if (!ConnectionMonitor.IsLocalMode)
        {
            <MudChip T="string" Color="Color.Success" Variant="Variant.Text" Icon="@Icons.Material.Filled.CloudDone" Class="mr-4 text-white">
                <span class="d-none d-sm-inline">Nube (Online)</span>
            </MudChip>
        }
        else
        {
            @if (ConnectionMonitor.IsConnected)
            {
                <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Wifi" Class="mr-2 px-3" Style="border-radius: 20px;">
                    <span class="d-none d-sm-inline">Caja (Online)</span>
                </MudChip>
            }
            else
            {
                <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Icon="@Icons.Material.Filled.WifiOff" Class="mr-2 px-3 pulse-warning" Style="border-radius: 20px;">
                    <span class="d-none d-sm-inline">Caja (Offline)</span>
                </MudChip>
            }

            @if (_hardwareAgentConnected)
            {
                <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Print" Class="mr-2 px-3" Style="border-radius: 20px;">
                    <span class="d-none d-sm-inline">Impresora OK</span>
                </MudChip>
            }
            else
            {
                <MudChip T="string" Color="Color.Error" Variant="Variant.Filled" Icon="@Icons.Material.Filled.PrintDisabled" Class="mr-2 px-3 pulse-error" Style="border-radius: 20px;">
                    <span class="d-none d-sm-inline">Impresora Error</span>
                </MudChip>
            }

            @if (_pendingSyncCount > 0)
            {
                <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Sync" Class="mr-4 px-3 pulse-warning" Style="border-radius: 20px;">
                    <span>Cola: @_pendingSyncCount</span>
                </MudChip>
            }
        }
        <AuthorizeView>
            <Authorized>
                @if (ShiftSession.HasActiveShift)
                {
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled"
                             Icon="@Icons.Material.Filled.LockOpen" Class="mr-2 px-3"
                             Style="border-radius: 20px; font-size: 0.78rem;">
                        @ShiftSession.CashRegisterName
                    </MudChip>
                }
                <MudText Class="mr-4 d-none d-sm-inline">Hola, @context.User.Identity?.Name</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="/Account/Logout" Class="d-none d-sm-inline-flex">Salir</MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Secondary" Variant="Variant.Filled" Href="/Account/Logout" Class="d-inline-flex d-sm-none" Size="Size.Small" />
            </Authorized>
            <NotAuthorized>
                <MudLink Href="login" Color="Color.Inherit">Login</MudLink>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Responsive" Elevation="2">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="pa-4 pt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;
    private string? _lastErrorShown;

    private bool _hardwareAgentConnected = false;
    private int _pendingSyncCount = 0;
    private System.Threading.Timer? _uiTimer;
    private readonly HttpClient _localHttpClient = new() { Timeout = TimeSpan.FromSeconds(2) };

    protected override void OnInitialized()
    {
        ConnectionMonitor.OnConnectionStatusChanged += OnConnectionStatusChanged;

        // Iniciar polling de estado de impresora y outbox cada 5 segundos
        _uiTimer = new System.Threading.Timer(async _ =>
        {
            await CheckHardwareAgentHealthAsync();
            if (ConnectionMonitor.IsLocalMode)
            {
                await CheckPendingSyncCountAsync();
            }
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(5));
    }

    private async Task CheckHardwareAgentHealthAsync()
    {
        try
        {
            var response = await _localHttpClient.GetAsync("http://127.0.0.1:9000/health");
            _hardwareAgentConnected = response.IsSuccessStatusCode;
        }
        catch
        {
            _hardwareAgentConnected = false;
        }
    }

    private async Task CheckPendingSyncCountAsync()
    {
        try
        {
            using var scope = ServiceProvider.CreateScope();
            var context = scope.ServiceProvider.GetRequiredService<IApplicationDbContext>();
            _pendingSyncCount = await context.OutboxMessages.CountAsync(m => m.State == PDV.Domain.Enums.OutboxState.Pending);
        }
        catch
        {
            // Omitir si la base de datos está bloqueada temporalmente
        }
    }

    protected override void OnParametersSet()
    {
        CheckForErrors();
    }

    private void CheckForErrors()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("error", out var errorVal))
        {
            var error = errorVal.ToString();
            if (error != _lastErrorShown)
            {
                _lastErrorShown = error;
                if (error == "NotACashRegisterTerminal")
                {
                    Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
                    Snackbar.Add("Acceso Denegado: Esta terminal no está autorizada para operaciones de caja.", Severity.Error, config => {
                        config.VisibleStateDuration = 10000;
                        config.HideTransitionDuration = 500;
                        config.ShowTransitionDuration = 500;
                        config.ShowCloseIcon = true;
                    });
                }
            }
        }
        else
        {
            _lastErrorShown = null;
        }
    }

    private void OnConnectionStatusChanged(bool isConnected)
    {
        InvokeAsync(StateHasChanged);
    }

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    public void Dispose()
    {
        ConnectionMonitor.OnConnectionStatusChanged -= OnConnectionStatusChanged;
        _uiTimer?.Dispose();
        _localHttpClient?.Dispose();
    }
}
