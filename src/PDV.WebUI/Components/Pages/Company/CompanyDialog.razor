@using MediatR
@using PDV.Application.Features.Companies.Commands.CreateCompany
@using PDV.Application.Features.Companies.Commands.UpdateCompany
@inject IMediator Mediator
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@(IsEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.Business)" Color="Color.Primary" Size="Size.Medium" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">@(IsEdit ? "Editar Empresa" : "Registrar Nueva Empresa")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="companyForm" ValidationDelay="300">
            <MudGrid>
                <!-- Left side: General Info -->
                <MudItem xs="12" md="6">
                    <div class="d-flex flex-column gap-4">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Color="Color.Primary">DATOS FISCALES</MudText>
                        
                        <MudTextField @bind-Value="Model.RFC" Label="RFC de la Empresa" 
                                      Variant="Variant.Outlined" Required="true" RequiredError="El RFC es obligatorio"
                                      Disabled="@IsEdit" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Description" 
                                      HelperText="12 o 13 caracteres, formato SAT" />
                        
                        <MudTextField @bind-Value="Model.Name" Label="Razón Social / Nombre" 
                                      Variant="Variant.Outlined" Required="true" RequiredError="El nombre es obligatorio"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.BusinessCenter" />
                        
                        <MudTextField @bind-Value="Model.Phone" Label="Teléfono de Contacto" 
                                      Variant="Variant.Outlined" Required="true" RequiredError="El teléfono es obligatorio"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Phone" />
                        
                        <MudTextField @bind-Value="Model.Email" Label="Correo Electrónico" 
                                      Variant="Variant.Outlined" Required="false"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email" />
                    </div>
                </MudItem>
                
                <!-- Right side: Fiscal Address -->
                <MudItem xs="12" md="6">
                    <div class="d-flex flex-column gap-4">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Color="Color.Primary">DIRECCIÓN FISCAL</MudText>
                        
                        <MudTextField @bind-Value="Model.Street" Label="Calle y Número" 
                                      Variant="Variant.Outlined" Required="true" RequiredError="La calle y número son obligatorios"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Home" />
                        
                        <MudTextField @bind-Value="Model.City" Label="Ciudad / Municipio" 
                                      Variant="Variant.Outlined" Required="true" RequiredError="La ciudad es obligatoria"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.LocationCity" />

                        <MudTextField @bind-Value="Model.State" Label="Estado" 
                                      Variant="Variant.Outlined" Required="true" RequiredError="El estado es obligatorio"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Map" />

                        <MudTextField @bind-Value="Model.ZipCode" Label="Código Postal" 
                                      Variant="Variant.Outlined" Required="true" RequiredError="El código postal es obligatorio"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.LocalPostOffice" />

                        <MudTextField @bind-Value="Model.Country" Label="País" 
                                      Variant="Variant.Outlined" Required="true" RequiredError="El país es obligatorio"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Public" />
                    </div>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Style="text-transform: none; font-weight: 500;">Cancelar</MudButton>
        <PdvInteractiveButton Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="Save" IsLoading="@_saving">
            Guardar
        </PdvInteractiveButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public bool IsEdit { get; set; }

    [Parameter]
    public CompanyFormModel Model { get; set; } = new();

    private MudForm companyForm = null!;
    private bool _saving = false;

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        await companyForm.Validate();
        if (!companyForm.IsValid) return;

        _saving = true;
        try
        {
            if (IsEdit)
            {
                var result = await Mediator.Send(new UpdateCompanyCommand
                {
                    Id = Model.Id,
                    Name = Model.Name,
                    RFC = Model.RFC,
                    Phone = Model.Phone,
                    Email = Model.Email,
                    Street = Model.Street,
                    City = Model.City,
                    State = Model.State,
                    ZipCode = Model.ZipCode,
                    Country = Model.Country
                });

                if (result.IsSuccess)
                {
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                {
                    Snackbar.Add($"Error: {result.Error.Description}", Severity.Error);
                }
            }
            else
            {
                var result = await Mediator.Send(new CreateCompanyCommand
                {
                    Name = Model.Name,
                    RFC = Model.RFC,
                    Phone = Model.Phone,
                    Email = Model.Email,
                    Street = Model.Street,
                    City = Model.City,
                    State = Model.State,
                    ZipCode = Model.ZipCode,
                    Country = Model.Country
                });

                if (result.IsSuccess)
                {
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                {
                    Snackbar.Add($"Error: {result.Error.Description}", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error inesperado: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    public class CompanyFormModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string RFC { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string? Email { get; set; }
        public string Street { get; set; } = string.Empty;
        public string City { get; set; } = string.Empty;
        public string State { get; set; } = string.Empty;
        public string ZipCode { get; set; } = string.Empty;
        public string Country { get; set; } = "México";
    }
}
