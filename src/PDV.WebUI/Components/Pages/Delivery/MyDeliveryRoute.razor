@page "/orders/my-route"
@using MediatR
@using Microsoft.AspNetCore.Identity
@using PDV.Domain.Entities
@using PDV.Domain.Enums
@using PDV.Application.Common.Interfaces
@using PDV.Application.Features.DeliveryRoutes.Queries.GetMyActiveRoute
@using PDV.Application.Features.Orders.Commands.ReportOrderDelivery
@using PDV.Application.Features.Drivers.Dtos
@using PDV.Application.Features.Drivers.Queries.GetMyDriverStatus
@using PDV.Application.Features.Drivers.Commands.SetDriverStatus
@using PDV.Application.Features.Branches.Queries.GetBranches
@inject IMediator Mediator
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthStateProvider
@inject ICurrentUserService CurrentUserService
@inject IIdentityService IdentityService
@inject IJSRuntime JS
@attribute [Authorize(Roles = "Admin,Manager,DeliveryMan")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Mi Ruta de Reparto</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-8">
    <div class="d-flex justify-space-between align-center flex-wrap gap-4 mb-4">
        <div>
            <MudText Typo="Typo.h4" Class="font-weight-bold d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.TwoWheeler" Color="Color.Primary" Size="Size.Large" />
                Mi Ruta de Reparto
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Consulte sus pedidos asignados, navegue hacia el domicilio y registre el estado de cada entrega.
            </MudText>
        </div>
        <div class="d-flex align-center flex-wrap gap-3">
            <!-- Control de Disponibilidad del Repartidor -->
            @if (_myDriverStatus != null)
            {
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Filled"
                                   Color="@GetStatusColor(_myDriverStatus.Status)"
                                   StartIcon="@GetStatusIcon(_myDriverStatus.Status)"
                                   EndIcon="@Icons.Material.Filled.ArrowDropDown"
                                   Size="Size.Medium">
                            @GetStatusLabel(_myDriverStatus.Status)
                        </MudButton>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success" OnClick="@(() => ChangeMyStatus(PickerAvailabilityStatus.Available))">
                            <strong>Disponible</strong> (Listo para recibir rutas)
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Restaurant" IconColor="Color.Warning" OnClick="@(() => ChangeMyStatus(PickerAvailabilityStatus.MealBreak))">
                            <strong>Hora de Comida</strong> (Pausar asignación)
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.PauseCircle" IconColor="Color.Info" OnClick="@(() => ChangeMyStatus(PickerAvailabilityStatus.OperationalBreak))">
                            <strong>Pausa Operativa</strong> (Carga / Gasolina / Pausa)
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Cancel" IconColor="Color.Error" OnClick="@(() => ChangeMyStatus(PickerAvailabilityStatus.OffDuty))">
                            <strong>Fuera de Turno</strong> (Fin de jornada / Descanso)
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>

                <MudChip T="string" Color="Color.Success" Variant="Variant.Text" Size="Size.Small" Icon="@Icons.Material.Filled.TaskAlt">
                    @_myDriverStatus.DeliveriesCompletedToday entregas hoy
                </MudChip>
            }

            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadRouteAsync">
                Actualizar
            </MudButton>
        </div>
    </div>

    <!-- Alerta de Estado No Disponible -->
    @if (_myDriverStatus != null && _myDriverStatus.Status != PickerAvailabilityStatus.Available)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4 d-flex justify-space-between align-center">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@GetStatusIcon(_myDriverStatus.Status)" />
                <span>
                    Tu estado actual es <strong>@GetStatusLabel(_myDriverStatus.Status)</strong>. El sistema te muestra en pausa para la asignación de nuevas rutas.
                </span>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.PlayArrow" Class="ml-4" OnClick="@(() => ChangeMyStatus(PickerAvailabilityStatus.Available))">
                Ponerme Disponible
            </MudButton>
        </MudAlert>
    }

    @if (_isLoading)
    {
        <div class="d-flex justify-center align-center py-12">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else if (_activeRoute == null)
    {
        <MudPaper Elevation="3" Class="pa-8 text-center d-flex flex-column align-center justify-center" Style="min-height: 350px;">
            <MudIcon Icon="@Icons.Material.Filled.NoCrash" Style="font-size: 4.5rem;" Color="Color.Default" Class="mb-3" />
            <MudText Typo="Typo.h5" Class="font-weight-bold">Sin Ruta Activa</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-2" Style="max-width: 450px;">
                No tienes ninguna ruta de entrega asignada actualmente. Acércate con el encargado de sucursal para tu siguiente asignación.
            </MudText>
        </MudPaper>
    }
    else
    {
        <!-- Resumen de la Ruta -->
        <MudCard Elevation="3" Class="mb-4" Style="background: linear-gradient(135deg, var(--mud-palette-primary) 0%, var(--mud-palette-primary-darken) 100%); color: white;">
            <MudCardContent Class="pa-4">
                <div class="d-flex justify-space-between align-center flex-wrap gap-2">
                    <div>
                        <MudText Typo="Typo.h5" Class="font-weight-bold text-white">
                            Ruta #@_activeRoute.Folio @(!string.IsNullOrWhiteSpace(_activeRoute.DeliveryZone?.Name) ? $"({_activeRoute.DeliveryZone.Name})" : "")
                        </MudText>
                        <MudText Typo="Typo.body2" Style="opacity: 0.9;" Class="text-white">
                            Despachada: @((_activeRoute.DispatchedDate ?? _activeRoute.CreatedDate).ToString("dd/MM/yyyy HH:mm"))
                        </MudText>
                    </div>
                    <div class="d-flex gap-4 align-center">
                        <div class="text-right">
                            <MudText Typo="Typo.caption" Style="opacity: 0.8;" Class="text-white">Total a Cobrar</MudText>
                            <MudText Typo="Typo.h5" Class="font-weight-bold text-white">
                                $@_activeRoute.Orders.Where(o => o.Status != OrderStatus.Cancelled).Sum(o => o.TotalAmount).ToString("F2")
                            </MudText>
                        </div>
                        <MudChip T="string" Color="Color.Surface" Size="Size.Small" Class="font-weight-bold">
                            @_activeRoute.Orders.Count(o => o.Status == OrderStatus.Delivered) / @_activeRoute.Orders.Count Entregados
                        </MudChip>
                    </div>
                </div>
            </MudCardContent>
        </MudCard>

        <!-- Lista de Paradas / Pedidos -->
        <div class="d-flex flex-column gap-4">
            @foreach (var (order, index) in _activeRoute.Orders.Select((o, i) => (o, i + 1)))
            {
                var isDelivered = order.Status == OrderStatus.Delivered;
                var isReturned = order.Status == OrderStatus.Returned;
                var isPendingDelivery = order.Status == OrderStatus.EnRoute || order.Status == OrderStatus.Confirmed || order.Status == OrderStatus.Routed;

                <MudCard Elevation="2" Class="@($"border-solid border-1 {(isDelivered ? "mud-border-success" : isReturned ? "mud-border-error" : "mud-border-primary")}")">
                    <MudCardHeader Class="pb-2">
                        <CardHeaderContent>
                            <div class="d-flex justify-space-between align-center">
                                <div class="d-flex align-center gap-2">
                                    <MudAvatar Color="@(isDelivered ? Color.Success : isReturned ? Color.Error : Color.Primary)" Size="Size.Medium">
                                        @index
                                    </MudAvatar>
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                                            @order.Series-@order.Folio — @(order.Client?.Name ?? "Público General")
                                        </MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                                            Importe: <strong>$@order.TotalAmount.ToString("F2")</strong> (@(order.PaymentMethod == PaymentMethodType.Cash ? "Efectivo" : "Tarjeta / Otro"))
                                        </MudText>
                                    </div>
                                </div>

                                <div>
                                    @if (isDelivered)
                                    {
                                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                                            Entregado
                                        </MudChip>
                                    }
                                    else if (isReturned)
                                    {
                                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Cancel">
                                            No Entregado (@order.ReturnReason)
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.DirectionsRun">
                                            En Camino
                                        </MudChip>
                                    }
                                </div>
                            </div>
                        </CardHeaderContent>
                    </MudCardHeader>

                    <MudCardContent Class="py-2">
                        <!-- Dirección y Contacto -->
                        <div class="pa-3 mb-2" style="background: var(--mud-palette-background-grey); border-radius: 8px;">
                            <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Color="Color.Error" Size="Size.Small" />
                                    <MudText Typo="Typo.body2" Class="font-weight-medium">
                                        @(order.Client?.Address?.ToFullAddressString() ?? "Sin dirección registrada")
                                    </MudText>
                                </div>
                                @if (order.Client?.Address != null)
                                {
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Map"
                                               OnClick="@(() => OpenNavigation(order.Client.Address.ToFullAddressString()))">
                                        Ver en Mapa
                                    </MudButton>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(order.Client?.Phone))
                            {
                                <div class="d-flex align-center justify-space-between flex-wrap gap-2 mt-2 pt-2 border-t-1 mud-border-lines-default">
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Phone" Color="Color.Success" Size="Size.Small" />
                                        <MudText Typo="Typo.body2">@order.Client.Phone</MudText>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <MudIconButton Icon="@Icons.Material.Filled.Phone"
                                                       Color="Color.Success"
                                                       Size="Size.Small"
                                                       Href="@($"tel:{order.Client.Phone}")"
                                                       title="Llamar al cliente" />
                                        <MudIconButton Icon="@Icons.Custom.Brands.WhatsApp"
                                                       Color="Color.Success"
                                                       Size="Size.Small"
                                                       Href="@($"https://wa.me/52{order.Client.Phone.Replace(" ", "").Replace("-", "")}")"
                                                       target="_blank"
                                                       title="Enviar WhatsApp" />
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Notas de entrega -->
                        @if (!string.IsNullOrWhiteSpace(order.DeliveryNotes) || !string.IsNullOrWhiteSpace(order.GeneralNotes))
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="text-sm">
                                <strong>Instrucciones:</strong> @(order.DeliveryNotes ?? order.GeneralNotes)
                            </MudAlert>
                        }
                    </MudCardContent>

                    <!-- Acciones de Entrega -->
                    @if (isPendingDelivery)
                    {
                        <MudCardActions Class="justify-end gap-2 pa-3 border-t-1 mud-border-lines-default">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Cancel"
                                       OnClick="@(() => OpenNotDeliveredDialog(order))">
                                No Entregado
                            </MudButton>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.CheckCircle"
                                       OnClick="@(() => MarkDeliveredAsync(order))">
                                Marcar Entregado
                            </MudButton>
                        </MudCardActions>
                    }
                </MudCard>
            }
        </div>
    }
</MudContainer>

@code {
    private DeliveryRoute? _activeRoute;
    private DriverStatusDto? _myDriverStatus;
    private Guid _myBranchId = Guid.Empty;
    private bool _isLoading = false;
    private string _currentUserId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? user.Identity?.Name ?? "";
        
        if (CurrentUserService.BranchId.HasValue && CurrentUserService.BranchId.Value != Guid.Empty)
        {
            _myBranchId = CurrentUserService.BranchId.Value;
        }
        else if (!string.IsNullOrWhiteSpace(_currentUserId))
        {
            var userDto = await IdentityService.GetUserByIdAsync(_currentUserId);
            if (userDto?.BranchId.HasValue == true)
            {
                _myBranchId = userDto.BranchId.Value;
            }
        }

        if (_myBranchId == Guid.Empty)
        {
            var branches = await Mediator.Send(new GetBranchesQuery());
            _myBranchId = branches.FirstOrDefault()?.Id ?? Guid.Empty;
        }

        await LoadRouteAsync();
    }

    private async Task LoadRouteAsync()
    {
        if (string.IsNullOrWhiteSpace(_currentUserId)) return;

        _isLoading = true;
        try
        {
            _activeRoute = await Mediator.Send(new GetMyActiveRouteQuery(_currentUserId));

            var effectiveBranchId = _activeRoute?.BranchId ?? _myBranchId;
            if (effectiveBranchId != Guid.Empty)
            {
                _myBranchId = effectiveBranchId;
                _myDriverStatus = await Mediator.Send(new GetMyDriverStatusQuery(_currentUserId, effectiveBranchId));
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar ruta: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ChangeMyStatus(PickerAvailabilityStatus newStatus)
    {
        if (string.IsNullOrWhiteSpace(_currentUserId) || _myBranchId == Guid.Empty) return;

        try
        {
            await Mediator.Send(new SetDriverStatusCommand
            {
                UserId = _currentUserId,
                BranchId = _myBranchId,
                Status = newStatus
            });

            Snackbar.Add($"Tu disponibilidad se actualizó a {GetStatusLabel(newStatus)}.", Severity.Success);
            await LoadRouteAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cambiar disponibilidad: {ex.Message}", Severity.Error);
        }
    }

    private Color GetStatusColor(PickerAvailabilityStatus status) => status switch
    {
        PickerAvailabilityStatus.Available => Color.Success,
        PickerAvailabilityStatus.MealBreak => Color.Warning,
        PickerAvailabilityStatus.OperationalBreak => Color.Info,
        PickerAvailabilityStatus.OffDuty => Color.Error,
        _ => Color.Default
    };

    private string GetStatusIcon(PickerAvailabilityStatus status) => status switch
    {
        PickerAvailabilityStatus.Available => Icons.Material.Filled.CheckCircle,
        PickerAvailabilityStatus.MealBreak => Icons.Material.Filled.Restaurant,
        PickerAvailabilityStatus.OperationalBreak => Icons.Material.Filled.PauseCircle,
        PickerAvailabilityStatus.OffDuty => Icons.Material.Filled.Cancel,
        _ => Icons.Material.Filled.Help
    };

    private string GetStatusLabel(PickerAvailabilityStatus status) => status switch
    {
        PickerAvailabilityStatus.Available => "Disponible",
        PickerAvailabilityStatus.MealBreak => "En Comida",
        PickerAvailabilityStatus.OperationalBreak => "En Pausa",
        PickerAvailabilityStatus.OffDuty => "Fuera de Turno",
        _ => "Desconocido"
    };

    private async Task OpenNavigation(string address)
    {
        var url = $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(address)}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private async Task MarkDeliveredAsync(Order order)
    {
        try
        {
            await Mediator.Send(new ReportOrderDeliveryCommand
            {
                OrderId = order.Id,
                IsDelivered = true,
                DeliveryManId = _currentUserId
            });

            Snackbar.Add($"¡Pedido {order.Series}-{order.Folio} marcado como entregado!", Severity.Success);
            await LoadRouteAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al registrar entrega: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenNotDeliveredDialog(Order order)
    {
        var parameters = new DialogParameters<NotDeliveredReasonDialog>
        {
            { x => x.OrderNumber, $"{order.Series}-{order.Folio}" }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<NotDeliveredReasonDialog>("Reportar No Entrega", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is string reason)
        {
            try
            {
                await Mediator.Send(new ReportOrderDeliveryCommand
                {
                    OrderId = order.Id,
                    IsDelivered = false,
                    ReturnReason = reason,
                    DeliveryManId = _currentUserId
                });

                Snackbar.Add($"Pedido marcado como no entregado: {reason}", Severity.Warning);
                await LoadRouteAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error al registrar devolución: {ex.Message}", Severity.Error);
            }
        }
    }
}
