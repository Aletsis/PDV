@page "/orders/zones"
@using MediatR
@using PDV.Application.Features.DeliveryZones.Commands.CreateDeliveryZone
@using PDV.Application.Features.DeliveryZones.Commands.DeleteDeliveryZone
@using PDV.Application.Features.DeliveryZones.Queries.GetDeliveryZones
@using PDV.Application.Features.Branches.Queries.GetBranches
@using PDV.Application.Features.Branches.Dtos
@using PDV.Domain.Entities
@inject IMediator Mediator
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject PDV.WebUI.Services.ShiftSessionService ShiftSession
@inject PDV.WebUI.Services.ConnectionMonitor ConnectionMonitor
@attribute [Authorize(Roles = "Admin,Manager")]

@if (isLocalMode)
{
    <PageTitle>Acceso Denegado - Zonas de Reparto</PageTitle>
    <div class="d-flex flex-column align-center justify-center gap-4 pa-8" style="min-height: 400px;">
        <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Error" Style="font-size: 4rem;" />
        <MudText Typo="Typo.h5" Class="font-weight-bold" Align="Align.Center">Módulo no Disponible en Modo Local</MudText>
        <MudText Typo="Typo.body1" Class="mud-text-secondary" Align="Align.Center" Style="max-width: 500px;">
            La configuración de zonas de reparto está deshabilitada en esta terminal local. Por favor, acceda desde el Servidor Central para gestionar las zonas de reparto.
        </MudText>
    </div>
}
else
{
<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h4" GutterBottom="true">Zonas de Reparto</MudText>
            <MudText Typo="Typo.body1">Configure las zonas de reparto geográficas dibujando polígonos sobre el mapa asignados a cada sucursal.</MudText>
        </div>
        <div style="min-width: 250px;">
            <MudSelect T="Guid?" Label="Filtrar por Sucursal" Value="_filterBranchId" ValueChanged="OnFilterBranchChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                <MudSelectItem Value="@((Guid?)null)">Todas las Sucursales</MudSelectItem>
                @foreach (var branch in _branches)
                {
                    <MudSelectItem Value="@((Guid?)branch.Id)">@branch.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
    </div>

    <MudGrid>
        <MudItem xs="12" md="8">
            <MudCard Elevation="3" Style="height: 580px; position: relative;">
                <MudCardContent Style="height: 100%; padding: 0;">
                    <div id="zone-map" style="height: 100%; width: 100%; border-radius: 4px;"></div>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudCard Elevation="3" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Nueva Zona de Reparto</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudSelect T="Guid?" Label="Sucursal Responsable" @bind-Value="_selectedBranchId" Variant="Variant.Outlined" Class="mb-3" Required="true" AnchorOrigin="Origin.BottomCenter" HelperText="Seleccione a qué sucursal pertenece esta zona">
                        @foreach (var branch in _branches)
                        {
                            <MudSelectItem Value="@((Guid?)branch.Id)">@branch.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudTextField @bind-Value="_zoneName" Label="Nombre de la Zona" Variant="Variant.Outlined" Class="mb-3" HelperText="Ej: Zona Metropolitana Sur" />
                    <MudNumericField @bind-Value="_deliveryCost" Label="Costo de Envío ($)" Variant="Variant.Outlined" Format="C2" Min="0" Class="mb-3" />
                    
                    <MudText Typo="Typo.subtitle2" Color="Color.Info" Class="mb-1">
                        Puntos dibujados: @_currentCoords.Count
                    </MudText>
                    <MudText Typo="Typo.caption" Class="d-block mb-3">
                        Haga clic en el mapa para ir trazando el límite de la zona. Se necesitan al menos 3 puntos para formar un polígono.
                    </MudText>

                    <div class="d-flex gap-2">
                        <MudButton OnClick="ClearDrawing" Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ClearAll" FullWidth="true">
                            Limpiar
                        </MudButton>
                        <MudButton OnClick="SaveZone" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" FullWidth="true" Disabled="@(!IsSaveEnabled)">
                            Guardar
                        </MudButton>
                    </div>
                </MudCardContent>
            </MudCard>

            <MudCard Elevation="3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Zonas Registradas (@_zones.Count)</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Style="max-height: 250px; overflow-y: auto;">
                    @if (_zones == null || _zones.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No hay zonas configuradas para la sucursal seleccionada.</MudText>
                    }
                    else
                    {
                        <MudList T="DeliveryZone">
                            @foreach (var zone in _zones)
                            {
                                <MudListItem Icon="@Icons.Material.Filled.LocationOn" IconColor="Color.Success">
                                    <div class="d-flex align-center justify-space-between w-100">
                                        <div>
                                            <div class="d-flex align-center gap-1">
                                                <MudText Typo="Typo.body1" Class="font-weight-bold">@zone.Name</MudText>
                                                @if (zone.Branch != null)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">@zone.Branch.Name</MudChip>
                                                }
                                            </div>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Costo: @zone.DeliveryCost.ToString("C2")</MudText>
                                        </div>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteZone(zone.Id)" />
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>
}

@code {
    private bool isLocalMode = false;
    private string _zoneName = string.Empty;
    private decimal _deliveryCost = 0m;
    private Guid? _selectedBranchId;
    private Guid? _filterBranchId;
    private List<BranchDto> _branches = new();
    private List<double[]> _currentCoords = new();
    private List<DeliveryZone> _zones = new();
    private DotNetObjectReference<DeliveryZonesMap>? _dotNetRef;

    private bool IsSaveEnabled => !string.IsNullOrWhiteSpace(_zoneName) && _currentCoords.Count >= 3 && _selectedBranchId.HasValue && _selectedBranchId.Value != Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        isLocalMode = ConnectionMonitor.IsLocalMode;
        if (isLocalMode) return;

        _dotNetRef = DotNetObjectReference.Create(this);
        _branches = await Mediator.Send(new GetBranchesQuery(IncludeInactive: false));
        
        if (ShiftSession.BranchId.HasValue && _branches.Any(b => b.Id == ShiftSession.BranchId.Value))
        {
            _selectedBranchId = ShiftSession.BranchId.Value;
        }
        else if (_branches.Count > 0)
        {
            _selectedBranchId = _branches[0].Id;
        }

        await LoadZonesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isLocalMode) return;

        if (firstRender)
        {
            // Guadalajara, Jalisco por defecto
            await JS.InvokeVoidAsync("leafletHelper.initMap", "zone-map", _dotNetRef, 20.659698, -103.349609, 12);
            await RefreshMapZonesAsync();
        }
    }

    private async Task OnFilterBranchChanged(Guid? branchId)
    {
        _filterBranchId = branchId;
        if (branchId.HasValue)
        {
            _selectedBranchId = branchId.Value;
        }
        await LoadZonesAsync();
        await RefreshMapZonesAsync();
    }

    private async Task LoadZonesAsync()
    {
        _zones = await Mediator.Send(new GetDeliveryZonesQuery { OnlyActive = true, BranchId = _filterBranchId });
    }

    private async Task RefreshMapZonesAsync()
    {
        await JS.InvokeVoidAsync("leafletHelper.showZones", "zone-map", _zones);
    }

    [JSInvokable]
    public void OnMapClicked(double lat, double lng)
    {
        _currentCoords.Add(new double[] { lat, lng });
        StateHasChanged();
        JS.InvokeVoidAsync("leafletHelper.updateDrawPolygon", "zone-map", _currentCoords);
    }

    private async Task ClearDrawing()
    {
        _currentCoords.Clear();
        await JS.InvokeVoidAsync("leafletHelper.updateDrawPolygon", "zone-map", _currentCoords);
    }

    private async Task SaveZone()
    {
        if (!_selectedBranchId.HasValue || _selectedBranchId.Value == Guid.Empty)
        {
            Snackbar.Add("Debe seleccionar una sucursal para la zona.", Severity.Warning);
            return;
        }

        try
        {
            // Convertir coordenadas a JSON array [[lat, lng], [lat, lng], ...]
            var jsonCoords = System.Text.Json.JsonSerializer.Serialize(_currentCoords);

            var command = new CreateDeliveryZoneCommand
            {
                Name = _zoneName,
                BranchId = _selectedBranchId.Value,
                PolygonCoordinatesJson = jsonCoords,
                DeliveryCost = _deliveryCost
            };

            await Mediator.Send(command);
            Snackbar.Add("Zona de reparto guardada exitosamente.", Severity.Success);

            // Reiniciar campos
            _zoneName = string.Empty;
            _deliveryCost = 0m;
            _currentCoords.Clear();

            await JS.InvokeVoidAsync("leafletHelper.updateDrawPolygon", "zone-map", _currentCoords);
            await LoadZonesAsync();
            await RefreshMapZonesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar zona: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteZone(Guid id)
    {
        try
        {
            await Mediator.Send(new DeleteDeliveryZoneCommand(id));
            Snackbar.Add("Zona de reparto eliminada.", Severity.Success);
            await LoadZonesAsync();
            await RefreshMapZonesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al eliminar zona: {ex.Message}", Severity.Error);
        }
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }
}
