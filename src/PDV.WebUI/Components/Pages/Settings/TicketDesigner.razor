@page "/admin/settings/tickets"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@using PDV.Application.Common.Interfaces
@using PDV.Domain.Entities
@using PDV.Domain.Enums
@using PDV.Infrastructure.Printing
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@inject IApplicationDbContext DbContext
@inject ISnackbar Snackbar
@inject ITicketGenerator TicketGenerator
@inject IEscPosPrinter EscPosPrinter
@inject NavigationManager NavigationManager
@inject PDV.WebUI.Services.ConnectionMonitor ConnectionMonitor

<PageTitle>Diseñador Visual de Tickets — Administración</PageTitle>

@if (isLocalMode)
{
    <PageTitle>Acceso Denegado - Diseñador de Tickets</PageTitle>
    <div class="d-flex flex-column align-center justify-center gap-4 pa-8" style="min-height: 400px;">
        <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Error" Style="font-size: 4rem;" />
        <MudText Typo="Typo.h5" Class="font-weight-bold" Align="Align.Center">Módulo no Disponible en Modo Local</MudText>
        <MudText Typo="Typo.body1" Class="mud-text-secondary" Align="Align.Center" Style="max-width: 500px;">
            El diseñador visual de tickets está deshabilitado en esta terminal local. Por favor, acceda desde el Servidor Central para modificar las plantillas de impresión globales.
        </MudText>
        <PdvInteractiveButton Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="BackToSettings">
            Regresar
        </PdvInteractiveButton>
    </div>
}
else
{
<PdvHeader Title="Diseñador de Tickets Adaptables"
           Subtitle="Diseña y personaliza el formato visual de tus comprobantes de venta, facturas, devoluciones y cortes."
           Icon="@Icons.Material.Filled.DesignServices"
           IconColor="Color.Secondary">
    <Actions>
        <PdvInteractiveButton Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="BackToSettings">
            Regresar
        </PdvInteractiveButton>
        <PdvInteractiveButton Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveTemplate" IsLoading="@_isSaving">
            Guardar Plantilla
        </PdvInteractiveButton>
    </Actions>
</PdvHeader>

<MudGrid Class="mt-2">
    <!-- Panel Izquierdo: Selección de Plantilla y Bloques a Añadir -->
    <MudItem xs="12" md="3">
        <MudPaper Class="pa-4 mb-4" Style="background: var(--mud-palette-background-grey);">
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-3">Plantilla Activa</MudText>
            
            <MudSelect T="TicketTemplateType" Value="@_selectedType" ValueChanged="OnTemplateTypeChanged" Label="Tipo de Ticket" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Class="mb-4">
                <MudSelectItem Value="@TicketTemplateType.Sale">Ticket de Venta</MudSelectItem>
                <MudSelectItem Value="@TicketTemplateType.Invoice">Factura Electrónica (CFDI)</MudSelectItem>
                <MudSelectItem Value="@TicketTemplateType.Return">Ticket de Devolución</MudSelectItem>
                <MudSelectItem Value="@TicketTemplateType.CashCollection">Dotación / Recolección</MudSelectItem>
                <MudSelectItem Value="@TicketTemplateType.CashCut">Corte de Caja</MudSelectItem>
                <MudSelectItem Value="@TicketTemplateType.Order">Ticket de Pedido</MudSelectItem>
                <MudSelectItem Value="@TicketTemplateType.RouteManifest">Manifiesto de Reparto</MudSelectItem>
            </MudSelect>
            
            <MudDivider Class="my-4" />

            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-3">Agregar Bloques</MudText>
            <div class="d-flex flex-column gap-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Image" OnClick='() => AddBlock("Logo")'>Logotipo</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.TextFields" OnClick='() => AddBlock("Text")'>Línea de Texto</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Label" OnClick='() => AddBlock("KeyValue")'>Clave - Valor</MudButton>
                @if (_selectedType == TicketTemplateType.RouteManifest)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ListAlt" OnClick='() => AddBlock("ManifestOrders")'>Pedidos en Ruta</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Calculate" OnClick='() => AddBlock("ManifestTotals")'>Totales del Manifiesto</MudButton>
                }
                else if (_selectedType == TicketTemplateType.CashCollection)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.TableRows" OnClick='() => AddBlock("DenominationsTable")'>Desglose de Morralla</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.TableRows" OnClick='() => AddBlock("ItemsTable")'>Tabla de Artículos</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AttachMoney" OnClick='() => AddBlock("Totals")'>Bloque de Totales</MudButton>
                }
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.QrCode" OnClick='() => AddBlock("BarcodeOrQr")'>Código QR / Barra</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.HorizontalRule" OnClick='() => AddBlock("Separator")'>Separador</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Notes" OnClick='() => AddBlock("Footer")'>Pie de Página</MudButton>
            </div>
        </MudPaper>

        <MudPaper Class="pa-4" Style="background: var(--mud-palette-background-grey);">
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-3">Impresión de Prueba</MudText>
            <MudSelect T="Guid?" @bind-Value="_selectedPrinterId" Label="Impresora Destino" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Class="mb-3">
                @foreach (var p in _printers)
                {
                    <MudSelectItem Value="@((Guid?)p.Id)">@p.Name (@p.ConnectionType)</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Print" FullWidth="true" OnClick="PrintTestTicket" Disabled="@(!_selectedPrinterId.HasValue || _isPrinting)">
                @(_isPrinting ? "Imprimiendo..." : "Imprimir Prueba")
            </MudButton>
        </MudPaper>
    </MudItem>

    <!-- Panel Central: Previsualizador del Ticket Fluido -->
    <MudItem xs="12" md="5" Class="d-flex justify-center">
        <div class="d-flex flex-column align-center w-100">
            <MudToggleGroup T="int" Value="@_simulatedWidth" ValueChanged="OnSimulatedWidthChanged" Variant="Variant.Outlined" Color="Color.Primary" Class="mb-3">
                <MudToggleItem Value="@(42)" Text="80mm (Estándar)" />
                <MudToggleItem Value="@(32)" Text="58mm (Estrecho)" />
            </MudToggleGroup>

            <!-- Contenedor del Ticket Físico Simulado -->
            <div class="ticket-simulator-container" style="width: @(_simulatedWidth == 42 ? "380px" : "280px"); transition: width 0.3s ease;">
                <div class="ticket-paper">
                    @if (_templateJson.Blocks.Count == 0)
                    {
                        <div class="d-flex align-center justify-center py-8 text-muted">
                            <MudText Typo="Typo.body2">La plantilla está vacía. Agrega bloques para comenzar.</MudText>
                        </div>
                    }
                    else
                    {
                        @for (int i = 0; i < _templateJson.Blocks.Count; i++)
                        {
                            var idx = i;
                            var block = _templateJson.Blocks[idx];
                            bool isSelected = _selectedBlockIndex == idx;

                            <div class="ticket-block-wrapper @(isSelected ? "selected" : "")" @onclick="() => SelectBlock(idx)">
                                <div class="ticket-block-content">
                                    @switch (block.Type.ToLowerInvariant())
                                    {
                                        case "logo":
                                            <div class="d-flex justify-center py-2" style="border: 1px dashed #ccc;">
                                                <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Class="mud-text-secondary" />
                                                <MudText Typo="Typo.caption" Class="align-self-center ml-2">[Logotipo de Marca]</MudText>
                                            </div>
                                            break;

                                        case "text":
                                            <div class="@GetAlignClass(block.Align) @GetFontClass(block.FontSize) @(block.Bold ? "font-weight-bold" : "") @(block.Italic ? "font-italic" : "")" style="white-space: pre-wrap;">
                                                @(string.IsNullOrEmpty(block.Content) ? "Texto de ejemplo..." : ResolvePreviewVariables(block.Content))
                                            </div>
                                            break;

                                        case "keyvalue":
                                            <div class="d-flex justify-content-between w-100 @(block.Bold ? "font-weight-bold" : "")">
                                                <span>@block.Key</span>
                                                <span class="ml-auto text-monospace">@ResolvePreviewVariables(block.ValuePlaceholder ?? "{Valor}")</span>
                                            </div>
                                            break;

                                        case "separator":
                                            <div class="text-center text-monospace py-1" style="letter-spacing: 2px;">
                                                @(new string(string.IsNullOrEmpty(block.SeparatorChar) ? '-' : block.SeparatorChar[0], _simulatedWidth == 42 ? 32 : 22))
                                            </div>
                                            break;

                                        case "itemstable":
                                            <table class="w-100 text-monospace mt-1" style="font-size: 0.8rem; border-collapse: collapse;">
                                                <thead>
                                                    <tr style="border-bottom: 1px solid #000;">
                                                        @foreach (var col in block.Columns ?? new())
                                                        {
                                                            <th class="@(col.Field.ToLowerInvariant() == "name" ? "text-left" : "text-right")" style="width: @(col.WidthPercentage)%;">
                                                                @col.Title.ToUpperInvariant()
                                                            </th>
                                                        }
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        @foreach (var col in block.Columns ?? new())
                                                        {
                                                            <td class="@(col.Field.ToLowerInvariant() == "name" ? "text-left" : "text-right")">
                                                                @GetMockColumnValue(col.Field)
                                                            </td>
                                                        }
                                                    </tr>
                                                </tbody>
                                            </table>
                                            break;

                                        case "denominationstable":
                                            <table class="w-100 table-borderless text-monospace" style="font-size: 0.85rem; border-collapse: collapse;">
                                                <thead>
                                                    <tr style="border-bottom: 1px solid #000;">
                                                        @foreach (var col in block.Columns ?? new())
                                                        {
                                                            <th class="@(col.Field.ToLowerInvariant() == "name" ? "text-left" : "text-right")" style="width: @(col.WidthPercentage)%;">
                                                                @col.Title.ToUpperInvariant()
                                                            </th>
                                                        }
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        @foreach (var col in block.Columns ?? new())
                                                        {
                                                            <td class="@(col.Field.ToLowerInvariant() == "name" ? "text-left" : "text-right")">
                                                                @GetMockDenominationColumnValue(col.Field, 0)
                                                            </td>
                                                        }
                                                    </tr>
                                                    <tr>
                                                        @foreach (var col in block.Columns ?? new())
                                                        {
                                                            <td class="@(col.Field.ToLowerInvariant() == "name" ? "text-left" : "text-right")">
                                                                @GetMockDenominationColumnValue(col.Field, 1)
                                                            </td>
                                                        }
                                                    </tr>
                                                </tbody>
                                            </table>
                                            break;

                                        case "totals":
                                            <div class="d-flex flex-column align-end w-100 mt-2 text-monospace" style="font-size: 0.85rem;">
                                                @foreach (var field in block.TotalsFields ?? new List<string> { "Subtotal", "Iva", "Total", "PaymentMethod", "Change" })
                                                {
                                                    switch (field.ToLowerInvariant())
                                                    {
                                                        case "subtotal":
                                                            <div class="d-flex justify-content-between w-100">
                                                                <span>Subtotal:</span>
                                                                <span class="ml-auto">$86.20</span>
                                                            </div>
                                                            break;
                                                        case "iva":
                                                        case "tax":
                                                            <div class="d-flex justify-content-between w-100">
                                                                <span>IVA 16%:</span>
                                                                <span class="ml-auto">$13.80</span>
                                                            </div>
                                                            break;
                                                        case "total":
                                                            <div class="d-flex justify-content-between w-100 font-weight-bold" style="border-top: 1px double #000; padding-top: 2px;">
                                                                <span>TOTAL:</span>
                                                                <span class="ml-auto">$100.00</span>
                                                            </div>
                                                            break;
                                                        case "paymentmethod":
                                                            <div class="d-flex justify-content-between w-100">
                                                                <span>Forma Pago:</span>
                                                                <span class="ml-auto">Efectivo</span>
                                                            </div>
                                                            break;
                                                        case "change":
                                                            <div class="d-flex justify-content-between w-100">
                                                                <span>Cambio:</span>
                                                                <span class="ml-auto">$0.00</span>
                                                            </div>
                                                            break;
                                                    }
                                                }
                                            </div>
                                            break;

                                         case "manifestorders":
                                             <div class="d-flex flex-column w-100 mt-2 text-monospace" style="font-size: 0.85rem;">
                                                 <div class="font-weight-bold mb-1">PEDIDOS EN RUTA:</div>
                                                 @for (int oIdx = 1; oIdx <= 2; oIdx++)
                                                 {
                                                     var fields = block.ManifestOrderFields ?? new List<string> { "Folio", "Client", "Address", "Phone", "Total" };
                                                     foreach (var field in fields)
                                                     {
                                                         switch (field)
                                                         {
                                                             case "Folio":
                                                                 <div>#@oIdx Pedido: @(oIdx == 1 ? "R-000456-1" : "R-000456-2")</div>
                                                                 break;
                                                             case "Client":
                                                                 <div>Cliente: @(oIdx == 1 ? "Juan Pérez" : "María Gómez")</div>
                                                                 break;
                                                             case "Address":
                                                                 <div>Direcc: @(oIdx == 1 ? "Av. Juárez 100, Col. Centro" : "Calle Hidalgo 45")</div>
                                                                 break;
                                                             case "Phone":
                                                                 <div>Tel: @(oIdx == 1 ? "555-123-4567" : "555-987-6543")</div>
                                                                 break;
                                                             case "Total":
                                                                 <div>Total: @(oIdx == 1 ? "$150.00" : "$200.00") (@(oIdx == 1 ? "Efectivo" : "Tarjeta"))</div>
                                                                 break;
                                                         }
                                                     }
                                                     <div class="text-center text-monospace py-1" style="letter-spacing: 2px;">------------------------</div>
                                                 }
                                             </div>
                                             break;

                                         case "manifesttotals":
                                             <div class="d-flex flex-column align-end w-100 mt-2 text-monospace" style="font-size: 0.85rem;">
                                                 @foreach (var field in block.ManifestTotalsFields ?? new List<string> { "CashTotal", "OrderCount", "CardTotal", "CombinedTotal" })
                                                 {
                                                     switch (field)
                                                     {
                                                         case "CashTotal":
                                                             <div class="d-flex justify-content-between w-100">
                                                                 <span>Total Efectivo:</span>
                                                                 <span class="ml-auto">$150.00</span>
                                                             </div>
                                                             break;
                                                         case "OrderCount":
                                                             <div class="d-flex justify-content-between w-100">
                                                                 <span>Número de Pedidos:</span>
                                                                 <span class="ml-auto">2</span>
                                                             </div>
                                                             break;
                                                         case "CardTotal":
                                                             <div class="d-flex justify-content-between w-100">
                                                                 <span>Total Tarjeta:</span>
                                                                 <span class="ml-auto">$200.00</span>
                                                             </div>
                                                             break;
                                                         case "CombinedTotal":
                                                             <div class="d-flex justify-content-between w-100 font-weight-bold" style="border-top: 1px double #000; padding-top: 2px;">
                                                                 <span>TOTAL (EFECT. Y TARJ.):</span>
                                                                 <span class="ml-auto">$350.00</span>
                                                             </div>
                                                             break;
                                                     }
                                                 }
                                             </div>
                                             break;

                                        case "barcodeorqr":
                                            <div class="d-flex flex-column align-center py-2" style="border: 1px dashed #ccc;">
                                                <MudIcon Icon="@(block.CodeType?.ToLowerInvariant() == "qr" ? Icons.Material.Filled.QrCode2 : Icons.Material.Filled.ViewWeek)" Size="Size.Large" Class="mud-text-secondary" />
                                                <MudText Typo="Typo.caption" Class="mt-1">[@(block.CodeType?.ToUpperInvariant() ?? "CÓDIGO"): @ResolvePreviewVariables(block.CodifiedValue ?? "{Folio}")]</MudText>
                                            </div>
                                            break;

                                        case "footer":
                                            <div class="text-center font-italic text-wrap" style="font-size: 0.85rem; white-space: pre-wrap;">
                                                @ResolvePreviewVariables(block.Content ?? "Pie de página de ejemplo")
                                            </div>
                                            break;
                                    }
                                </div>
                                
                                <!-- Botonera de control del bloque -->
                                <div class="block-actions">
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Color="Color.Default" OnClick="() => MoveBlockUp(idx)" StopPropagation="true" Disabled="@(idx == 0)" />
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Color="Color.Default" OnClick="() => MoveBlockDown(idx)" StopPropagation="true" Disabled="@(idx == _templateJson.Blocks.Count - 1)" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteBlock(idx)" StopPropagation="true" />
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </MudItem>

    <!-- Panel Derecho: Configuración de Propiedades del Bloque Seleccionado -->
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4 h-100" Style="background: var(--mud-palette-background-grey); min-height: 500px;">
            @if (_selectedBlockIndex >= 0 && _selectedBlockIndex < _templateJson.Blocks.Count)
            {
                var block = _templateJson.Blocks[_selectedBlockIndex];
                <div class="d-flex align-center mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.Edit" Color="Color.Secondary" Class="mr-2" />
                    <MudText Typo="Typo.h6" Class="font-weight-bold">Propiedades del Bloque</MudText>
                </div>
                
                <MudText Typo="Typo.subtitle2" Class="mb-3">Tipo: <span class="font-weight-bold mud-text-secondary">@block.Type.ToUpper()</span></MudText>

                @switch (block.Type.ToLowerInvariant())
                {
                    case "logo":
                        <MudSelect @bind-Value="block.LogoScale" Label="Escala del Logotipo" Variant="Variant.Outlined" Class="mb-3">
                            <MudSelectItem Value='("25")'>Pequeño (25%)</MudSelectItem>
                            <MudSelectItem Value='("50")'>Mediano (50%)</MudSelectItem>
                            <MudSelectItem Value='("100")'>Ancho Completo (100%)</MudSelectItem>
                        </MudSelect>
                        <MudSelect @bind-Value="block.Align" Label="Alineación" Variant="Variant.Outlined">
                            <MudSelectItem Value='("Center")'>Centrado</MudSelectItem>
                            <MudSelectItem Value='("Left")'>Izquierda</MudSelectItem>
                            <MudSelectItem Value='("Right")'>Derecha</MudSelectItem>
                        </MudSelect>
                        break;

                    case "text":
                    case "footer":
                        <MudTextField @bind-Value="block.Content" Label="Contenido de Texto" Variant="Variant.Outlined" Lines="4" HelperText="Puedes insertar llaves de variables (ej. {CompanyName})" Class="mb-3" />
                        <MudGrid>
                            <MudItem xs="6">
                                <MudSelect @bind-Value="block.Align" Label="Alineación" Variant="Variant.Outlined">
                                    <MudSelectItem Value='("Left")'>Izquierda</MudSelectItem>
                                    <MudSelectItem Value='("Center")'>Centrado</MudSelectItem>
                                    <MudSelectItem Value='("Right")'>Derecha</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="6">
                                <MudSelect @bind-Value="block.FontSize" Label="Tamaño de Fuente" Variant="Variant.Outlined">
                                    <MudSelectItem Value='("Normal")'>Normal</MudSelectItem>
                                    <MudSelectItem Value='("DoubleHeight")'>Doble Altura</MudSelectItem>
                                    <MudSelectItem Value='("DoubleWidth")'>Doble Ancho</MudSelectItem>
                                    <MudSelectItem Value='("Large")'>Grande (Ambos)</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                        <div class="d-flex gap-4 mt-3">
                            <MudSwitch @bind-Value="block.Bold" Color="Color.Primary" Label="Negrita" />
                            <MudSwitch @bind-Value="block.Italic" Color="Color.Primary" Label="Cursiva" />
                        </div>
                        break;

                    case "keyvalue":
                        <MudTextField @bind-Value="block.Key" Label="Clave (Texto fijo)" Variant="Variant.Outlined" Class="mb-3" Placeholder="Ej. Folio:" />
                        <MudTextField @bind-Value="block.ValuePlaceholder" Label="Valor (Variable dinámica)" Variant="Variant.Outlined" Class="mb-3" Placeholder="Ej. {Folio}" />
                        <MudSwitch @bind-Value="block.Bold" Color="Color.Primary" Label="Negrita completa" />
                        break;

                    case "separator":
                        <MudSelect @bind-Value="block.SeparatorChar" Label="Carácter Separador" Variant="Variant.Outlined">
                            <MudSelectItem Value='("-")'>Línea Simple (-)</MudSelectItem>
                            <MudSelectItem Value='("=")'>Línea Doble (=)</MudSelectItem>
                            <MudSelectItem Value='("*")'>Línea de Asteriscos (*)</MudSelectItem>
                            <MudSelectItem Value='(".")'>Línea Punteada (.)</MudSelectItem>
                            <MudSelectItem Value='(" ")'>Espacio en Blanco ( )</MudSelectItem>
                        </MudSelect>
                        break;

                    case "itemstable":
                        <MudText Typo="Typo.subtitle2" Class="mb-2 font-weight-bold">Columnas de la Tabla</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3 d-block">Distribuye los anchos cuidando que el total sume el 100%.</MudText>
                        @if (block.Columns != null)
                        {
                            @for (int cIdx = 0; cIdx < block.Columns.Count; cIdx++)
                            {
                                var col = block.Columns[cIdx];
                                <div class="d-flex align-center gap-2 mb-2" style="background: rgba(0,0,0,0.05); padding: 8px; border-radius: 4px;">
                                    <MudSelect @bind-Value="col.Field" Label="Campo" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:120px;">
                                        <MudSelectItem Value='("Name")'>Producto</MudSelectItem>
                                        <MudSelectItem Value='("Code")'>Código</MudSelectItem>
                                        <MudSelectItem Value='("Quantity")'>Cant</MudSelectItem>
                                        <MudSelectItem Value='("Price")'>Precio (C/IVA)</MudSelectItem>
                                        <MudSelectItem Value='("PriceSinIva")'>Precio S/IVA</MudSelectItem>
                                        <MudSelectItem Value='("PriceConIva")'>Precio C/IVA</MudSelectItem>
                                        <MudSelectItem Value='("Subtotal")'>Subtotal</MudSelectItem>
                                        <MudSelectItem Value='("Iva")'>IVA del Prod</MudSelectItem>
                                        <MudSelectItem Value='("Total")'>Total</MudSelectItem>
                                    </MudSelect>
                                    <MudTextField @bind-Value="col.Title" Label="Título" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudNumericField @bind-Value="col.WidthPercentage" Label="Ancho %" Variant="Variant.Outlined" Margin="Margin.Dense" Min="5" Max="90" Style="width:80px;" />
                                    <MudIconButton Icon="@Icons.Material.Filled.RemoveCircle" Color="Color.Error" OnClick="() => RemoveColumn(block, col)" Size="Size.Small" />
                                </div>
                            }
                        }
                        <div class="d-flex justify-space-between mt-3">
                            <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="() => AddColumn(block)">Añadir Columna</MudButton>
                            <MudText Typo="Typo.caption" Color="@(GetColumnsTotalPercentage(block) == 100 ? Color.Success : Color.Error)">Total: @(GetColumnsTotalPercentage(block))%</MudText>
                        </div>
                        break;

                    case "denominationstable":
                        <MudText Typo="Typo.subtitle2" Class="mb-2 font-weight-bold">Columnas del Desglose</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3 d-block">Distribuye los anchos cuidando que el total sume el 100%.</MudText>
                        @if (block.Columns != null)
                        {
                            @for (int cIdx = 0; cIdx < block.Columns.Count; cIdx++)
                            {
                                var col = block.Columns[cIdx];
                                <div class="d-flex align-center gap-2 mb-2" style="background: rgba(0,0,0,0.05); padding: 8px; border-radius: 4px;">
                                    <MudSelect @bind-Value="col.Field" Label="Campo" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:120px;">
                                        <MudSelectItem Value='("Name")'>Denominación</MudSelectItem>
                                        <MudSelectItem Value='("Quantity")'>Cant</MudSelectItem>
                                        <MudSelectItem Value='("Total")'>Total</MudSelectItem>
                                    </MudSelect>
                                    <MudTextField @bind-Value="col.Title" Label="Título" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudNumericField @bind-Value="col.WidthPercentage" Label="Ancho %" Variant="Variant.Outlined" Margin="Margin.Dense" Min="5" Max="90" Style="width:80px;" />
                                    <MudIconButton Icon="@Icons.Material.Filled.RemoveCircle" Color="Color.Error" OnClick="() => RemoveColumn(block, col)" Size="Size.Small" />
                                </div>
                            }
                        }
                        <div class="d-flex justify-space-between mt-3">
                            <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="() => AddColumn(block)">Añadir Columna</MudButton>
                            <MudText Typo="Typo.caption" Color="@(GetColumnsTotalPercentage(block) == 100 ? Color.Success : Color.Error)">Total: @(GetColumnsTotalPercentage(block))%</MudText>
                        </div>
                        break;

                    case "totals":
                        <MudText Typo="Typo.subtitle2" Class="mb-2 font-weight-bold">Variables de Totales</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3 d-block">Selecciona qué variables mostrar y reordénalas:</MudText>

                        @if (block.TotalsFields == null || !block.TotalsFields.Any())
                        {
                            block.TotalsFields = new List<string> { "Subtotal", "Iva", "Total", "PaymentMethod", "Change" };
                        }

                        @for (int fIdx = 0; fIdx < block.TotalsFields.Count; fIdx++)
                        {
                            var index = fIdx;
                            var field = block.TotalsFields[index];
                            string displayName = _availableTotals.TryGetValue(field, out var dName) ? dName : field;

                            <div class="d-flex align-center justify-between mb-2 pa-2" style="background: rgba(0,0,0,0.05); border-radius: 4px;">
