@using MediatR
@using PDV.Application.Features.Sync.Queries
@inject IMediator Mediator
@inject PDV.WebUI.Services.ConnectionMonitor ConnectionMonitor

<MudNavMenu>
    <AuthorizeView Roles="Admin,Manager">
        <MudNavLink Href="dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
    </AuthorizeView>
    <AuthorizeView Roles="Admin,Manager,Cashier">
        <MudNavLink Href="pos" Icon="@Icons.Material.Filled.PointOfSale">Punto de Venta</MudNavLink>
    </AuthorizeView>
    <AuthorizeView Roles="Admin,Manager,Cashier,Telephonist">
        <MudNavGroup Title="Reparto y Pedidos" Icon="@Icons.Material.Filled.LocalShipping" Expanded="false">
            <MudNavLink Href="orders/capture" Icon="@Icons.Material.Filled.AddShoppingCart">Capturar Pedido</MudNavLink>
            <AuthorizeView Roles="Admin,Manager,Cashier" Context="routesContext">
                <MudNavLink Href="orders/routes" Icon="@Icons.Material.Filled.Map">Gestión de Rutas</MudNavLink>
                <MudNavLink Href="orders/settlement" Icon="@Icons.Material.Filled.AssignmentTurnedIn">Liquidación de Rutas</MudNavLink>
            </AuthorizeView>
        </MudNavGroup>
    </AuthorizeView>
    <AuthorizeView Roles="Admin,Manager">
        @if (!isLocalMode)
        {
            <MudNavLink Href="sales" Icon="@Icons.Material.Filled.ReceiptLong">Ventas</MudNavLink>
            <MudNavLink Href="sales/cash-cut-reconciliation" Icon="@Icons.Material.Filled.FactCheck">Conciliación de Cortes</MudNavLink>
        }
    </AuthorizeView>
    <AuthorizeView Roles="Admin,Manager,Telephonist,Almacen,Compras">
        <MudNavLink Href="products" Icon="@Icons.Material.Filled.Inventory">Productos</MudNavLink>
    </AuthorizeView>
    <AuthorizeView Roles="Admin,Manager,Almacen,Compras">
        @if (!isLocalMode)
        {
            <MudNavLink Href="inventory" Icon="@Icons.Material.Filled.Inventory2">Inventario</MudNavLink>
        }
    </AuthorizeView>
    <AuthorizeView Roles="Admin,Manager,Telephonist">
        <MudNavLink Href="clients" Icon="@Icons.Material.Filled.People">Clientes</MudNavLink>
    </AuthorizeView>
    <AuthorizeView Roles="Admin,Manager">
        <MudNavLink Href="invoices" Icon="@Icons.Material.Filled.Description">Facturas</MudNavLink>
    </AuthorizeView>
    <AuthorizeView Roles="Admin">
        <MudDivider />
        <MudNavGroup Title="Administración" Icon="@Icons.Material.Filled.Settings" Expanded="false">
            @if (!isLocalMode)
            {
                <MudNavLink Href="admin/branches" Icon="@Icons.Material.Filled.Store">Sucursales</MudNavLink>
                <MudNavLink Href="admin/users" Icon="@Icons.Material.Filled.ManageAccounts">Usuarios</MudNavLink>
                <MudNavLink Href="admin/cash-registers" Icon="@Icons.Material.Filled.PointOfSale">Cajas</MudNavLink>
                <MudNavLink Href="admin/printers" Icon="@Icons.Material.Filled.Print">Impresoras</MudNavLink>
                <MudNavLink Href="orders/zones" Icon="@Icons.Material.Filled.Explore">Zonas de Reparto</MudNavLink>
                <MudNavLink Href="admin/settings" Icon="@Icons.Material.Filled.SettingsApplications">Configuración</MudNavLink>
            }
            else
            {
                <MudNavLink Href="pos/station-config" Icon="@Icons.Material.Filled.PointOfSale">Mi Caja</MudNavLink>
            }
        </MudNavGroup>
    </AuthorizeView>
</MudNavMenu>

@code {
    private bool isLocalMode = false;

    protected override async Task OnInitializedAsync()
    {
        isLocalMode = ConnectionMonitor.IsLocalMode;
        if (!isLocalMode)
        {
            try
            {
                var syncStatus = await Mediator.Send(new GetSyncStatusQuery());
                isLocalMode = syncStatus.IsLocalMode;
            }
            catch
            {
                isLocalMode = false;
            }
        }
    }
}
