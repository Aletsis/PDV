@using MediatR
@using PDV.Application.Features.PriceLists.Commands.CreatePriceList
@using PDV.Application.Features.PriceLists.Commands.UpdatePriceList
@inject IMediator Mediator
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@(IsEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.LocalOffer)" Color="Color.Primary" Size="Size.Medium" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">@(IsEdit ? "Editar Lista de Precios" : "Registrar Nueva Lista de Precios")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="priceListForm" ValidationDelay="300">
            <div class="d-flex flex-column gap-4">
                <MudTextField @bind-Value="Model.Name" Label="Nombre de la Lista" 
                              Variant="Variant.Outlined" Required="true" RequiredError="El nombre es obligatorio"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.ListAlt" />
                
                <MudTextField @bind-Value="Model.Description" Label="Descripción / Observaciones" 
                              Variant="Variant.Outlined" Required="false"
                              Lines="3"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Notes" />
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Style="text-transform: none; font-weight: 500;">Cancelar</MudButton>
        <PdvInteractiveButton Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="Save" IsLoading="@_saving">
            Guardar
        </PdvInteractiveButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public bool IsEdit { get; set; }

    [Parameter]
    public PriceListFormModel Model { get; set; } = new();

    private MudForm priceListForm = null!;
    private bool _saving = false;

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        await priceListForm.Validate();
        if (!priceListForm.IsValid) return;

        _saving = true;
        try
        {
            if (IsEdit)
            {
                var result = await Mediator.Send(new UpdatePriceListCommand
                {
                    Id = Model.Id,
                    Name = Model.Name,
                    Description = Model.Description
                });

                if (result.IsSuccess)
                {
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                {
                    Snackbar.Add($"Error: {result.Error.Description}", Severity.Error);
                }
            }
            else
            {
                var result = await Mediator.Send(new CreatePriceListCommand
                {
                    Name = Model.Name,
                    Description = Model.Description
                });

                if (result.IsSuccess)
                {
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                {
                    Snackbar.Add($"Error: {result.Error.Description}", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error inesperado: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    public class PriceListFormModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
    }
}
