@page "/clients"
@using MediatR
@using PDV.Application.Features.Clients.Queries.ListClients
@using PDV.Application.Features.Clients.Commands.CreateClient
@using PDV.Application.Features.Clients.Commands.UpdateClient
@using PDV.Application.Features.Clients.Commands.DeleteClient
@using PDV.Application.Features.Clients.Dtos
@using PDV.Application.Features.Sync.Queries
@inject IMediator Mediator
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject PDV.WebUI.Services.ConnectionMonitor ConnectionMonitor
@implements IDisposable

<PageTitle>Gestión de Clientes</PageTitle>
<div class="d-flex flex-column gap-6">
    <!-- Page Header & Connection Card -->
    <PdvHeader Title="Clientes"
               Subtitle="Administra los clientes del sistema, sus datos fiscales y su sincronización."
               Icon="@Icons.Material.Filled.People"
               IconColor="Color.Primary">
        <StatusAlert>
            @if (isLocalMode)
            {
                <div class="local-mode-monitor d-flex align-center gap-3 px-4 py-2 border-dashed rounded-lg">
                    <div class="d-flex flex-column">
                        <span class="monitor-label">Base de Datos</span>
                        <span class="monitor-val font-weight-medium">Local (SQLite)</span>
                    </div>
                    <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />
                    <div class="d-flex flex-column align-end">
                        <span class="monitor-label">Bandeja de Sincronización</span>
                        <div class="d-flex align-center gap-1">
                            @if (pendingSyncCount > 0)
                            {
                                <MudBadge Content="@pendingSyncCount" Color="Color.Warning" Overlap="false" Class="mr-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Sync" Size="Size.Small" Class="animate-spin" Color="Color.Warning" />
                                </MudBadge>
                                <span class="monitor-val-accent text-warning font-weight-bold">@pendingSyncCount Pendientes</span>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CloudDone" Size="Size.Small" Color="Color.Success" />
                                <span class="monitor-val-accent text-success font-weight-bold">Sincronizado</span>
                            }
                        </div>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Color="Color.Primary" OnClick="RefreshSyncStatus" Class="ml-1" />
                </div>
            }
        </StatusAlert>
        <Actions>
            <PdvInteractiveButton Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
                Nuevo Cliente
            </PdvInteractiveButton>
        </Actions>
    </PdvHeader>

    <!-- Metrics Cards Grid -->
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <PdvKpiCard Title="Total Clientes"
                        Value="@totalClientsCount.ToString()"
                        Icon="@Icons.Material.Filled.Groups"
                        IconColor="Color.Primary"
                        IsLoading="@isLoading" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <PdvKpiCard Title="Activos"
                        Value="@activeClientsCount.ToString()"
                        Icon="@Icons.Material.Filled.CheckCircle"
                        IconColor="Color.Success"
                        IsLoading="@isLoading"
                        GradientType="PdvKpiCard.KpiGradientType.Success" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <PdvKpiCard Title="Inactivos"
                        Value="@inactiveClientsCount.ToString()"
                        Icon="@Icons.Material.Filled.PersonOff"
                        IconColor="Color.Error"
                        IsLoading="@isLoading"
                        GradientType="PdvKpiCard.KpiGradientType.Error" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <PdvKpiCard Title="Último Sync"
                        Value="@lastSyncText"
                        Icon="@Icons.Material.Filled.Schedule"
                        IconColor="Color.Warning"
                        IsLoading="@isLoading"
                        GradientType="PdvKpiCard.KpiGradientType.Warning" />
        </MudItem>
    </MudGrid>

    <!-- Main Data Section -->
    <MudPaper Class="p-4" Style="border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.05);">
        <!-- Table Toolbar -->
        <div class="d-flex align-center justify-space-between flex-wrap gap-4 mb-4">
            <div class="d-flex align-center gap-3 flex-grow-1" Style="max-width: 500px;">
                <MudTextField @bind-Value="searchString" Placeholder="Buscar por Código, Nombre, RFC o Email..." 
                               Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                               IconSize="Size.Medium" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                               Clearable="true" Class="flex-grow-1" />
                
                <MudSelect T="bool?" Value="filterActive" ValueChanged="OnFilterActiveChanged" Label="Estado" 
                           Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 150px;">
                    <MudSelectItem T="bool?" Value="@((bool?)null)">Todos</MudSelectItem>
                    <MudSelectItem T="bool?" Value="@(true)">Activos</MudSelectItem>
                    <MudSelectItem T="bool?" Value="@(false)">Inactivos</MudSelectItem>
                </MudSelect>
            </div>
        </div>

        <!-- Data Grid wrapped in State Container -->
        <PdvStateContainer IsLoading="@isLoading"
                            IsEmpty="@(!filteredClients.Any())"
                            EmptyTitle="Sin clientes"
                            EmptyMessage="No se encontraron clientes que coincidan con los criterios de búsqueda o filtros."
                            EmptyIcon="@Icons.Material.Filled.PeopleOutline"
                            SkeletonRows="6"
                            SkeletonColumns="7">
            <MudDataGrid T="ClientDto" Items="@filteredClients" Filterable="false" Hover="true" Striped="true" 
                         Dense="false" Elevation="0" Class="border border-solid rounded-lg">
                <Columns>
                    <PropertyColumn Property="x => x.Code" Title="Código" CellStyle="font-weight: 600; color: var(--mud-palette-text-primary);" />
                    <PropertyColumn Property="x => x.Name" Title="Nombre" />
                    <TemplateColumn Title="RFC / ID Fiscal">
                        <CellTemplate>
                            @if (!string.IsNullOrWhiteSpace(context.Item.TaxId))
                            {
                                <MudText Typo="Typo.body2">@context.Item.TaxId</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">—</MudText>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.Phone" Title="Teléfono" />
                    <TemplateColumn Title="Zona de Reparto">
                        <CellTemplate>
                            @if (context.Item.DeliveryZoneId.HasValue)
                            {
                                <MudChip T="string" Color="Color.Success" Variant="Variant.Text" Size="Size.Small" Icon="@Icons.Material.Filled.LocalShipping" Class="font-weight-medium">@context.Item.DeliveryZoneName</MudChip>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">—</MudText>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Estado">
                        <CellTemplate>
                            @if (context.Item.IsActive)
                            {
                                <MudChip T="string" Color="Color.Success" Variant="Variant.Text" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle" Class="font-weight-medium">Activo</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Default" Variant="Variant.Text" Size="Size.Small" Icon="@Icons.Material.Filled.Cancel" Class="font-weight-medium">Inactivo</MudChip>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Acciones" HeaderStyle="width: 160px;" CellClass="d-flex justify-end gap-1">
                        <CellTemplate>
                            <MudTooltip Text="Ver Facturas">
                                <MudIconButton Icon="@Icons.Material.Filled.Description" Color="Color.Info" Size="Size.Small" 
                                               OnClick="@(() => OpenClientInvoicesDialog(context.Item))" Style="background-color: rgba(0, 188, 212, 0.05);" />
                            </MudTooltip>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" 
                                           OnClick="@(() => OpenEditDialog(context.Item))" Style="background-color: rgba(33, 150, 243, 0.05);" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" 
                                           OnClick="@(() => DeleteClient(context.Item))" Style="background-color: rgba(244, 67, 54, 0.05);" />
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="ClientDto" />
                </PagerContent>
            </MudDataGrid>
        </PdvStateContainer>
    </MudPaper>
</div>

<!-- Add/Edit Dialog -->
<MudDialog @bind-Visible="isDialogVisible" Options="@(new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = false })">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@(isEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.PersonAdd)" Color="Color.Primary" Size="Size.Medium" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">@(isEdit ? "Editar Cliente" : "Registrar Nuevo Cliente")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="clientForm" ValidationDelay="300">
            <MudGrid>
                <!-- General Section -->
                <MudItem xs="12" md="5">
                    <div class="d-flex flex-column gap-4">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Color="Color.Primary">DATOS GENERALES Y CONTACTO</MudText>
                        
                        <MudTextField @bind-Value="currentClient.Code" Label="Código" 
                                      Variant="Variant.Outlined" Required="true" RequiredError="El código del cliente es obligatorio"
                                      Disabled="isEdit"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.QrCode" />

                        <MudTextField @bind-Value="currentClient.Name" Label="Nombre / Razón Social" 
                                      Variant="Variant.Outlined" Required="true" RequiredError="El nombre es obligatorio"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person" />
                        
                        <MudTextField @bind-Value="currentClient.TaxId" Label="RFC / ID Fiscal" 
                                      Variant="Variant.Outlined"
                                      Validation="@(new Func<string, string?>(ValidateOptionalTaxId))"
                                      HelperText="Opcional. Ingrese a 12 o 13 dígitos sin guiones (ej. GOMP820325XX1)"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Assignment" />

                        <MudTextField @bind-Value="currentClient.Phone" Label="Número Telefónico" 
                                      Variant="Variant.Outlined" HelperText="Ej: 10 dígitos sin espacios"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Phone" />

                        <MudTextField @bind-Value="currentClient.Email" Label="Correo Electrónico" 
                                      Variant="Variant.Outlined" HelperText="Ej: ejemplo@dominio.com"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email" />

                        <MudSelect T="string" @bind-Value="currentClient.FiscalRegime" Label="Régimen Fiscal" 
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" 
                                   HelperText="Opcional. Catálogo SAT (CFDI 4.0)"
                                   Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AccountBalance">
                            <MudSelectItem Value="@("601")">601 - General de Ley Personas Morales</MudSelectItem>
                            <MudSelectItem Value="@("603")">603 - Personas Morales con Fines no Lucrativos</MudSelectItem>
                            <MudSelectItem Value="@("605")">605 - Sueldos y Salarios e Ingresos Asimilados</MudSelectItem>
                            <MudSelectItem Value="@("606")">606 - Arrendamiento</MudSelectItem>
                            <MudSelectItem Value="@("612")">612 - Personas Físicas con Actividades Empresariales y Profesionales</MudSelectItem>
                            <MudSelectItem Value="@("616")">616 - Sin obligaciones fiscales</MudSelectItem>
                            <MudSelectItem Value="@("621")">621 - Incorporación Fiscal</MudSelectItem>
                            <MudSelectItem Value="@("625")">625 - Régimen de las Actividades Empresariales con ingresos a través de Plataformas Tecnológicas</MudSelectItem>
                            <MudSelectItem Value="@("626")">626 - Régimen Simplificado de Confianza (RESICO)</MudSelectItem>
                        </MudSelect>

                        <MudSelect T="string" @bind-Value="currentClient.CfdiUse" Label="Uso del CFDI" 
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" 
                                   HelperText="Opcional. Uso preferente para comprobantes fiscales"
                                   Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Description">
                            <MudSelectItem Value="@("G01")">G01 - Adquisición de mercancías</MudSelectItem>
                            <MudSelectItem Value="@("G02")">G02 - Devoluciones, descuentos o bonificaciones</MudSelectItem>
                            <MudSelectItem Value="@("G03")">G03 - Gastos en general</MudSelectItem>
                            <MudSelectItem Value="@("I01")">I01 - Construcciones</MudSelectItem>
                            <MudSelectItem Value="@("I02")">I02 - Mobilario y equipo de oficina</MudSelectItem>
                            <MudSelectItem Value="@("I04")">I04 - Equipo de cómputo y accesorios</MudSelectItem>
                            <MudSelectItem Value="@("I08")">I08 - Otra maquinaria y equipo</MudSelectItem>
                            <MudSelectItem Value="@("D01")">D01 - Honorarios médicos, dentales y gastos hospitalarios</MudSelectItem>
                            <MudSelectItem Value="@("D02")">D02 - Gastos médicos por incapacidad o discapacidad</MudSelectItem>
                            <MudSelectItem Value="@("D04")">D04 - Donativos</MudSelectItem>
                            <MudSelectItem Value="@("S01")">S01 - Sin efectos fiscales</MudSelectItem>
                            <MudSelectItem Value="@("CP01")">CP01 - Pagos</MudSelectItem>
                        </MudSelect>
                        
                        @if (isEdit)
                        {
                            <div class="d-flex align-center gap-2 mt-1">
                                <MudSwitch @bind-Value="currentClient.IsActive" Color="Color.Success" Label="¿Cliente Activo?" />
                            </div>
                        }
                    </div>
                </MudItem>

                <!-- Structured Address Section -->
                <MudItem xs="12" md="7">
                    <div class="d-flex flex-column gap-3">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Color="Color.Primary">DOMICILIO FISCAL / ENTREGA</MudText>
                        
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="8">
                                <MudTextField @bind-Value="currentClient.Street" Label="Calle" 
                                              Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Placeholder="Nombre de la calle o avenida"
                                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.LocationOn" />
                            </MudItem>
                            <MudItem xs="6" sm="2">
                                <MudTextField @bind-Value="currentClient.ExteriorNumber" Label="Núm. Ext." 
                                              Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Placeholder="123" />
                            </MudItem>
                            <MudItem xs="6" sm="2">
                                <MudTextField @bind-Value="currentClient.InteriorNumber" Label="Núm. Int." 
                                              Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Placeholder="A-1" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="currentClient.Colony" Label="Colonia / Asentamiento" 
                                              Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Placeholder="Ej: Centro, Las Palmas" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="currentClient.ZipCode" Label="Código Postal (C.P.)" 
                                              Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Placeholder="5 dígitos" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="currentClient.City" Label="Ciudad / Municipio" 
                                              Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Placeholder="Ej: Guadalajara" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="currentClient.State" Label="Estado" 
                                              Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Placeholder="Ej: Jalisco" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField @bind-Value="currentClient.Country" Label="País" 
                                              Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Placeholder="México" />
                            </MudItem>
                        </MudGrid>

                        <div class="mt-2 p-3 border rounded-lg bg-surface">
                            <div class="d-flex align-center gap-1 mb-1">
                                <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Small" Color="Color.Info" />
                                <MudText Typo="Typo.caption" Class="font-weight-bold">Dirección Completa Generada (Geocodificador):</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-style: italic;">
                                @(string.IsNullOrWhiteSpace(GetFullAddressString(currentClient)) ? "Sin dirección capturada" : GetFullAddressString(currentClient))
                            </MudText>
                        </div>
                        
                        @if (currentClient.DeliveryZoneId.HasValue)
                        {
                            <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Small" Class="font-weight-medium">
                                Zona: @currentClient.DeliveryZoneName
                            </MudChip>
                        }
                        else if (!string.IsNullOrWhiteSpace(GetFullAddressString(currentClient)))
                        {
                            <MudChip T="string" Color="Color.Warning" Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="font-weight-medium">
                                Se resolverá zona automáticamente al guardar
                            </MudChip>
                        }

                        @if (currentClient.Latitude.HasValue && currentClient.Longitude.HasValue)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Coordenadas: @currentClient.Latitude.Value.ToString("F6"), @currentClient.Longitude.Value.ToString("F6")
                            </MudText>
                        }
                    </div>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="CloseDialog" Style="text-transform: none; font-weight: bold; border-radius: 8px;">Cancelar</MudButton>
        <PdvInteractiveButton Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveClient" IsLoading="@_saving">
            Guardar Cliente
        </PdvInteractiveButton>
    </DialogActions>
</MudDialog>

@code {
    private List<ClientDto> clients = new();
    private bool isDialogVisible = false;
    private bool isEdit = false;
    private bool isLoading = false;
    private bool _saving = false;
    
    private ClientDto currentClient = new();
    private MudForm clientForm = new();

    // Stats variables
    private int totalClientsCount = 0;
    private int activeClientsCount = 0;
    private int inactiveClientsCount = 0;
    private string lastSyncText = "Nunca";

    // Sync status variables
    private bool isLocalMode = false;
    private int pendingSyncCount = 0;

    // Search and filter parameters
    private string searchString = "";
    private bool? filterActive = true; // Default to showing only Active clients

    private IEnumerable<ClientDto> filteredClients => clients
        .Where(c => 
            // Text Search filter
            (string.IsNullOrWhiteSpace(searchString) || 
             (c.Code != null && c.Code.Contains(searchString, StringComparison.OrdinalIgnoreCase)) ||
             c.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase) || 
             c.TaxId.Contains(searchString, StringComparison.OrdinalIgnoreCase) || 
             (c.Email != null && c.Email.Contains(searchString, StringComparison.OrdinalIgnoreCase))) 
            &&
            // Active state filter
            (filterActive == null || c.IsActive == filterActive)
        );

    protected override async Task OnInitializedAsync()
    {
        ConnectionMonitor.OnConnectionStatusChanged += OnConnectionStatusChanged;
        await LoadData();
    }

    private void OnConnectionStatusChanged(bool isConnected)
    {
        InvokeAsync(async () => {
            await LoadSyncStatus();
            StateHasChanged();
        });
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            // Load both active and inactive clients to display correct metrics
            clients = await Mediator.Send(new ListClientsQuery(IncludeInactive: true));
            CalculateMetrics();
            await LoadSyncStatus();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar datos: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CalculateMetrics()
    {
        totalClientsCount = clients.Count;
        activeClientsCount = clients.Count(c => c.IsActive);
        inactiveClientsCount = clients.Count(c => !c.IsActive);
    }

    private async Task LoadSyncStatus()
    {
        try
        {
            var syncStatus = await Mediator.Send(new GetSyncStatusQuery());
            isLocalMode = syncStatus.IsLocalMode;
            pendingSyncCount = syncStatus.PendingMessagesCount;

            // Load last pull time from file if local mode
            if (isLocalMode)
            {
                var pullSyncFile = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "last-pull-sync.txt");
                if (File.Exists(pullSyncFile))
                {
                    var fileContent = await File.ReadAllTextAsync(pullSyncFile);
                    if (DateTime.TryParse(fileContent, out var dt))
                    {
                        // Convert to local time for user readability
                        lastSyncText = dt.ToLocalTime().ToString("g");
                        return;
                    }
                }
                lastSyncText = "Pendiente";
            }
            else
            {
                lastSyncText = "En tiempo real";
            }
        }
        catch (Exception)
        {
            // Fail silently or fallback
            isLocalMode = false;
            pendingSyncCount = 0;
            lastSyncText = "No disponible";
        }
    }

    private async Task RefreshSyncStatus()
    {
        await ConnectionMonitor.CheckConnectionAsync();
        await LoadSyncStatus();
        Snackbar.Add("Estado de sincronización actualizado", Severity.Info);
    }

    private void OnFilterActiveChanged(bool? val)
    {
        filterActive = val;
    }

    private string GetFullAddressString(ClientDto client)
    {
        var parts = new List<string>();
        var streetPart = client.Street?.Trim() ?? string.Empty;
        if (!string.IsNullOrWhiteSpace(client.ExteriorNumber))
            streetPart += $" #{client.ExteriorNumber.Trim()}";
        if (!string.IsNullOrWhiteSpace(client.InteriorNumber))
            streetPart += $" Int. {client.InteriorNumber.Trim()}";

        if (!string.IsNullOrWhiteSpace(streetPart))
            parts.Add(streetPart);
        if (!string.IsNullOrWhiteSpace(client.Colony))
            parts.Add($"Col. {client.Colony.Trim()}");
        if (!string.IsNullOrWhiteSpace(client.ZipCode) && client.ZipCode != "00000")
            parts.Add($"C.P. {client.ZipCode.Trim()}");
        if (!string.IsNullOrWhiteSpace(client.City) && client.City != "N/A")
            parts.Add(client.City.Trim());
        if (!string.IsNullOrWhiteSpace(client.State) && client.State != "N/A")
            parts.Add(client.State.Trim());
        if (!string.IsNullOrWhiteSpace(client.Country))
            parts.Add(client.Country.Trim());

        return string.Join(", ", parts);
    }

    private string? ValidateOptionalTaxId(string? val)
    {
        if (string.IsNullOrWhiteSpace(val)) return null;
        var trimmed = val.Trim();
        if (trimmed.Length < 10 || trimmed.Length > 13)
            return "El RFC debe tener entre 10 y 13 caracteres.";
        return null;
    }

    private void OpenCreateDialog()
    {
        currentClient = new ClientDto 
        { 
            IsActive = true,
            Country = "México",
            FiscalRegime = null,
            CfdiUse = null
        };
        isEdit = false;
        isDialogVisible = true;
    }

    private void OpenEditDialog(ClientDto client)
    {
        currentClient = new ClientDto
        {
            Id = client.Id,
            Code = client.Code,
            Name = client.Name,
            TaxId = client.TaxId,
            Address = client.Address,
            Street = client.Street,
            ExteriorNumber = client.ExteriorNumber,
            InteriorNumber = client.InteriorNumber,
            Colony = client.Colony,
            ZipCode = client.ZipCode,
            City = client.City,
            State = client.State,
            Country = string.IsNullOrWhiteSpace(client.Country) ? "México" : client.Country,
            Phone = client.Phone,
            Email = client.Email,
            FiscalRegime = client.FiscalRegime,
            CfdiUse = client.CfdiUse,
            IsActive = client.IsActive,
            DeliveryZoneId = client.DeliveryZoneId,
            DeliveryZoneName = client.DeliveryZoneName,
            Latitude = client.Latitude,
            Longitude = client.Longitude
        };
        isEdit = true;
        isDialogVisible = true;
    }

    private async Task OpenClientInvoicesDialog(ClientDto client)
    {
        var parameters = new DialogParameters { ["Client"] = client };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<ClientInvoicesDialog>($"Facturas de {client.Name}", parameters, options);
    }

    private void CloseDialog()
    {
        isDialogVisible = false;
    }

    private async Task SaveClient()
    {
        await clientForm.Validate();
        if (!clientForm.IsValid)
        {
            Snackbar.Add("Por favor complete los campos requeridos correctamente.", Severity.Warning);
            return;
        }

        try
        {
            _saving = true;
            var fullAddress = GetFullAddressString(currentClient);

            if (isEdit)
            {
                var command = new UpdateClientCommand
                {
                    Id = currentClient.Id,
                    Code = currentClient.Code,
                    Name = currentClient.Name,
                    TaxId = currentClient.TaxId,
                    Address = fullAddress,
                    Street = currentClient.Street,
                    ExteriorNumber = currentClient.ExteriorNumber,
                    InteriorNumber = currentClient.InteriorNumber,
                    Colony = currentClient.Colony,
                    ZipCode = currentClient.ZipCode,
                    City = currentClient.City,
                    State = currentClient.State,
                    Country = currentClient.Country,
                    Phone = currentClient.Phone,
                    Email = currentClient.Email,
                    FiscalRegime = currentClient.FiscalRegime,
                    CfdiUse = currentClient.CfdiUse,
                    IsActive = currentClient.IsActive
                };
                await Mediator.Send(command);
                Snackbar.Add("Cliente actualizado exitosamente", Severity.Success);
            }
            else
            {
                var command = new CreateClientCommand
                {
                    Code = currentClient.Code,
                    Name = currentClient.Name,
                    TaxId = currentClient.TaxId,
                    Address = fullAddress,
                    Street = currentClient.Street,
                    ExteriorNumber = currentClient.ExteriorNumber,
                    InteriorNumber = currentClient.InteriorNumber,
                    Colony = currentClient.Colony,
                    ZipCode = currentClient.ZipCode,
                    City = currentClient.City,
                    State = currentClient.State,
                    Country = currentClient.Country,
                    Phone = currentClient.Phone,
                    Email = currentClient.Email,
                    FiscalRegime = currentClient.FiscalRegime,
                    CfdiUse = currentClient.CfdiUse
                };
                await Mediator.Send(command);
                Snackbar.Add("Cliente creado exitosamente", Severity.Success);
            }
            CloseDialog();
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar cliente: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteClient(ClientDto client)
    {
        bool? result = await DialogService.ShowMessageBox(
            "Eliminar Cliente",
            $"¿Estás seguro que deseas eliminar a '{client.Name}'?",
            yesText: "Eliminar", cancelText: "Cancelar");

        if (result == true)
        {
            try
            {
                await Mediator.Send(new DeleteClientCommand(client.Id));
                Snackbar.Add("Cliente eliminado exitosamente", Severity.Success);
                await LoadData();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error al eliminar cliente: {ex.Message}", Severity.Error);
            }
        }
    }

    public void Dispose()
    {
        ConnectionMonitor.OnConnectionStatusChanged -= OnConnectionStatusChanged;
    }
}
