@page "/orders/routes"
@using MediatR
@using PDV.Application.Features.DeliveryRoutes.Commands.CreateDeliveryRoute
@using PDV.Application.Features.DeliveryRoutes.Commands.DispatchDeliveryRoute
@using PDV.Application.Features.DeliveryRoutes.Commands.PrintRouteManifest
@using PDV.Application.Features.DeliveryRoutes.Queries.GetDeliveryRoutes
@using PDV.Application.Features.Orders.Queries.GetOrders
@using PDV.Application.Features.Drivers.Dtos
@using PDV.Application.Features.Drivers.Queries.GetDriversStatus
@using PDV.Application.Common.Helpers
@using PDV.Application.Common.Interfaces
@using PDV.Domain.Entities
@using PDV.Domain.Enums
@inject IMediator Mediator
@inject ISnackbar Snackbar
@inject IIdentityService IdentityService
@inject PDV.WebUI.Services.ShiftSessionService ShiftSession
@attribute [Authorize]

<PageTitle>Gestión de Rutas</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" GutterBottom="true" Class="font-weight-bold">Gestión de Rutas de Reparto</MudText>
    <MudText Typo="Typo.body1" Class="mb-4">Agrupe los pedidos confirmados por zona y asígnelos a rutas de reparto.</MudText>

    @if (!ShiftSession.HasActiveShift)
    {
        <div class="d-flex flex-column align-center justify-center" style="min-height: 60vh;">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Style="font-size: 4rem; color: var(--mud-palette-warning);" />
            <MudText Typo="Typo.h5" Class="mt-4 font-weight-bold">Sin turno activo</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">Debes abrir un turno de caja antes de gestionar rutas.</MudText>
        </div>
    }
    else
    {
        <MudGrid>
            <!-- Lista de Pedidos Pendientes de Ruteo -->
            <MudItem xs="12" md="8">
                <MudCard Elevation="3" Style="height: 100%; min-height: 550px;" Class="d-flex flex-column justify-space-between">
                    <MudCardContent>
                        <div class="d-flex align-center justify-space-between mb-4">
                            <MudText Typo="Typo.h6">Pedidos Pendientes de Ruteo</MudText>
                            <MudChip T="string" Color="Color.Info" Size="Size.Small" Icon="@Icons.Material.Filled.Autorenew" OnClick="RefreshDataAsync">
                                Actualizar
                            </MudChip>
                        </div>

                        @if (_pendingOrders == null || _pendingOrders.Count == 0)
                        {
                            <div class="d-flex flex-column align-center justify-center py-8">
                                <MudIcon Icon="@Icons.Material.Filled.DoneAll" Style="font-size: 3rem; color: var(--mud-palette-success);" />
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">No hay pedidos pendientes de entrega.</MudText>
                            </div>
                        }
                        else
                        {
                            <MudTextField @bind-Value="_searchString"
                                          Placeholder="Buscar por folio o nombre de cliente..."
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          IconSize="Size.Medium"
                                          Class="mb-4"
                                          Clearable="true"
                                          Immediate="true"
                                          Variant="Variant.Outlined" />

                            <MudTable T="Order" Items="@_pendingOrders" MultiSelection="true" @bind-SelectedItems="_selectedOrders" Hover="true" Dense="true" Elevation="0" Filter="new Func<Order,bool>(FilterFunc1)">
                                <HeaderContent>
                                    <MudTh>Folio</MudTh>
                                    <MudTh>Fecha/Hora</MudTh>
                                    <MudTh>Cliente</MudTh>
                                    <MudTh>Zona</MudTh>
                                    <MudTh>Total</MudTh>
                                    <MudTh>Estado / Alerta</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@context.Series-@context.Folio</MudTd>
                                    <MudTd>@context.OrderDate.ToString("dd/MM HH:mm")</MudTd>
                                    <MudTd>@(context.Client?.Name ?? "Público General")</MudTd>
                                    <MudTd>
                                        @if (context.DeliveryZone != null)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">@context.DeliveryZone.Name</MudChip>
                                        }
                                        else
                                        {
                                            <span class="mud-text-secondary">—</span>
                                        }
                                    </MudTd>
                                    <MudTd>@context.TotalAmount.ToString("C2")</MudTd>
                                    <MudTd>
                                        @if (IsOrderDelayed(context))
                                        {
                                            <MudChip T="string" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.NewReleases" Class="font-weight-medium">
                                                RETRASADO (>45 min)
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Schedule" Class="font-weight-medium">
                                                En Espera
                                            </MudChip>
                                        }
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudCardContent>

                    <MudCardActions Class="border-t pa-4 d-flex align-center justify-space-between bg-light rounded-b-lg">
                        <MudText Typo="Typo.subtitle2">
                            Seleccionados: @_selectedOrders.Count pedido(s)
                        </MudText>
                    </MudCardActions>
                </MudCard>
            </MudItem>

            <!-- Panel de Creación de Ruta -->
            <MudItem xs="12" md="4">
                <MudCard Elevation="3" Class="mb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Asignar y Despachar Ruta</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudAutocomplete T="UserSyncDataDto" 
                                         Label="Seleccionar Repartidor"
                                         SearchFunc="SearchDeliveryMen"
                                         Value="_selectedDeliveryMan"
                                         ValueChanged="OnDeliveryManChanged"
                                         ToStringFunc="@FormatDeliveryManDisplay"
                                         Variant="Variant.Outlined"
                                         Required="true"
                                         Class="mb-2"
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.Person"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="true"
                                         CoerceValue="true">
                            <ItemTemplate Context="u">
                                @{
                                    var st = GetDriverStatus(u.Id);
                                }
                                <div class="d-flex align-center justify-space-between w-100 py-1">
                                    <div class="d-flex flex-column">
                                        <MudText Typo="Typo.body2" Class="font-weight-bold">@u.FullName</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">No. @(u.EmployeeNumber ?? "N/A")</MudText>
                                    </div>
                                    @if (st != null)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(st.Status)" Variant="Variant.Filled" Class="ml-2">
                                            @GetStatusLabel(st.Status)
                                            @if (st.ActiveRoutesCount > 0)
                                            {
                                                <span> (@st.ActiveRoutesCount ruta)</span>
                                            }
                                        </MudChip>
                                    }
                                </div>
                            </ItemTemplate>
                        </MudAutocomplete>

                        @if (_selectedDriverStatus != null)
                        {
                            <div class="d-flex align-center justify-space-between mb-3 px-2 py-1 border-solid border rounded mud-border-lines-default" style="background: rgba(255,255,255,0.03);">
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@GetStatusIcon(_selectedDriverStatus.Status)" Color="@GetStatusColor(_selectedDriverStatus.Status)" Size="Size.Small" />
                                    <span style="font-size: 0.85rem;">@GetStatusLabel(_selectedDriverStatus.Status)</span>
                                </div>
                                <span class="mud-text-secondary" style="font-size: 0.8rem;">
                                    @_selectedDriverStatus.ActiveRoutesCount ruta(s) activa(s) | @_selectedDriverStatus.DeliveriesCompletedToday entregas hoy
                                </span>
                            </div>

                            @if (_selectedDriverStatus.Status != PickerAvailabilityStatus.Available)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                                    El repartidor está en <strong>@GetStatusLabel(_selectedDriverStatus.Status)</strong>. Se recomienda asignar a repartidores disponibles.
                                </MudAlert>
                            }
                        }

                        <MudButton OnClick="CreateAndDispatchRoute" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.LocalShipping" FullWidth="true" Disabled="@(!CanCreateRoute)" Class="py-3">
                            Despachar Ruta
                        </MudButton>
                    </MudCardContent>
                </MudCard>

                <MudCard Elevation="3">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Rutas Activas (En Tránsito)</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Style="max-height: 250px; overflow-y: auto;">
                        @if (_activeRoutes == null || _activeRoutes.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No hay rutas activas en este momento.</MudText>
                        }
                        else
                        {
                            <MudList T="DeliveryRoute">
                                @foreach (var route in _activeRoutes)
                                {
                                    <MudListItem Icon="@Icons.Material.Filled.DepartureBoard" IconColor="Color.Info">
                                        <div class="d-flex align-center justify-space-between w-100">
                                            <div>
                                                <MudText Typo="Typo.body1">Ruta #@route.Folio</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Repartidor: @GetDeliveryManName(route.DeliveryManId)</MudText>
                                            </div>
                                            <MudIconButton Icon="@Icons.Material.Filled.Print" Color="Color.Primary" Size="Size.Small" OnClick="() => PrintRoute(route.Id)" />
                                        </div>
                                    </MudListItem>
                                }
                            </MudList>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private List<Order> _pendingOrders = new();
    private HashSet<Order> _selectedOrders = new();
    private List<UserSyncDataDto> _deliveryMen = new();
    private List<DriverStatusDto> _driversStatus = new();
    private List<UserSyncDataDto> _allUsers = new();
    private List<DeliveryRoute> _activeRoutes = new();
    private string _searchString = string.Empty;

    private UserSyncDataDto? _selectedDeliveryMan;
    private DriverStatusDto? _selectedDriverStatus;
    private string _selectedDeliveryManId = string.Empty;

    private bool CanCreateRoute => !string.IsNullOrWhiteSpace(_selectedDeliveryManId) && _selectedOrders.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        if (ShiftSession.HasActiveShift)
        {
            await RefreshDataAsync();
        }
    }

    private async Task RefreshDataAsync()
    {
        var branchId = ShiftSession.BranchId ?? Guid.Empty;

        // 1. Cargar pedidos en estado "Confirmed" (Listos para reparto) del branch del usuario
        _pendingOrders = await Mediator.Send(new GetOrdersQuery 
        { 
            Status = OrderStatus.Confirmed,
            BranchId = branchId
        });

        // 2. Cargar repartidores / usuarios del sistema y filtrar por branch del usuario
        _allUsers = await IdentityService.GetUsersAsync(default);
        _deliveryMen = _allUsers
            .Where(u => (!u.BranchId.HasValue || u.BranchId == branchId) &&
                        RoleHelper.HasDeliveryManRole(u.Roles))
            .ToList();

        // Cargar estado de disponibilidad de repartidores
        try
        {
            _driversStatus = await Mediator.Send(new GetDriversStatusQuery(branchId));
        }
        catch
        {
            _driversStatus = new List<DriverStatusDto>();
        }

        // 3. Cargar rutas activas en estado "EnRoute" del branch del usuario
        _activeRoutes = await Mediator.Send(new GetDeliveryRoutesQuery 
        { 
            Status = DeliveryRouteStatus.EnRoute,
            BranchId = branchId
        });

        _selectedOrders.Clear();
        _selectedDeliveryMan = null;
        _selectedDriverStatus = null;
        _selectedDeliveryManId = string.Empty;
        _searchString = string.Empty;
        StateHasChanged();
    }

    private bool FilterFunc1(Order order) => FilterFunc(order, _searchString);

    private bool FilterFunc(Order order, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;

        var search = searchString.Trim().ToLower();

        var folioComplete = $"{order.Series}-{order.Folio}".ToLower();
        var folioNum = order.Folio.ToString();
        if (folioComplete.Contains(search) || folioNum.Contains(search))
            return true;

        var clientName = (order.Client?.Name ?? "Público General").ToLower();
        if (clientName.Contains(search))
            return true;

        return false;
    }

    private bool IsOrderDelayed(Order order)
    {
        // Si tiene más de 45 minutos en espera, marcar como retrasado
        return order.OrderDate.AddMinutes(45) < DateTime.UtcNow;
    }

    private string GetDeliveryManName(string userId)
    {
        var user = _allUsers.FirstOrDefault(u => u.Id == userId);
        return user?.FullName ?? userId;
    }

    private DriverStatusDto? GetDriverStatus(string userId)
    {
        return _driversStatus.FirstOrDefault(d => d.UserId == userId);
    }

    private string FormatDeliveryManDisplay(UserSyncDataDto? u)
    {
        if (u == null) return "";
        var st = GetDriverStatus(u.Id);
        var statusLabel = st != null ? $" [{GetStatusLabel(st.Status)}]" : "";
        return $"{u.FullName} (No. {u.EmployeeNumber ?? "N/A"}){statusLabel}";
    }

    private Task<IEnumerable<UserSyncDataDto>> SearchDeliveryMen(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
            return Task.FromResult<IEnumerable<UserSyncDataDto>>(_deliveryMen);

        var search = value.Trim().ToLower();
        return Task.FromResult<IEnumerable<UserSyncDataDto>>(
            _deliveryMen.Where(u => 
                u.FullName.ToLower().Contains(search) || 
                (u.EmployeeNumber != null && u.EmployeeNumber.ToLower().Contains(search)))
        );
    }

    private void OnDeliveryManChanged(UserSyncDataDto deliveryMan)
    {
        _selectedDeliveryMan = deliveryMan;
        _selectedDeliveryManId = deliveryMan?.Id ?? string.Empty;
        _selectedDriverStatus = !string.IsNullOrWhiteSpace(_selectedDeliveryManId) 
            ? GetDriverStatus(_selectedDeliveryManId) 
            : null;
    }

    private Color GetStatusColor(PickerAvailabilityStatus status) => status switch
    {
        PickerAvailabilityStatus.Available => Color.Success,
        PickerAvailabilityStatus.MealBreak => Color.Warning,
        PickerAvailabilityStatus.OperationalBreak => Color.Info,
        PickerAvailabilityStatus.OffDuty => Color.Error,
        _ => Color.Default
    };

    private string GetStatusIcon(PickerAvailabilityStatus status) => status switch
    {
        PickerAvailabilityStatus.Available => Icons.Material.Filled.CheckCircle,
        PickerAvailabilityStatus.MealBreak => Icons.Material.Filled.Restaurant,
        PickerAvailabilityStatus.OperationalBreak => Icons.Material.Filled.PauseCircle,
        PickerAvailabilityStatus.OffDuty => Icons.Material.Filled.Cancel,
        _ => Icons.Material.Filled.Help
    };

    private string GetStatusLabel(PickerAvailabilityStatus status) => status switch
    {
        PickerAvailabilityStatus.Available => "Disponible",
        PickerAvailabilityStatus.MealBreak => "En Comida",
        PickerAvailabilityStatus.OperationalBreak => "En Pausa",
        PickerAvailabilityStatus.OffDuty => "Fuera de Turno",
        _ => "Desconocido"
    };

    private async Task CreateAndDispatchRoute()
    {
        if (!CanCreateRoute) return;

        try
        {
            // 1. Crear la Ruta
            var createCommand = new CreateDeliveryRouteCommand
            {
                BranchId = ShiftSession.BranchId ?? Guid.Empty,
                DeliveryManId = _selectedDeliveryManId,
                OrderIds = _selectedOrders.Select(o => o.Id).ToList()
            };

            var routeId = await Mediator.Send(createCommand);

            // 2. Despachar la Ruta automáticamente
            await Mediator.Send(new DispatchDeliveryRouteCommand { RouteId = routeId });
            Snackbar.Add($"Ruta #{_selectedOrders.Count} despachada con éxito.", Severity.Success);

            // 3. Imprimir el comprobante de arqueo / manifiesto
            await Mediator.Send(new PrintRouteManifestCommand(routeId, ShiftSession.ActiveCashRegisterId ?? Guid.Empty));

            await RefreshDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al despachar la ruta: {ex.Message}", Severity.Error);
        }
    }

    private async Task PrintRoute(Guid routeId)
    {
        try
        {
            await Mediator.Send(new PrintRouteManifestCommand(routeId, ShiftSession.ActiveCashRegisterId ?? Guid.Empty));
            Snackbar.Add("Manifiesto enviado a la impresora.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al imprimir manifiesto: {ex.Message}", Severity.Error);
        }
    }
}
