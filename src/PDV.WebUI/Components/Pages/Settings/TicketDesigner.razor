            var temp = block.ManifestOrderFields[index];
            block.ManifestOrderFields[index] = block.ManifestOrderFields[index - 1];
            block.ManifestOrderFields[index - 1] = temp;
            StateHasChanged();
        }
    }

    private void MoveManifestOrderFieldDown(TicketBlock block, int index)
    {
        if (block.ManifestOrderFields != null && index >= 0 && index < block.ManifestOrderFields.Count - 1)
        {
            var temp = block.ManifestOrderFields[index];
            block.ManifestOrderFields[index] = block.ManifestOrderFields[index + 1];
            block.ManifestOrderFields[index + 1] = temp;
            StateHasChanged();
        }
    }

    private void ToggleManifestTotalsField(TicketBlock block, string field, bool show)
    {
        block.ManifestTotalsFields ??= new List<string> { "CashTotal", "OrderCount", "CardTotal", "CombinedTotal" };
        if (!show)
        {
            block.ManifestTotalsFields.Remove(field);
        }
        else if (!block.ManifestTotalsFields.Contains(field))
        {
            block.ManifestTotalsFields.Add(field);
        }
        StateHasChanged();
    }

    private void AddManifestTotalsField(TicketBlock block, string field)
    {
        if (string.IsNullOrEmpty(field)) return;
        block.ManifestTotalsFields ??= new List<string>();
        if (!block.ManifestTotalsFields.Contains(field))
        {
            block.ManifestTotalsFields.Add(field);
        }
        StateHasChanged();
