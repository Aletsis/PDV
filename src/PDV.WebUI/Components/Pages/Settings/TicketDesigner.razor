            block.ManifestTotalsFields[index] = block.ManifestTotalsFields[index - 1];
            block.ManifestTotalsFields[index - 1] = temp;
            StateHasChanged();
        }
    }

    private void MoveManifestTotalsFieldDown(TicketBlock block, int index)
    {
        if (block.ManifestTotalsFields != null && index >= 0 && index < block.ManifestTotalsFields.Count - 1)
        {
            var temp = block.ManifestTotalsFields[index];
            block.ManifestTotalsFields[index] = block.ManifestTotalsFields[index + 1];
            block.ManifestTotalsFields[index + 1] = temp;
            StateHasChanged();
        }
    }

    private void InsertVariable(string variable)
    {
        if (_selectedBlockIndex >= 0 && _selectedBlockIndex < _templateJson.Blocks.Count)
        {
            var block = _templateJson.Blocks[_selectedBlockIndex];
            if (block.Type.Equals("Text", StringComparison.OrdinalIgnoreCase) || block.Type.Equals("Footer", StringComparison.OrdinalIgnoreCase))
            {
                block.Content = (block.Content ?? "") + variable;
            }
            else if (block.Type.Equals("KeyValue", StringComparison.OrdinalIgnoreCase))
            {
                block.ValuePlaceholder = (block.ValuePlaceholder ?? "") + variable;
            }
            else if (block.Type.Equals("BarcodeOrQr", StringComparison.OrdinalIgnoreCase))
            {
                block.CodifiedValue = variable;
            }
        }
    }

    private async Task SaveTemplate()
    {
        // Validar porcentajes de tablas
        foreach (var block in _templateJson.Blocks.Where(b => b.Type.Equals("ItemsTable", StringComparison.OrdinalIgnoreCase)))
        {
            if (GetColumnsTotalPercentage(block) != 100)
            {
                Snackbar.Add("La tabla de artículos debe sumar exactamente 100% en el ancho de sus columnas.", Severity.Error);
                return;
            }
        }
        foreach (var block in _templateJson.Blocks.Where(b => b.Type.Equals("DenominationsTable", StringComparison.OrdinalIgnoreCase)))
        {
            if (GetColumnsTotalPercentage(block) != 100)
            {
                Snackbar.Add("La tabla de desglose de morralla debe sumar exactamente 100% en el ancho de sus columnas.", Severity.Error);
                return;
            }
        }

        _isSaving = true;
        try
        {
            string contentJson = JsonSerializer.Serialize(_templateJson);

            if (_templateEntity != null)
            {
                _templateEntity.Update(_templateEntity.Name, contentJson, _templateEntity.IsDefault, _templateEntity.PrinterId);
                DbContext.TicketTemplates.Update(_templateEntity);
            }
            else
            {
                _templateEntity = new TicketTemplate(
                    $"Plantilla {_selectedType}",
                    _selectedType,
                    contentJson,
                    true,
                    null
                );
                DbContext.TicketTemplates.Add(_templateEntity);
            }

            await DbContext.SaveChangesAsync(CancellationToken.None);
            Snackbar.Add("Plantilla de ticket guardada correctamente.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar la plantilla: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task PrintTestTicket()
    {
        if (!_selectedPrinterId.HasValue) return;

        _isPrinting = true;
        try
        {
            // Primero guardamos para asegurar que imprima la versión actual
            await SaveTemplate();

            var printer = await DbContext.Printers.FindAsync(_selectedPrinterId.Value);
            if (printer == null)
            {
                Snackbar.Add("Impresora seleccionada no encontrada.", Severity.Error);
                return;
            }

            // Conseguir un ejemplo real de la base de datos o simular uno
            string ticketText = string.Empty;
            switch (_selectedType)
            {
                case TicketTemplateType.Sale:
                    var sale = await DbContext.Sales.OrderByDescending(s => s.Date).FirstOrDefaultAsync();
                    if (sale != null)
                        ticketText = await TicketGenerator.GenerateSaleTicketAsync(sale.Id);
                    else
                        Snackbar.Add("No hay ventas en el sistema para usar como ejemplo.", Severity.Warning);
                    break;

                case TicketTemplateType.Invoice:
                    var invoice = await DbContext.Invoices.OrderByDescending(i => i.InvoiceDate).FirstOrDefaultAsync();
                    if (invoice != null)
                        ticketText = await TicketGenerator.GenerateInvoiceTicketAsync(invoice.Id);
                    else
                        Snackbar.Add("No hay facturas en el sistema para usar como ejemplo.", Severity.Warning);
                    break;

                case TicketTemplateType.Return:
                    var ret = await DbContext.Returns.OrderByDescending(r => r.ReturnDate).FirstOrDefaultAsync();
                    if (ret != null)
                        ticketText = await TicketGenerator.GenerateReturnTicketAsync(ret.Id);
                    else
                        Snackbar.Add("No hay devoluciones en el sistema para usar como ejemplo.", Severity.Warning);
                    break;

                case TicketTemplateType.CashCollection:
                    var col = await DbContext.CashCollections.OrderByDescending(c => c.CollectionDate).FirstOrDefaultAsync();
                    if (col != null)
                        ticketText = await TicketGenerator.GenerateCashCollectionTicketAsync(col.Id);
                    else
                        Snackbar.Add("No hay recolecciones en el sistema para usar como ejemplo.", Severity.Warning);
                    break;

                case TicketTemplateType.CashCut:
                    var cut = await DbContext.CashCuts.OrderByDescending(c => c.CutDate).FirstOrDefaultAsync();
                    if (cut != null)
                        ticketText = await TicketGenerator.GenerateCashCutTicketAsync(cut.Id);
                    else
                        Snackbar.Add("No hay cortes en el sistema para usar como ejemplo.", Severity.Warning);
                    break;

                case TicketTemplateType.Order:
                    var ord = await DbContext.Orders.OrderByDescending(o => o.OrderDate).FirstOrDefaultAsync();
                    if (ord != null)
                        ticketText = await TicketGenerator.GenerateOrderTicketAsync(ord.Id);
                    else
                        Snackbar.Add("No hay pedidos en el sistema para usar como ejemplo.", Severity.Warning);
                    break;

                case TicketTemplateType.RouteManifest:
                    var route = await DbContext.DeliveryRoutes.OrderByDescending(r => r.CreatedDate).FirstOrDefaultAsync();
                    if (route != null)
                        ticketText = await TicketGenerator.GenerateRouteManifestTicketAsync(route.Id);
                    else
                        Snackbar.Add("No hay rutas de reparto en el sistema para usar como ejemplo.", Severity.Warning);
                    break;
            }

            if (string.IsNullOrEmpty(ticketText))
            {
                Snackbar.Add("No se pudo generar el texto de prueba. Asegúrate de tener al menos un registro de este tipo.", Severity.Error);
                return;
            }

            // Enviar impresión al HardwareAgent
            string connectionUri = printer.ConnectionType switch
            {
                PrinterConnectionType.Network => printer.IpAddress ?? string.Empty,
                PrinterConnectionType.Usb => $"usb://{printer.DevicePath}",
                PrinterConnectionType.Serial => $"serial://{printer.DevicePath}?baud={printer.CodePage}",
                _ => printer.IpAddress ?? string.Empty
            };

            await EscPosPrinter.PrintTextAsync(
                connectionUri,
                printer.Port ?? 9100,
                ticketText,
                encodingCodePage: printer.CodePage > 0 ? printer.CodePage : 28591,
                cancellationToken: CancellationToken.None
            );

            Snackbar.Add("Impresión de prueba enviada con éxito.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Falla de impresión: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isPrinting = false;
        }
    }

