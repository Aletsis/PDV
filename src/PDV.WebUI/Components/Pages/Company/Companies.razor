@page "/admin/companies"
@using MediatR
@using PDV.Application.Features.Companies.Queries.GetCompanies
@using PDV.Application.Features.Companies.Commands.CreateCompany
@using PDV.Application.Features.Companies.Commands.UpdateCompany
@using PDV.Application.Features.Companies.Commands.DeleteCompany
@using PDV.Application.Features.Companies.Dtos
@using PDV.Application.Features.Sync.Queries
@using Microsoft.AspNetCore.Components.Authorization
@inject IMediator Mediator
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject PDV.WebUI.Services.ConnectionMonitor ConnectionMonitor
@inject AuthenticationStateProvider AuthProvider
@implements IDisposable

<PageTitle>Gestión de Empresas</PageTitle>

<div class="d-flex flex-column gap-6">
    <!-- Page Header & Mode Monitor -->
    <PdvHeader Title="Empresas (Tenants)"
               Subtitle="Administra las empresas y corporativos del sistema, sus datos fiscales y de contacto."
               Icon="@Icons.Material.Filled.Business"
               IconColor="Color.Primary">
        <StatusAlert>
            @if (isLocalMode)
            {
                <div class="local-mode-monitor d-flex align-center gap-3 px-4 py-2 border-dashed rounded-lg">
                    <div class="d-flex flex-column">
                        <span class="monitor-label">Base de Datos</span>
                        <span class="monitor-val font-weight-medium">Local (SQLite)</span>
                    </div>
                    <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />
                    <div class="d-flex flex-column align-end">
                        <span class="monitor-label">Modo Operativo</span>
                        <div class="d-flex align-center gap-1">
                            <MudIcon Icon="@Icons.Material.Filled.CloudDone" Size="Size.Small" Color="Color.Success" />
                            <span class="monitor-val-accent text-success font-weight-bold">Solo Lectura</span>
                        </div>
                    </div>
                </div>
            }
        </StatusAlert>
        <Actions>
            @if (!isLocalMode && isAdmin)
            {
                <PdvInteractiveButton Color="Color.Secondary" StartIcon="@Icons.Material.Filled.AddCircleOutline" OnClick="OpenCreateDialog">
                    Nueva Empresa
                </PdvInteractiveButton>
            }
        </Actions>
    </PdvHeader>

    <!-- Metrics Cards Grid -->
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <PdvKpiCard Title="Total Empresas"
                        Value="@totalCompaniesCount.ToString()"
                        Icon="@Icons.Material.Filled.Domain"
                        IconColor="Color.Primary"
                        IsLoading="@isLoading" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <PdvKpiCard Title="Activas"
                        Value="@activeCompaniesCount.ToString()"
                        Icon="@Icons.Material.Filled.CheckCircle"
                        IconColor="Color.Success"
                        IsLoading="@isLoading"
                        GradientType="PdvKpiCard.KpiGradientType.Success" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <PdvKpiCard Title="Inactivas"
                        Value="@inactiveCompaniesCount.ToString()"
                        Icon="@Icons.Material.Filled.DomainDisabled"
                        IconColor="Color.Error"
                        IsLoading="@isLoading"
                        GradientType="PdvKpiCard.KpiGradientType.Error" />
        </MudItem>
    </MudGrid>

    <!-- Server Only Mode Alert -->
    @if (isLocalMode)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="border-solid" Style="border-radius: 12px; border-width: 1px; background: rgba(33, 150, 243, 0.05);">
            La administración de empresas se realiza únicamente en el servidor central. En esta terminal local, la información se encuentra en modo de solo lectura.
        </MudAlert>
    }

    <!-- Main Data Section -->
    <MudPaper Class="p-4" Style="border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.05);">
        <!-- Table Toolbar -->
        <div class="d-flex align-center justify-space-between flex-wrap gap-4 mb-4">
            <div class="d-flex align-center gap-3 flex-grow-1" Style="max-width: 600px;">
                <MudTextField T="string" Value="searchString" ValueChanged="OnSearchStringChanged" Placeholder="Buscar por Nombre, RFC..." 
                               Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                               IconSize="Size.Medium" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                               Clearable="true" Class="flex-grow-1" />
                
                <MudSelect T="bool?" Value="filterActive" ValueChanged="OnFilterActiveChanged" Label="Estado" 
                           Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 180px;">
                    <MudSelectItem T="bool?" Value="@((bool?)null)">Todos</MudSelectItem>
                    <MudSelectItem T="bool?" Value="@(true)">Activas</MudSelectItem>
                    <MudSelectItem T="bool?" Value="@(false)">Inactivas</MudSelectItem>
                </MudSelect>
            </div>
        </div>

        <!-- Data Grid wrapped in State Container -->
        <PdvStateContainer IsLoading="@isLoading"
                            IsEmpty="@(!filteredCompanies.Any())"
                            EmptyTitle="Sin empresas"
                            EmptyMessage="No se encontraron empresas registradas que coincidan con la búsqueda."
                            EmptyIcon="@Icons.Material.Filled.Business"
                            SkeletonRows="5"
                            SkeletonColumns="6">
            <MudDataGrid T="CompanyDto" Items="@filteredCompanies" Filterable="false" Hover="true" Striped="true" 
                         Dense="false" Elevation="0" Class="border border-solid rounded-lg">
                <Columns>
                    <PropertyColumn Property="x => x.RFC" Title="RFC" CellStyle="font-weight: 600; color: var(--mud-palette-text-primary);" />
                    <PropertyColumn Property="x => x.Name" Title="Razón Social / Nombre" />
                    <TemplateColumn Title="Dirección Fiscal">
                        <CellTemplate>
                            @(context.Item.FiscalAddress != null ? $"{context.Item.FiscalAddress.Street}, {context.Item.FiscalAddress.City}" : "No asignada")
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.Phone" Title="Teléfono" />
                    <PropertyColumn Property="x => x.Email" Title="Email" />
                    <TemplateColumn Title="Estado">
                        <CellTemplate>
                            @if (context.Item.IsActive)
                            {
                                <MudChip T="string" Color="Color.Success" Variant="Variant.Text" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle" Class="font-weight-medium">Activa</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Default" Variant="Variant.Text" Size="Size.Small" Icon="@Icons.Material.Filled.Cancel" Class="font-weight-medium">Inactiva</MudChip>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    @if (!isLocalMode && isAdmin)
                    {
                        <TemplateColumn Title="Acciones" HeaderStyle="width: 120px;" CellClass="d-flex justify-end gap-1">
                            <CellTemplate>
                                <MudTooltip Text="Editar">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" 
                                                   OnClick="@(() => OpenEditDialog(context.Item))" Style="background-color: rgba(33, 150, 243, 0.05);" />
                                </MudTooltip>
                                <MudTooltip Text="Eliminar">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" 
                                                   OnClick="@(() => DeleteCompany(context.Item))" Style="background-color: rgba(244, 67, 54, 0.05);" />
                                </MudTooltip>
                            </CellTemplate>
                        </TemplateColumn>
                    }
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="CompanyDto" />
                </PagerContent>
            </MudDataGrid>
        </PdvStateContainer>
    </MudPaper>
</div>

@code {
    private List<CompanyDto> companies = new();
    private List<CompanyDto> filteredCompanies = new();
    
    private bool isLocalMode = false;
    private bool isLoading = false;
    private bool isAdmin = false;
    
    private int totalCompaniesCount = 0;
    private int activeCompaniesCount = 0;
    private int inactiveCompaniesCount = 0;
    
    private string searchString = "";
    private bool? filterActive = null;

    protected override async Task OnInitializedAsync()
    {
        ConnectionMonitor.OnConnectionStatusChanged += OnConnectionStatusChanged;
        await LoadSyncStatus();
        await LoadCompanies();
        await CheckUserRole();
    }

    private void OnConnectionStatusChanged(bool isConnected)
    {
        InvokeAsync(async () => {
            await LoadSyncStatus();
            StateHasChanged();
        });
    }

    private async Task LoadSyncStatus()
    {
        try
        {
            var syncStatus = await Mediator.Send(new GetSyncStatusQuery());
            isLocalMode = syncStatus.IsLocalMode;
        }
        catch (Exception)
        {
            isLocalMode = false;
        }
    }

    private async Task LoadCompanies()
    {
        isLoading = true;
        try
        {
            companies = await Mediator.Send(new GetCompaniesQuery(IncludeInactive: true));
            UpdateMetrics();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar empresas: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void UpdateMetrics()
    {
        totalCompaniesCount = companies.Count;
        activeCompaniesCount = companies.Count(c => c.IsActive);
        inactiveCompaniesCount = companies.Count(c => !c.IsActive);
    }

    private void ApplyFilters()
    {
        var query = companies.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchString))
        {
            query = query.Where(c => 
                c.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
                c.RFC.Contains(searchString, StringComparison.OrdinalIgnoreCase)
            );
        }

        if (filterActive.HasValue)
        {
            query = query.Where(c => c.IsActive == filterActive.Value);
        }

        filteredCompanies = query.ToList();
    }

    private void OnSearchStringChanged(string value)
    {
        searchString = value;
        ApplyFilters();
    }

    private void OnFilterActiveChanged(bool? value)
    {
        filterActive = value;
        ApplyFilters();
    }

    private async Task CheckUserRole()
    {
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            isAdmin = user.IsInRole("Admin");
        }
        catch (Exception)
        {
            isAdmin = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        if (isLocalMode || !isAdmin) return;
        
        var parameters = new DialogParameters<CompanyDialog>
        {
            { x => x.IsEdit, false },
            { x => x.Model, new CompanyDialog.CompanyFormModel() }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<CompanyDialog>("Registrar Nueva Empresa", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            Snackbar.Add("Empresa creada exitosamente", Severity.Success);
            await LoadCompanies();
        }
    }

    private async Task OpenEditDialog(CompanyDto company)
    {
        if (isLocalMode || !isAdmin) return;

        var model = new CompanyDialog.CompanyFormModel
        {
            Id = company.Id,
            Name = company.Name,
            RFC = company.RFC,
            Phone = company.Phone,
            Email = company.Email,
            Street = company.FiscalAddress?.Street ?? string.Empty,
            City = company.FiscalAddress?.City ?? string.Empty,
            State = company.FiscalAddress?.State ?? string.Empty,
            ZipCode = company.FiscalAddress?.ZipCode ?? string.Empty,
            Country = company.FiscalAddress?.Country ?? "México"
        };

        var parameters = new DialogParameters<CompanyDialog>
        {
            { x => x.IsEdit, true },
            { x => x.Model, model }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<CompanyDialog>("Editar Empresa", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            Snackbar.Add("Empresa actualizada exitosamente", Severity.Success);
            await LoadCompanies();
        }
    }

    private async Task DeleteCompany(CompanyDto company)
    {
        if (isLocalMode || !isAdmin) return;

        bool? result = await DialogService.ShowMessageBox(
            "Eliminar Empresa",
            $"¿Estás seguro que deseas eliminar {company.Name}? Se realizará un borrado lógico.",
            yesText: "Eliminar", cancelText: "Cancelar");

        if (result == true)
        {
            var deleteResult = await Mediator.Send(new DeleteCompanyCommand(company.Id));
            if (deleteResult.IsSuccess)
            {
                Snackbar.Add("Empresa eliminada exitosamente", Severity.Success);
                await LoadCompanies();
            }
            else
            {
                Snackbar.Add($"Error: {deleteResult.Error.Description}", Severity.Error);
            }
        }
    }

    public void Dispose()
    {
        ConnectionMonitor.OnConnectionStatusChanged -= OnConnectionStatusChanged;
    }
}
