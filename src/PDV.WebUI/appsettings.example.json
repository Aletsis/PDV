{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RunMode": "Server", // Modo de ejecución: "Server" (PostgreSQL/Redis) o "Local" (SQLite/Caché en memoria)
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=pdv_db;Username=postgres;Password=YourPasswordHere;", // Para "Server": PostgreSQL. Para "Local": "Data Source=pdv.db" (SQLite)
    "RedisConnection": "localhost:6379" // Cadena de conexión para Redis (Solo requerido en modo "Server")
  },
  "InventorySettings": {
    "DefaultLowStockThreshold": 5 // Umbral por defecto para alerta de stock bajo
  },
  "SyncSettings": {
    "SyncApiKey": "YourSecureApiKeyHere", // Api Key para autenticar la sincronización segura entre cajas locales y el servidor central
    "ServerBaseUrl": "auto", // URL del servidor central (modo Local). Usa "auto" o "discover" para autodescubrimiento UDP, o una URL estática (ej: "http://192.168.1.100:5000")
    "DiscoveryPort": 38120, // Puerto UDP utilizado para transmitir y escuchar anuncios de descubrimiento
    "DiscoveryTimeoutMs": 3000, // Tiempo límite en milisegundos para esperar respuesta del descubrimiento UDP
    "DiscoveryMaxAttempts": 3, // Intentos máximos de transmisión UDP antes de fallar
    "LocalServerBaseUrl": "http://+:5000", // URL base del servidor local (modo Server) que se anunciará a los clientes
    "AnnouncementIp": "" // IP estática opcional para anunciar. Dejar vacío para resolver la IP activa del adaptador de red automáticamente
  },
  "Hardware": {
    "Scale": {
      "Port": "MOCK", // Puerto serial de la báscula (ej: "COM3", "MOCK")
      "BaudRate": 9600, // Velocidad en baudios para la comunicación serial
      "Protocol": "Mock" // Protocolo/controlador de la báscula (ej: "Mock", "Torrey")
    },
    "PaymentTerminal": {
      "Port": "MOCK", // Puerto serial de la terminal de pago (ej: "COM4", "MOCK")
      "Protocol": "Mock" // Protocolo/controlador de la terminal (ej: "Mock", "Vx520")
    }
  },
  "Contpaqi": {
    "CodigoProductoGravado": "01010101", // Código de producto SAT por defecto para artículos gravados
    "CodigoProductoExento": "01010101" // Código de producto SAT por defecto para artículos exentos
  }
}
