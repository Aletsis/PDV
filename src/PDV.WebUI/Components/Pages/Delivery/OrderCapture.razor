@page "/orders/capture"
@using MediatR
@using PDV.Application.Common.Helpers
@using PDV.Application.Features.CashRegisters.Queries.GetCashRegisterByIp
@using PDV.Application.Features.Clients.Dtos
@using PDV.Application.Features.Clients.Queries.ListClients
@using PDV.Application.Features.Products.Dtos
@using PDV.Application.Features.Products.Queries.GetProducts
@using PDV.Application.Features.Orders.Commands.CreateOrder
@using PDV.Application.Features.Orders.Commands.PrintOrderTicket
@using PDV.Application.Features.Shifts.Dtos
@using PDV.Application.Features.Shifts.Queries.GetActiveShift
@using PDV.Application.Features.Shifts.Queries.GetActiveShiftByUserId
@using PDV.Domain.Entities
@using PDV.Domain.Enums
@using PDV.Application.Features.DeliveryZones.Queries.GetDeliveryZones
@using PDV.Application.Features.Products.Queries.GetProductByCode
@using PDV.Application.Common.Interfaces
@using PDV.WebUI.Components.Pages.Product
@using Microsoft.EntityFrameworkCore
@inject IMediator Mediator
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject PDV.WebUI.Services.ShiftSessionService ShiftSession
@inject AuthenticationStateProvider AuthStateProvider
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS
@inject IScaleService ScaleService
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject IDialogService DialogService
@inject IApplicationDbContext DbContext
@attribute [Authorize]

<PageTitle>Capturar Pedido</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    @if (!ShiftSession.HasActiveShift)
    {
        <div class="d-flex flex-column align-center justify-center" style="min-height: 60vh;">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Style="font-size: 4rem; color: var(--mud-palette-warning);" />
            <MudText Typo="Typo.h5" Class="mt-4 font-weight-bold">Sin turno activo</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">Debes abrir un turno de caja antes de capturar pedidos.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo("/pos"))">
                Ir al Punto de Venta
            </MudButton>
        </div>
    }
    else
    {
        <MudText Typo="Typo.h4" GutterBottom="true" Class="font-weight-bold">Capturar Pedido en Caja</MudText>
        <MudText Typo="Typo.body1" Class="mb-4">Capture los productos pesados directamente en caja para generar la comanda de reparto.</MudText>

        <MudGrid>
            <!-- Formulario de Selección (Cliente y Producto) -->
            <MudItem xs="12" md="4">
                <MudCard Elevation="3" Class="mb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">1. Datos de Entrega</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudAutocomplete T="ClientDto" Label="Buscar Cliente" 
                                         SearchFunc="SearchClients" 
                                         Value="_selectedClient"
                                         ValueChanged="OnClientChanged"
                                         ToStringFunc="@(c => c == null ? "" : $"{c.Name} ({c.Code})")"
                                         Variant="Variant.Outlined" 
                                         Adornment="Adornment.End" 
                                         AdornmentIcon="@Icons.Material.Filled.Search" 
                                         Required="true"
                                         Class="mb-3" />

                        @if (_selectedClient != null)
                        {
                            <MudPaper Class="pa-3 bg-light border-solid border rounded-lg mb-3" Elevation="0">
                                <MudText Typo="Typo.body2"><strong>Dirección:</strong> @(_selectedClient.Address ?? "Sin dirección registrada")</MudText>
                                <MudText Typo="Typo.body2"><strong>Teléfono:</strong> @_selectedClient.Phone</MudText>
                                @if (_selectedClient.DeliveryZoneId.HasValue)
                                {
                                    <div class="mt-2">
                                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.LocalShipping" Class="font-weight-bold">
                                            @_selectedClient.DeliveryZoneName
                                        </MudChip>
                                        <MudText Typo="Typo.caption" Class="d-block mt-1">Costo de Envío: @_deliveryCost.ToString("C2")</MudText>
                                    </div>
                                }
                                else
                                {
                                    <div class="mt-2">
                                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Warning" Class="font-weight-bold">
                                            Sin Zona de Reparto
                                        </MudChip>
                                        <MudText Typo="Typo.caption" Class="d-block mt-1">El costo de envío será de $0.00</MudText>
                                    </div>
                                }
                            </MudPaper>
                        }

                        <MudSelect T="string" @bind-Value="_paymentMethod" Label="Forma de Pago" Variant="Variant.Outlined" Class="mb-3">
                            <MudSelectItem Value="@("Cash")">Efectivo</MudSelectItem>
                            <MudSelectItem Value="@("CreditCard")">Tarjeta Bancaria</MudSelectItem>
                        </MudSelect>
                    </MudCardContent>
                </MudCard>

                <MudCard Elevation="3" Class="d-flex flex-column" Style="height: 100%;">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Class="font-weight-bold d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Color="Color.Primary" />
                                2. Escanear / Buscar
                            </MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="d-flex flex-column gap-3">
                        <MudTextField @ref="barcodeField"
                                      @bind-Value="searchCode" 
                                      Label="Código EAN-13 / SKU / PLU" 
                                      Variant="Variant.Outlined" 
                                      Adornment="Adornment.End" 
                                      AdornmentIcon="@Icons.Material.Filled.Search" 
                                      OnAdornmentClick="SearchProduct"
                                      @onkeydown="KeyPress"
                                      Placeholder="Escribe o escanea código..."
                                      HelperText="Presiona ENTER para buscar"
                                      Class="font-weight-bold"
                                      Immediate="true"
                                      TextUpdateSuppression="false" />

                        <MudDivider />

                        @if (searchedProduct != null)
                        {
                            <MudCard Elevation="0" Class="border-solid border-2 mud-border-primary pa-2 d-flex flex-column justify-space-between" Style="background: rgba(255,255,255,0.01); border-radius: 8px;">
                                <MudCardContent>
                                    <div class="d-flex justify-space-between align-center mb-2">
                                        <MudChip T="string" Size="Size.Small" Color="@(searchedProduct.SaleType == "Bulk" ? Color.Info : Color.Default)">
                                            @(searchedProduct.SaleType == "Bulk" ? "A Granel" : "Por Pieza")
                                        </MudChip>
                                        <div class="d-flex align-center gap-1">
                                            <MudText Color="@(searchedProductStock > 0 ? Color.Success : Color.Error)" Class="font-weight-bold">
                                                Stock: @searchedProductStock.ToString(searchedProduct.SaleType == "Bulk" ? "N3" : "N0")
                                            </MudText>
                                            <MudTooltip Text="Ver existencias por sucursal">
                                                <MudIconButton Icon="@Icons.Material.Filled.Storefront" 
                                                               Size="Size.Small" 
                                                               Color="Color.Info" 
                                                               OnClick="OpenBranchStockDialog" 
                                                               Style="padding: 2px;" />
                                            </MudTooltip>
                                        </div>
                                    </div>
                                    <MudText Typo="Typo.h6" Class="font-weight-bold">@searchedProduct.Name</MudText>
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Código: @searchedProduct.Code</MudText>
                                    
                                    <MudText Typo="Typo.h4" Color="Color.Primary" Class="mt-4 font-weight-bold">
                                        @((_selectedClient != null && _selectedClient.ClientType == ClientType.Wholesale && searchedProduct.WholesalePrice.HasValue ? searchedProduct.WholesalePrice.Value : searchedProduct.Price).ToString("C2"))
                                        @(searchedProduct.SaleType == "Bulk" ? " / kg" : "")
                                    </MudText>
                                    @if (_selectedClient != null && _selectedClient.ClientType == ClientType.Wholesale && searchedProduct.WholesalePrice.HasValue)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Success" Class="d-block font-weight-bold">Precio de Mayoreo Aplicado</MudText>
                                    }
                                </MudCardContent>
                                <MudCardActions Class="flex-column gap-3 w-100 pa-4">
                                    @if (searchedProduct.SaleType == "Bulk")
                                    {
                                        <div class="d-flex align-center gap-2 w-100">
                                            <MudNumericField @bind-Value="weightToAdd" 
                                                           Label="Peso a Agregar (kg)" 
                                                           Variant="Variant.Outlined" 
                                                           Min="0.001m" 
                                                           Step="0.1m"
                                                           Format="N3"
                                                           Class="flex-grow-1 font-weight-bold text-lg"
                                                           HideSpinButtons="true" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Scale" 
                                                           Color="Color.Secondary" 
                                                           Variant="Variant.Filled" 
                                                           Size="Size.Large"
                                                           OnClick="ReadFromScale" 
                                                           title="Leer Báscula (F9)" 
                                                           Style="height: 56px;" 
                                                           Disabled="readingScale" />
                                        </div>
                                    }
                                    else
                                    {
                                        <MudNumericField @bind-Value="quantityToAdd" 
                                                       Label="Cantidad a Agregar" 
                                                       Variant="Variant.Outlined" 
                                                       Min="1" 
                                                       Max="100" 
                                                       Class="w-100 font-weight-bold text-lg"
                                                       HideSpinButtons="true" />
                                    }
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddToCart" FullWidth="true" Size="Size.Large" Class="py-3 font-weight-bold">
                                        Agregar al Pedido
                                    </MudButton>
                                </MudCardActions>
                            </MudCard>
                        }
                        else if (notFound)
                        {
                             <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Style="border-radius: 8px;">Producto no encontrado.</MudAlert>
                        }
                        else
                        {
                            <div class="d-flex flex-column align-center justify-center flex-grow-1 mud-text-secondary pa-6 text-center border-dashed border-2 mud-border-secondary" style="border-radius: 8px; background: rgba(255,255,255,0.01); min-height: 200px;">
                                <MudIcon Icon="@Icons.Material.Filled.Scanner" Size="Size.Large" Class="mb-3" />
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Listo para Escanear</MudText>
                                <MudText Typo="Typo.body2">Escanea el código de barras o escribe el SKU del producto en la caja de búsqueda superior.</MudText>
                            </div>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Carrito y Totales -->
            <MudItem xs="12" md="8">
                <MudCard Elevation="3" Style="min-height: 500px;" Class="d-flex flex-column justify-space-between">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Class="mb-3">Detalle del Pedido</MudText>
                        
                        @if (_cart.Count == 0)
                        {
                            <div class="d-flex flex-column align-center justify-center py-8">
                                <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Style="font-size: 3rem; color: var(--mud-palette-action-disabled);" />
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">El pedido está vacío. Agregue productos para comenzar.</MudText>
                            </div>
                        }
                        else
                        {
                            <MudTable Items="@_cart" Hover="true" Dense="true" Elevation="0">
                                <HeaderContent>
                                    <MudTh>Código</MudTh>
                                    <MudTh>Producto</MudTh>
                                    <MudTh>Cantidad/Peso</MudTh>
                                    <MudTh>P. Unitario</MudTh>
                                    <MudTh>Total</MudTh>
                                    <MudTh Style="width: 50px;"></MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@context.Product.Code</MudTd>
                                    <MudTd>@context.Product.Name</MudTd>
                                    <MudTd>
                                        @if (context.Product.SaleType == "Bulk")
                                        {
                                            <span>@context.Quantity.ToString("F3") kg</span>
                                        }
                                        else
                                        {
                                            <span>@((int)context.Quantity) pz</span>
                                        }
                                    </MudTd>
                                    <MudTd>@((context.PriceOverride ?? context.Product.Price).ToString("C2"))</MudTd>
                                    <MudTd>@context.Total.ToString("C2")</MudTd>
                                    <MudTd>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => RemoveFromCart(context)" />
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudCardContent>

                    <MudCardActions Class="d-flex flex-column pa-4 border-t">
                        <div class="d-flex justify-space-between w-100 mb-2">
                            <MudText Typo="Typo.body1">Subtotal:</MudText>
                            <MudText Typo="Typo.body1">@_subtotal.ToString("C2")</MudText>
                        </div>
                        <div class="d-flex justify-space-between w-100 mb-2">
                            <MudText Typo="Typo.body1">IVA:</MudText>
                            <MudText Typo="Typo.body1">@_taxes.ToString("C2")</MudText>
                        </div>
                        <div class="d-flex justify-space-between w-100 mb-2">
                            <MudText Typo="Typo.body1">Costo de Envío:</MudText>
                            <MudText Typo="Typo.body1">@_deliveryCost.ToString("C2")</MudText>
                        </div>
                        <div class="d-flex justify-space-between w-100 mb-4">
                            <MudText Typo="Typo.h5" Class="font-weight-bold">TOTAL:</MudText>
                            <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Primary">@_total.ToString("C2")</MudText>
                        </div>

                        <div class="d-flex gap-2 w-100">
                            <MudButton OnClick="ClearOrder" Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.DeleteSweep" FullWidth="true" Disabled="@(_cart.Count == 0)">
                                Limpiar Pedido
                            </MudButton>
                            <MudButton OnClick="SubmitOrder" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.CheckCircle" FullWidth="true" Disabled="@(!CanSubmit)">
                                Registrar Pedido
                            </MudButton>
                        </div>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private ClientDto? _selectedClient;
    private string _paymentMethod = "Cash";
    private List<CartItem> _cart = new();

    private MudTextField<string>? barcodeField;
    private string searchCode = "";
    private ProductDto? searchedProduct;
    private decimal searchedProductStock;
    private bool notFound = false;
    private int quantityToAdd = 1;
    private decimal weightToAdd = 1.0m;
    private bool readingScale = false;

    private List<ClientDto> _allClients = new();
    private List<ProductDto> _allProducts = new();
    private List<DeliveryZone> _zones = new();

    private decimal _subtotal => _cart.Sum(x => x.Total);
    private decimal _taxes => _cart.Sum(x => x.Total * GetTaxRatePercent(x.Product.TaxRate) / 100m);
    private decimal _deliveryCost = 0m;
    private decimal _total => _subtotal + _taxes + _deliveryCost;

    private bool CanSubmit => _selectedClient != null && _cart.Count > 0 && ShiftSession.HasActiveShift;

    protected override async Task OnInitializedAsync()
    {
        if (!ShiftSession.HasActiveShift)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            ShiftDto? activeShift = null;

            // 1. Intentar restaurar por ID del usuario autenticado
            if (!string.IsNullOrEmpty(currentUserId))
            {
                activeShift = await Mediator.Send(new GetActiveShiftByUserIdQuery(currentUserId));
            }

            // 2. Si no se encontró por usuario, intentar restaurar por IP de la terminal
            if (activeShift == null)
            {
                try
                {
                    var httpContext = HttpContextAccessor.HttpContext;
                    var rawIp = httpContext?.Connection.RemoteIpAddress?.MapToIPv4().ToString();
                    var clientIp = IpAddressHelper.ResolveClientIp(rawIp);
                    if (!string.IsNullOrEmpty(clientIp))
                    {
                        var cashRegister = await Mediator.Send(new GetCashRegisterByIpQuery(clientIp));
                        if (cashRegister != null)
                        {
                            activeShift = await Mediator.Send(new GetActiveShiftByCashRegisterQuery(cashRegister.Id));
                        }
                    }
                }
                catch
                {
                    // Fallback silencioso
                }
            }

            // Si se encontró turno activo, hidratar ShiftSession
            if (activeShift != null)
            {
                ShiftSession.SetActive(
                    activeShift.Id,
                    activeShift.CashRegisterId,
                    activeShift.CashRegisterName,
                    activeShift.InitialCash,
                    activeShift.StartTime,
                    activeShift.BranchId);
            }
        }

        if (ShiftSession.HasActiveShift)
        {
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        _allClients = await Mediator.Send(new ListClientsQuery { IncludeInactive = false });
        _allProducts = await Mediator.Send(new GetProductsQuery());
        _zones = await Mediator.Send(new GetDeliveryZonesQuery { OnlyActive = true });
    }

    private Task<IEnumerable<ClientDto>> SearchClients(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
            return Task.FromResult<IEnumerable<ClientDto>>(_allClients);

        var search = value.Trim().ToLower();
        return Task.FromResult<IEnumerable<ClientDto>>(
            _allClients.Where(x => x.Name.ToLower().Contains(search) || x.Code.ToLower().Contains(search))
        );
    }

    private void OnClientChanged(ClientDto client)
    {
        _selectedClient = client;
        if (client != null && client.DeliveryZoneId.HasValue)
        {
            var zone = _zones.FirstOrDefault(z => z.Id == client.DeliveryZoneId.Value);
            _deliveryCost = zone?.DeliveryCost ?? 0m;
        }
        else
        {
            _deliveryCost = 0m;
        }

        // Al cambiar de cliente, volvemos a calcular los precios de los productos en el carrito (por si cambió a/de Wholesale)
        foreach (var item in _cart)
        {
            decimal? priceOverride = null;
            if (_selectedClient != null)
            {
                if (_selectedClient.ClientType == ClientType.Wholesale && item.Product.WholesalePrice.HasValue)
                {
                    priceOverride = item.Product.WholesalePrice.Value;
                }
            }
            item.PriceOverride = priceOverride;
        }
        StateHasChanged();
    }

    private async Task KeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchProduct();
        }
        else if (e.Key == "F9")
        {
            await TriggerScaleRead();
        }
    }

    public async Task TriggerScaleRead()
    {
        if (searchedProduct != null && searchedProduct.SaleType == "Bulk")
        {
            await ReadFromScale();
        }
    }

    private async Task ReadFromScale()
    {
        if (readingScale) return;
        readingScale = true;
        StateHasChanged();
        try
        {
            var port = Configuration["Hardware:Scale:Port"] ?? "MOCK";
            var baud = int.TryParse(Configuration["Hardware:Scale:BaudRate"], out var b) ? b : 9600;
            var protocol = Configuration["Hardware:Scale:Protocol"] ?? "Mock";

            var result = await ScaleService.ReadWeightAsync(port, baud, protocol);
            if (result.Success)
            {
                weightToAdd = result.Weight;
                Snackbar.Add($"Peso leído: {result.Weight} {result.Unit}", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Error de báscula: {result.ErrorMessage}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al leer báscula: {ex.Message}", Severity.Error);
        }
        finally
        {
            readingScale = false;
            StateHasChanged();
        }
    }

    private async Task SearchProduct()
    {
        if (string.IsNullOrWhiteSpace(searchCode)) return;

        notFound = false;
        searchedProduct = null;
        var processedCode = searchCode.Trim();
        searchCode = ""; // Limpiar inmediatamente para escaneo continuo fluido
        StateHasChanged();

        // EAN-13 Bulk Barcode Parsing: starts with '2', has 13 numeric digits
        if (processedCode.Length == 13 && processedCode.StartsWith("2") && processedCode.All(char.IsDigit))
        {
            var codePart = processedCode.Substring(1, 6);
            var weightPart = processedCode.Substring(7, 6);

            if (int.TryParse(weightPart.Substring(0, 2), out int integerPart) && 
                int.TryParse(weightPart.Substring(2, 4), out int fractionalPart))
            {
                decimal weight = integerPart + (decimal)fractionalPart / 10000m;

                var product = await Mediator.Send(new GetProductByCodeQuery(codePart));
                if (product != null)
                {
                    var productDto = MapToDto(product);
                    AddProductDirectly(productDto, weight);
                    if (barcodeField != null)
                    {
                        await barcodeField.FocusAsync();
                    }
                    return;
                }
            }
        }

        // Standard flow
        var foundProduct = await Mediator.Send(new GetProductByCodeQuery(processedCode));

        if (foundProduct == null)
        {
            notFound = true;
            if (barcodeField != null)
            {
                await barcodeField.FocusAsync();
            }
        }
        else
        {
            var productDto = MapToDto(foundProduct);
            // Auto add Piece products to cart for ultimate speed!
            if (productDto.SaleType == "Piece")
            {
                AddProductDirectly(productDto, 1);
                if (barcodeField != null)
                {
                    await barcodeField.FocusAsync();
                }
            }
            else
            {
                searchedProduct = productDto;
                weightToAdd = 1.0m;
                searchedProductStock = 0;
                if (ShiftSession.BranchId.HasValue)
                {
                    var branchStock = await DbContext.ProductBranchStocks
                        .FirstOrDefaultAsync(s => s.ProductId == foundProduct.Id && s.BranchId == ShiftSession.BranchId.Value);
                    if (branchStock != null)
                    {
                        searchedProductStock = branchStock.Stock;
                    }
                }
            }
        }
    }

    private ProductDto MapToDto(Product x)
    {
        var existing = _allProducts.FirstOrDefault(p => p.Id == x.Id);
        if (existing != null) return existing;

        return new ProductDto
        {
            Id = x.Id,
            Name = x.Name,
            Code = x.Code,
            Plu = x.Plu,
            Description = x.Description,
            Price = x.Price,
            WholesalePrice = x.WholesalePrice,
            WholesaleMinQuantity = x.WholesaleMinQuantity,
            SaleType = x.SaleType.ToString(),
            Barcode = x.Barcode,
            Cost = x.Cost,
            TaxRate = x.TaxRate.ToString(),
            IsActive = x.IsActive,
            SatCode = x.SatCode,
            Type = (int)x.Type,
            ControlExistencia = (int)x.ControlExistencia,
            SaleUnitId = x.SaleUnitId,
            SaleUnitName = x.SaleUnitName,
            XmlUnitId = x.XmlUnitId,
            Department = x.Department,
            Clasificacion1Id = x.Clasificacion1Id,
            Clasificacion5Id = x.Clasificacion5Id
        };
    }

    private void AddProductDirectly(ProductDto product, decimal quantityOrWeight)
    {
        decimal? priceOverride = null;
        if (_selectedClient != null)
        {
            if (_selectedClient.ClientType == ClientType.Wholesale && product.WholesalePrice.HasValue)
            {
                priceOverride = product.WholesalePrice.Value;
            }
        }

        var existingItem = _cart.FirstOrDefault(x => x.Product.Id == product.Id);
        if (existingItem != null)
        {
            existingItem.Quantity += quantityOrWeight;
            Snackbar.Add($"{product.Name} actualizado a {existingItem.Quantity.ToString(product.SaleType == "Bulk" ? "N3" : "N0")}", Severity.Success);
        }
        else
        {
            _cart.Add(new CartItem
            {
                Product = product,
                Quantity = quantityOrWeight,
                PriceOverride = priceOverride
            });
            Snackbar.Add($"{product.Name} agregado al pedido", Severity.Success);
        }
        StateHasChanged();
    }

    private void AddToCart()
    {
        if (searchedProduct == null) return;
        var prod = searchedProduct;
        decimal amount = prod.SaleType == "Bulk" ? weightToAdd : quantityToAdd;

        searchedProduct = null;
        searchCode = "";
        notFound = false;
        quantityToAdd = 1;
        weightToAdd = 1.0m;

        AddProductDirectly(prod, amount);

        if (barcodeField != null)
        {
            InvokeAsync(async () => {
                await Task.Delay(50);
                await barcodeField.FocusAsync();
            });
        }
    }

    private async Task OpenBranchStockDialog()
    {
        if (searchedProduct == null) return;
        var parameters = new DialogParameters<ProductBranchStockDialog>
        {
            { x => x.ProductId, searchedProduct.Id },
            { x => x.ProductName, searchedProduct.Name },
            { x => x.ProductCode, searchedProduct.Code }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<ProductBranchStockDialog>("Existencias por Sucursal", parameters, options);
    }

    private void RemoveFromCart(CartItem item)
    {
        _cart.Remove(item);
    }

    private void ClearOrder()
    {
        _cart.Clear();
        _selectedClient = null;
        searchedProduct = null;
        searchCode = "";
        notFound = false;
        quantityToAdd = 1;
        weightToAdd = 1.0m;
        _deliveryCost = 0m;
        _paymentMethod = "Cash";
    }

    private async Task SubmitOrder()
    {
        if (!CanSubmit) return;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            string userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? user.Identity?.Name ?? "system";

            var command = new CreateOrderCommand
            {
                ClientId = _selectedClient!.Id,
                CashRegisterId = ShiftSession.ActiveCashRegisterId ?? Guid.Empty,
                PaymentMethod = _paymentMethod,
                UserId = userId,
                Items = _cart.Select(x => new OrderCartItemDto
                {
                    ProductId = x.Product.Id,
                    Quantity = x.Quantity,
                    PriceOverride = x.PriceOverride
                }).ToList()
            };

            var orderId = await Mediator.Send(command);
            Snackbar.Add("Pedido registrado exitosamente.", Severity.Success);

            // Imprimir el ticket de forma asíncrona
            await Mediator.Send(new PrintOrderTicketCommand(orderId, ShiftSession.ActiveCashRegisterId ?? Guid.Empty));

            ClearOrder();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al registrar pedido: {ex.Message}", Severity.Error);
        }
    }

    private decimal GetTaxRatePercent(string taxRate)
    {
        return taxRate switch
        {
            "Rate16" => 16m,
            "Rate8" => 8m,
            _ => 0m
        };
    }

    private class CartItem
    {
        public ProductDto Product { get; set; } = null!;
        public decimal Quantity { get; set; }
        public decimal? PriceOverride { get; set; }
        public decimal Total => Quantity * (PriceOverride ?? Product.Price);
    }
}
