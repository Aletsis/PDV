@using MediatR
@using PDV.Application.Features.PriceLists.Queries.GetProductPrices
@using PDV.Application.Features.PriceLists.Commands.AddOrUpdateProductPrice
@using PDV.Application.Features.PriceLists.Commands.RemoveProductPrice
@using PDV.Application.Features.PriceLists.Dtos
@inject IMediator Mediator
@inject ISnackbar Snackbar

<MudDialog Style="min-height: 500px; max-height: 80vh;">
    <TitleContent>
        <div class="d-flex align-center justify-space-between gap-4">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Color="Color.Primary" Size="Size.Medium" />
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.h6" Class="font-weight-bold">Asignación de Precios de Productos</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Lista: @PriceListName</MudText>
                </div>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-4" Style="height: 100%;">
            <!-- Search field -->
            <div class="d-flex align-center gap-3">
                <MudTextField T="string" Value="@searchString" ValueChanged="OnSearchChanged" Placeholder="Buscar producto por nombre o código..." 
                               Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                               IconSize="Size.Medium" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                               Clearable="true" Class="flex-grow-1" />
            </div>

            <!-- Table -->
            <div style="overflow-y: auto; max-height: 50vh;" class="border border-solid rounded-lg">
                <PdvStateContainer IsLoading="@_loading"
                                    IsEmpty="@(!productPrices.Any())"
                                    EmptyTitle="Sin productos"
                                    EmptyMessage="No se encontraron productos activos."
                                    EmptyIcon="@Icons.Material.Filled.Inventory"
                                    SkeletonRows="5"
                                    SkeletonColumns="5">
                    <MudTable T="PriceListProductDto" Items="@productPrices" Hover="true" Striped="true" Elevation="0" Dense="true">
                        <HeaderContent>
                            <MudTh>Código</MudTh>
                            <MudTh>Nombre del Producto</MudTh>
                            <MudTh Style="text-align: right;">Precio Base</MudTh>
                            <MudTh Style="text-align: right; width: 180px;">Precio Especial</MudTh>
                            @if (!IsReadOnly)
                            {
                                <MudTh Style="text-align: right; width: 150px;">Acciones</MudTh>
                            }
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Código" Class="font-weight-medium">@context.ProductCode</MudTd>
                            <MudTd DataLabel="Producto">@context.ProductName</MudTd>
                            <MudTd DataLabel="Precio Base" Style="text-align: right;">@context.OriginalPrice.ToString("C2")</MudTd>
                            <MudTd DataLabel="Precio Especial" Style="text-align: right;">
                                @if (IsReadOnly)
                                {
                                    <span class="@(context.IsOverridden ? "text-warning font-weight-bold" : "")">
                                        @context.CustomPrice.ToString("C2")
                                    </span>
                                }
                                else
                                {
                                    <div class="d-flex align-center justify-end gap-1">
                                        @if (editingProductId == context.ProductId)
                                        {
                                            <MudNumericField @bind-Value="tempPrice" Format="N2" HideSpinButtons="true"
                                                             Variant="Variant.Outlined" Margin="Margin.Dense" 
                                                             Style="width: 100px; text-align: right;" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" OnClick="@(() => SavePrice(context))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" Size="Size.Small" OnClick="CancelEdit" />
                                        }
                                        else
                                        {
                                            <span class="@(context.IsOverridden ? "text-warning font-weight-bold" : "text-muted")">
                                                @context.CustomPrice.ToString("C2")
                                            </span>
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => StartEdit(context))" Class="ml-2" />
                                        }
                                    </div>
                                }
                            </MudTd>
                            @if (!IsReadOnly)
                            {
                                <MudTd DataLabel="Acciones" Style="text-align: right;">
                                    @if (context.IsOverridden)
                                    {
                                        <MudButton StartIcon="@Icons.Material.Filled.SettingsBackupRestore" 
                                                   Color="Color.Error" 
                                                   Size="Size.Small" 
                                                   Variant="Variant.Text"
                                                   OnClick="@(() => RemovePrice(context))"
                                                   Style="text-transform: none;">
                                            Restablecer
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 0.8rem;">Precio Base</span>
                                    }
                                </MudTd>
                            }
                        </RowTemplate>
                    </MudTable>
                </PdvStateContainer>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Primary" Variant="Variant.Filled" Style="text-transform: none; font-weight: 500;">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public Guid PriceListId { get; set; }

    [Parameter]
    public string PriceListName { get; set; } = string.Empty;

    [Parameter]
    public bool IsReadOnly { get; set; }

    private List<PriceListProductDto> productPrices = new();
    private bool _loading = false;
    private string searchString = "";
    
    // Inline editing state
    private Guid? editingProductId = null;
    private decimal tempPrice = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        _loading = true;
        try
        {
            productPrices = await Mediator.Send(new GetProductPricesQuery(PriceListId, searchString));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar productos: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearchChanged(string value)
    {
        searchString = value;
        await LoadProducts();
    }

    private void StartEdit(PriceListProductDto item)
    {
        editingProductId = item.ProductId;
        tempPrice = item.CustomPrice;
    }

    private void CancelEdit()
    {
        editingProductId = null;
    }

    private async Task SavePrice(PriceListProductDto item)
    {
        if (tempPrice < 0)
        {
            Snackbar.Add("El precio no puede ser negativo", Severity.Warning);
            return;
        }

        try
        {
            var result = await Mediator.Send(new AddOrUpdateProductPriceCommand(PriceListId, item.ProductId, tempPrice));
            if (result.IsSuccess)
            {
                Snackbar.Add("Precio especial asignado con éxito", Severity.Success);
                editingProductId = null;
                await LoadProducts();
            }
            else
            {
                Snackbar.Add($"Error: {result.Error.Description}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task RemovePrice(PriceListProductDto item)
    {
        try
        {
            var result = await Mediator.Send(new RemoveProductPriceCommand(PriceListId, item.ProductId));
            if (result.IsSuccess)
            {
                Snackbar.Add("Precio restablecido al valor base del catálogo", Severity.Info);
                await LoadProducts();
            }
            else
            {
                Snackbar.Add($"Error: {result.Error.Description}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void Close() => MudDialog.Close();
}
