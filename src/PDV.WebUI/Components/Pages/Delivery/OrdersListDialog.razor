@using MediatR
@using PDV.Domain.Enums
@using PDV.Application.Features.CashRegisters.Dtos
@using PDV.Application.Features.Orders.Dtos
@using PDV.Application.Features.Orders.Queries.ListOrders
@using PDV.Application.Features.Orders.Queries.GetOrders
@using PDV.Application.Features.Orders.Queries.GetOrderByTicket
@using PDV.Application.Features.Orders.Commands.ImportOrder
@using PDV.Application.Features.Orders.Commands.CancelOrder
@using PDV.WebUI.Components.Pages.Auth
@inject PDV.WebUI.Services.ConnectionMonitor ConnectionMonitor
@inject IMediator Mediator
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthenticationStateProvider

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5" Class="font-weight-bold d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Primary" />
            Historial de Pedidos y Cancelaciones
        </MudText>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-4 py-2" style="position: relative;">
            @if (isWaitingForConnection)
            {
                <div class="d-flex flex-column align-center justify-center pa-8 text-center" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(13, 16, 32, 0.95); z-index: 100; border-radius: 12px; backdrop-filter: blur(10px);">
                    <MudProgressCircular Color="Color.Warning" Size="Size.Large" Indeterminate="true" Class="mb-4" />
                    <MudText Typo="Typo.h5" Class="font-weight-bold mb-2 mud-text-warning">Esperando Conexión al Servidor Central...</MudText>
                    <MudText Typo="Typo.body1" Class="mud-text-secondary mb-6" Style="max-width: 400px;">
                        Se ha pausado la validación del ticket <strong>@searchSeries-@searchFolio</strong>. En cuanto se restablezca la comunicación de red, el ticket se validará automáticamente.
                    </MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => { isWaitingForConnection = false; })" Style="text-transform: none; border-radius: 8px; font-weight: bold;">
                        Cancelar Espera
                    </MudButton>
                </div>
            }
            <div>
                @if (ConnectionMonitor.IsLocalMode && !ConnectionMonitor.IsConnected)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Icon="@Icons.Material.Filled.WifiOff" Style="border-radius: 8px;">
                        Modo Local (SQLite) — Mostrando solo pedidos de esta Caja: <strong>@(currentCashRegister?.Name ?? "Local")</strong>
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Dense="true" Icon="@Icons.Material.Filled.CloudDone" Style="border-radius: 8px;">
                        Modo Online (Sincronizado) — Visualizando pedidos globales de la sucursal
                    </MudAlert>
                }
            </div>
            <MudPaper Class="pa-4 border-solid border mud-border-secondary" Style="border-radius: 12px; background: rgba(255,255,255,0.01);">
                <MudGrid>
                    <MudItem xs="12" md="3">
                        <MudDatePicker @bind-Date="startDate" Label="Fecha de Inicio" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudDatePicker @bind-Date="endDate" Label="Fecha de Fin" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect T="string" @bind-Value="filterStatus" Label="Estado del pedido" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="@("all")">Todos los Estados</MudSelectItem>
                            <MudSelectItem Value="@("open")">Abierto</MudSelectItem>
                            <MudSelectItem Value="@("confirmed")">Capturado</MudSelectItem>
                            <MudSelectItem Value="@("EnRoute")">En ruta</MudSelectItem>
                            <MudSelectItem Value="@("cancelled")">Cancelado</MudSelectItem>
                            <MudSelectItem Value="@("delivered")">Entregado</MudSelectItem>
                            <MudSelectItem Value="@("not-delivered")">No entregado</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3" Class="d-flex gap-2">
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   StartIcon="@Icons.Material.Filled.FilterAlt"
                                   OnClick="LoadData" 
                                   FullWidth="true" 
                                   Style="height: 40px; text-transform: none; font-weight: bold; border-radius: 8px;">
                            Filtrar Historial
                        </MudButton>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField @bind-Value="searchSeries" Label="Serie del Ticket" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Ej. V" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudNumericField @bind-Value="searchFolio" Label="Folio del Ticket" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Ej. 123" HideSpinButtons="true" />
                    </MudItem>
                    <MudItem xs="12" md="6" Class="d-flex gap-2">
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Warning" 
                                   StartIcon="@Icons.Material.Filled.Search"
                                   OnClick="SearchByTicket" 
                                   FullWidth="true" 
                                   Style="height: 40px; text-transform: none; font-weight: bold; border-radius: 8px;"
                                   Disabled="isSearchingTicket">
                            @if (isSearchingTicket)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>Buscando Ticket...</span>
                            }
                            else
                            {
                                <span>Buscar Ticket Externo / Local</span>
                            }
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>
            <MudPaper Class="border-solid border mud-border-secondary" Style="border-radius: 12px; overflow: hidden;">
                <MudDataGrid Items="@orders" Filterable="true" Dense="true" Elevation="0" Striped="true" Style="max-height: 400px; overflow-y: auto;">
                    <Columns>
                        <PropertyColumn Property="x => x.Series" Title="Serie" />
                        <PropertyColumn Property="x => x.Folio" Title="Folio" />
                        <TemplateColumn Title="Canal">
                            <CellTemplate>
                                @switch (context.Item.Channel)
                                {
                                    case OrderChannel.WhatsApp:
                                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Custom.Brands.WhatsApp">WhatsApp</MudChip>
                                        break;
                                    case OrderChannel.Store:
                                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.Storefront">Mostrador</MudChip>
                                        break;
                                    case OrderChannel.Web:
                                        <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.Language">Web</MudChip>
                                        break;
                                    case OrderChannel.MobileApp:
                                        <MudChip T="string" Color="Color.Tertiary" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.Smartphone">App</MudChip>
                                        break;
                                    default:
                                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.Phone">Teléfono</MudChip>
                                        break;
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.Date" Title="Fecha y Hora" Format="dd/MM/yyyy HH:mm" />
                        <PropertyColumn Property="x => x.ClientName" Title="Cliente" />
                        <PropertyColumn Property="x => x.PaymentMethod" Title="Método Pago" />
                        <PropertyColumn Property="x => x.TotalAmount" Title="Total Venta" Format="C2" CellStyle="font-weight: bold; color: var(--mud-palette-primary);" />
                        <TemplateColumn Title="Status" >
                            <CellTemplate>
                                 @switch (context.Item.Status)
                            {
                                case OrderStatus.Cancelled:
                                <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">Cancelado</MudChip>
                                break;
                                case OrderStatus.Confirmed:
                                <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled">Capturado</MudChip>
                                break;
                                case OrderStatus.Delivered:
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">Entregado</MudChip>
                                break;
                                case OrderStatus.EnRoute:
                                <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Filled">En ruta</MudChip>
                                break;
                                case OrderStatus.Pending:
                                <MudChip T="string" Color="Color.Tertiary" Size="Size.Small" Variant="Variant.Filled">Abierto</MudChip>
                                break;
                                case OrderStatus.Returned:
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">Devuelto</MudChip>
                                break;
                                case OrderStatus.Routed:
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">Enrutado</MudChip>
                                break;
                                default:
                                <MudChip T="string" Color="Color.Inherit" Size="Size.Small" Variant="Variant.Filled">Desconocido</MudChip>
                                break;
                            }
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Acciones" Style="width: 240px;">
                            <CellTemplate>
                                <div class="d-flex align-center gap-1">
                                    <MudTooltip Text="Ver Detalle Ticket">
                                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" Size="Size.Small" OnClick="@(() => ViewOrder(context.Item))" />
                                    </MudTooltip>
                                    @if ((context.Item.Status == OrderStatus.Pending || context.Item.Status == OrderStatus.Confirmed) && !context.Item.IsCancelled)
                                    {
                                        <MudTooltip Text="Cancelar Pedido">
                                            <MudIconButton Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" OnClick="@(() => CancelOrder(context.Item))" />
                                        </MudTooltip>
                                    }
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </MudDataGrid>
            </MudPaper>
        </div>
    </DialogContent>
</MudDialog>
@code
{
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    private bool isWaitingForConnection = false;
    private string searchSeries = string.Empty;
    private int? searchFolio;
    private CashRegisterDto? currentCashRegister;
    private DateTime? startDate = DateTime.Today;
    private DateTime? endDate = DateTime.Today.AddDays(1);
    private string filterStatus = "all";
    private List<OrderDto> orders = new();
    private bool isSearchingTicket = false;
    private async Task LoadData()
    {
        Guid? cashRegisterFilter = null;
        bool isOffline = ConnectionMonitor.IsLocalMode && !ConnectionMonitor.IsConnected;

        bool? isOpenParam = null;
        bool? isCancelledParam = null;
        bool? isConfirmedParam = null;
        bool? isEnRouteParam = null;
        bool? isDeliveredParam = null;
        bool? isNotDeliveredParam = null;
        if (filterStatus == "open")
        {
            isOpenParam = true;
            isCancelledParam = false;
        }
        else if (filterStatus == "cancelled")
        {
            isCancelledParam = true;
        }
        else if (filterStatus == "confirmed")
        {
            isConfirmedParam = true;
        }
        else if (filterStatus == "EnRoute")
        {
            isEnRouteParam = true;
        }
        else if (filterStatus == "delivered")
        {
            isDeliveredParam = true;
        }
        else if (filterStatus == "not-delivered")
        {
            isNotDeliveredParam = true;
        }

        if (isOffline)
        {
            if (currentCashRegister != null)
            {
                cashRegisterFilter = currentCashRegister.Id;
            }

            orders = await Mediator.Send(new ListOrdersQuery
            {
                StartDate = startDate,
                EndDate = endDate,
                IsOpen = isOpenParam,
                IsCancelled = isCancelledParam,
                IsConfirmed = isConfirmedParam,
                IsEnRoute = isEnRouteParam,
                IsDelivered = isDeliveredParam,
                IsNotDelivered = isNotDeliveredParam,
                CashRegisterId = cashRegisterFilter
            });
        }
        else
        {
            var serverUrl = await ConnectionMonitor.GetResolvedServerUrlAsync();
            if (!string.IsNullOrWhiteSpace(serverUrl))
            {
                try
                {
                    using var httpClient = new HttpClient { Timeout = TimeSpan.FromSeconds(10) };
                    var url = $"{serverUrl.TrimEnd('/')}/api/sync/orders";
                    
                    var queryParams = new List<string>();
                    if (startDate.HasValue) queryParams.Add($"startDate={Uri.EscapeDataString(startDate.Value.ToString("o"))}");
                    if (endDate.HasValue) queryParams.Add($"endDate={Uri.EscapeDataString(endDate.Value.ToString("o"))}");
                    if (isOpenParam.HasValue) queryParams.Add($"isPaid={isOpenParam.Value}");
                    if (isCancelledParam.HasValue) queryParams.Add($"isCancelled={isCancelledParam.Value}");
                    if (isConfirmedParam.HasValue) queryParams.Add($"isCancelled={isConfirmedParam.Value}");
                    if (isEnRouteParam.HasValue) queryParams.Add($"isCancelled={isEnRouteParam.Value}");
                    if (isDeliveredParam.HasValue) queryParams.Add($"isCancelled={isDeliveredParam.Value}");
                    if (isNotDeliveredParam.HasValue) queryParams.Add($"isCancelled={isNotDeliveredParam.Value}");
                    
                    if (queryParams.Any())
                    {
                        url += "?" + string.Join("&", queryParams);
                    }

                    var response = await httpClient.GetAsync(url);
                    if (response.IsSuccessStatusCode)
                    {
                        orders = await response.Content.ReadFromJsonAsync<List<OrderDto>>() ?? new();
                    }
                    else
                    {
                        Snackbar.Add($"Error al consultar el servidor central: {response.ReasonPhrase}", Severity.Warning);
                    }
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Error al conectar al servidor central: {ex.Message}. Cargando datos locales...", Severity.Warning);
                    orders = await Mediator.Send(new ListOrdersQuery
                    {
                        StartDate = startDate,
                        EndDate = endDate,
                        IsOpen = isOpenParam,
                        IsCancelled = isCancelledParam,
                        IsConfirmed = isConfirmedParam,
                        IsEnRoute = isEnRouteParam,
                        IsDelivered = isDeliveredParam,
                        IsNotDelivered = isNotDeliveredParam,
                        CashRegisterId = null
                    });
                }
            }
            else
            {
                orders = await Mediator.Send(new ListOrdersQuery
                {
                    StartDate = startDate,
                    EndDate = endDate,
                    IsOpen = isOpenParam,
                    IsCancelled = isCancelledParam,
                    IsConfirmed = isConfirmedParam,
                    IsEnRoute = isEnRouteParam,
                    IsDelivered = isDeliveredParam,
                    IsNotDelivered = isNotDeliveredParam,
                    CashRegisterId = null
                });
            }
        }
    }
    private async Task SearchByTicket()
    {
        if (string.IsNullOrWhiteSpace(searchSeries) || !searchFolio.HasValue)
        {
            Snackbar.Add("Debe ingresar la serie y el folio del ticket.", Severity.Warning);
            return;
        }

        bool isOffline = ConnectionMonitor.IsLocalMode && !ConnectionMonitor.IsConnected;

        if (isOffline)
        {
            bool? confirm = await DialogService.ShowMessageBox(
                "Sin Conexión al Servidor",
                "No hay conexión con el servidor central para validar tickets externos de otras cajas. ¿Deseas esperar a que regrese la conexión para validar automáticamente?",
                yesText: "Esperar Conexión",
                noText: "Cancelar"
            );

            if (confirm == true)
            {
                isWaitingForConnection = true;
                StateHasChanged();
            }
            return;
        }

        isSearchingTicket = true;
        StateHasChanged();

        try
        {
            var serverUrl = await ConnectionMonitor.GetResolvedServerUrlAsync();
            OrderDetailDto? orderDetail = null;

            if (!string.IsNullOrWhiteSpace(serverUrl))
            {
                using var httpClient = new HttpClient { Timeout = TimeSpan.FromSeconds(10) };
                var endpoint = $"{serverUrl.TrimEnd('/')}/api/sync/sales/by-ticket?series={Uri.EscapeDataString(searchSeries)}&folio={searchFolio.Value}";
                
                var response = await httpClient.GetAsync(endpoint);
                if (response.IsSuccessStatusCode)
                {
                    orderDetail = await response.Content.ReadFromJsonAsync<OrderDetailDto>();
                }
                else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
                {
                    Snackbar.Add("Ticket no encontrado en el Servidor Central.", Severity.Error);
                }
                else
                {
                    Snackbar.Add($"Error del servidor ({response.StatusCode}) al buscar el ticket.", Severity.Error);
                }
            }
            else
            {
                orderDetail = await Mediator.Send(new GetOrderByTicketQuery(searchSeries, searchFolio.Value));
            }

            if (orderDetail != null)
            {
                if (ConnectionMonitor.IsLocalMode)
                {
                    var importCommand = new ImportOrderCommand(orderDetail);
                    var importSuccess = await Mediator.Send(importCommand);
                    if (importSuccess)
                    {
                        Snackbar.Add($"Ticket #{searchSeries}-{searchFolio} importado localmente con éxito.", Severity.Success);
                    }
                }

                var mappedOrder = new OrderDto
                {
                    Id = orderDetail.Id,
                    OrderNumber = orderDetail.OrderNumber,
                    Date = orderDetail.Date,
                    TotalAmount = orderDetail.TotalAmount,
                    PaymentMethod = orderDetail.PaymentMethod,
                    ClientId = orderDetail.ClientId,
                    ClientName = orderDetail.ClientName,
                    IsCancelled = orderDetail.IsCancelled,
                    Status = orderDetail.Status,
                    ItemCount = orderDetail.Items.Count,
                    Series = orderDetail.Series,
                    Folio = orderDetail.Folio
                };

                orders = new List<OrderDto> { mappedOrder };
                Snackbar.Add($"Ticket encontrado: {mappedOrder.OrderNumber}", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al buscar ticket: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSearchingTicket = false;
            StateHasChanged();
        }
    }
    private async Task ViewOrder(OrderDto order)
    {
        var exists = await EnsureOrderExistsLocally(order.Id);
        if (exists)
        {
            MudDialog.Close(DialogResult.Ok(order));
        }
    }
    private async Task<bool> EnsureOrderExistsLocally(Guid orderId)
    {
        var localOrder = await Mediator.Send(new GetOrderQuery(orderId));
        if (localOrder != null)
        {
            return true;
        }

        bool isOffline = ConnectionMonitor.IsLocalMode && !ConnectionMonitor.IsConnected;
        if (isOffline)
        {
            Snackbar.Add("No se pudo cargar la información de la venta (Modo Offline).", Severity.Error);
            return false;
        }

        try
        {
            var serverUrl = await ConnectionMonitor.GetResolvedServerUrlAsync();
            if (!string.IsNullOrWhiteSpace(serverUrl))
            {
                using var httpClient = new HttpClient { Timeout = TimeSpan.FromSeconds(10) };
                var endpoint = $"{serverUrl.TrimEnd('/')}/api/sync/orders/{orderId}";
                var response = await httpClient.GetAsync(endpoint);
                if (response.IsSuccessStatusCode)
                {
                    var orderDetail = await response.Content.ReadFromJsonAsync<OrderDetailDto>();
                    if (orderDetail != null)
                    {
                        var importCommand = new ImportOrderCommand(orderDetail);
                        var importSuccess = await Mediator.Send(importCommand);
                        return importSuccess;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al importar el pedido desde el servidor: {ex.Message}", Severity.Error);
        }

        return false;
    }
    private async Task CancelOrder(OrderDto order)
    {
        var exists = await EnsureOrderExistsLocally(order.Id);
        if (!exists) return;

        var auth = await RequestAuthorizationAsync("Cancelar venta pedido", "order.cancel");
        if (!auth.Success) return;

        bool? result = await DialogService.ShowMessageBox(
            "Cancelar Pedido",
            $"¿Estás seguro que deseas cancelar el pedido {order.OrderNumber}?",
            yesText: "Cancelar Pedido", cancelText: "No");

        if (result == true)
        {
            var parameters = new DialogParameters { ["Title"] = "Razón de cancelación", ["Message"] = "Ingrese la razón de la cancelación:" };
            var dialog = await DialogService.ShowAsync<InputDialog>("Razón de cancelación", parameters);
            var dialogResult = await dialog.Result;
            if (dialogResult != null && !dialogResult.Canceled && dialogResult.Data is string reason && !string.IsNullOrWhiteSpace(reason))
            {
                try
                {
                    var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                    var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
                    await Mediator.Send(new CancelOrderCommand(order.Id, reason, userId, auth.Username, auth.Password));
                    Snackbar.Add("Pedido cancelado exitosamente", Severity.Success);
                    await LoadData();
                }
                catch (InvalidOperationException ex)
                {
                    Snackbar.Add(ex.Message, Severity.Error);
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Error: {ex.Message}", Severity.Error);
                }
            }
        }
    }
    private async Task<AuthorizationDialog.AuthorizationResult> RequestAuthorizationAsync(string actionName, string requiredPermissionCode)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true && (user.IsInRole("Admin") || user.IsInRole("Manager")))
        {
            return new AuthorizationDialog.AuthorizationResult(true, null, null);
        }

        var parameters = new DialogParameters { ["ActionName"] = actionName };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = false, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<AuthorizationDialog>("Autorización Requerida", parameters, options);
        var result = await dialog.Result;
        
        if (result != null && !result.Canceled && result.Data is AuthorizationDialog.AuthorizationResult authResult && authResult.Success)
        {
            return authResult;
        }

        return new AuthorizationDialog.AuthorizationResult(false, null, null);
    }
}