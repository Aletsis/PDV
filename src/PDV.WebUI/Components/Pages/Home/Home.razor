@page "/"
@namespace PDV.WebUI.Components.Pages
@using MediatR
@using Microsoft.AspNetCore.Components.Authorization
@using PDV.Application.Features.Shifts.Queries.GetActiveShiftByUserId
@using PDV.Domain.Enums
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject IMediator Mediator

<PageTitle>PDV — Inicio</PageTitle>

@code {
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        // Si el usuario ya tiene un turno abierto activo, consultar el modo de su caja y redirigir
        var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(userId))
        {
            var activeShift = await Mediator.Send(new GetActiveShiftByUserIdQuery(userId));
            if (activeShift != null)
            {
                if (activeShift.CashRegisterMode == CashRegisterMode.Orders)
                {
                    Navigation.NavigateTo("/orders/capture", replace: true);
                    return;
                }
                Navigation.NavigateTo("/pos", replace: true);
                return;
            }
        }

        if (user.IsInRole("Admin") || user.IsInRole("Manager"))
        {
            Navigation.NavigateTo("/dashboard", replace: true);
            return;
        }

        if (user.IsInRole("Cashier"))
        {
            Navigation.NavigateTo("/shift/open", replace: true);
            return;
        }

        if (user.IsInRole("Telephonist"))
        {
            Navigation.NavigateTo("/orders/capture", replace: true);
            return;
        }

        if (user.IsInRole("Picker"))
        {
            Navigation.NavigateTo("/orders/fulfillment", replace: true);
            return;
        }

        if (user.IsInRole("Verifier"))
        {
            Navigation.NavigateTo("/orders/verify", replace: true);
            return;
        }

        if (user.IsInRole("DeliveryMan"))
        {
            Navigation.NavigateTo("/orders/my-route", replace: true);
            return;
        }

        // Sin rol asignado → dashboard por defecto
        Navigation.NavigateTo("/dashboard", replace: true);
    }
}
