@using MediatR
@using PDV.Application.Features.InventoryDocuments.Dtos
@using PDV.Application.Features.InventoryDocuments.Queries.GetInventoryConceptMappings
@using PDV.Application.Features.InventoryDocuments.Commands.UpdateInventoryConceptMappings
@inject IMediator Mediator
@inject ISnackbar Snackbar

<MudDialog Class="premium-mappings-dialog" Style="max-width: 750px; width: 100%;">
    <TitleContent>
        <MudText Typo="Typo.h6" Class="d-flex align-center gap-2 font-weight-bold">
            <MudIcon Icon="@Icons.Material.Filled.SettingsSuggest" Color="Color.Primary" />
            Configuración de Conceptos CONTPAQi Comercial
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            Especifique el Código de Concepto correspondiente en CONTPAQi Comercial para cada subclasificación de movimiento de inventario.
        </MudText>

        @if (isLoading)
        {
            <div class="d-flex justify-center pa-6">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            </div>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true" Striped="true" Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default); border-radius: 8px;">
                <thead>
                    <tr>
                        <th>Subclasificación</th>
                        <th style="width: 180px;">Código Concepto CONTPAQi *</th>
                        <th>Nombre en CONTPAQi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in mappings)
                    {
                        <tr>
                            <td class="font-weight-bold">@item.SubtypeName</td>
                            <td>
                                <MudTextField @bind-Value="item.ConceptCode" 
                                              Variant="Variant.Outlined" 
                                              Margin="Margin.Dense" 
                                              Required="true"
                                              Class="premium-input" />
                            </td>
                            <td>
                                <MudTextField @bind-Value="item.ConceptName" 
                                              Variant="Variant.Outlined" 
                                              Margin="Margin.Dense" 
                                              Class="premium-input" />
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Outlined" Color="Color.Secondary">Cancelar</MudButton>
        <MudButton OnClick="Save" Variant="Variant.Filled" Color="Color.Primary" Disabled="isLoading || isSaving">
            @if (isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                <span>Guardando...</span>
            }
            else
            {
                <span>Guardar Configuración</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private List<InventoryConceptMappingDto> mappings = new();
    private bool isLoading = true;
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            mappings = await Mediator.Send(new GetInventoryConceptMappingsQuery());
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar mapeos: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        if (mappings.Any(m => string.IsNullOrWhiteSpace(m.ConceptCode)))
        {
            Snackbar.Add("Todos los conceptos deben tener un código asignado.", Severity.Warning);
            return;
        }

        isSaving = true;
        try
        {
            var success = await Mediator.Send(new UpdateInventoryConceptMappingsCommand(mappings));
            if (success)
            {
                Snackbar.Add("Mapeo de conceptos CONTPAQi actualizado con éxito.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("No se pudo actualizar el mapeo.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar mapeos: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }
}
