# =================================================================
# Variables de Entorno para Despliegue en Contenedor (PDV WebUI)
# =================================================================

# Modo de entorno de ASP.NET Core: Production | Development | Staging
ASPNETCORE_ENVIRONMENT=Production

# Modo de funcionamiento de la aplicación:
# - Server : Modo Servidor central (PostgreSQL)
# - Local  : Modo Terminal local / Caja (SQLite)
RunMode=Server

# Puerto expuesto en el host (por defecto 5000)
PORT=5000

# Cadena de conexión a la base de datos externa:
# - Servidor PostgreSQL externo: Host=192.168.1.50;Port=5432;Database=pdv_db;Username=pdv_user;Password=TuClaveSegura;
# - Base de datos local SQLite: Data Source=/app/Logs/pdv.db
DEFAULT_CONNECTION=Host=localhost;Port=5432;Database=pdv_db;Username=pdv_user;Password=TuContrasenaAltamenteSegura123!

# Aplicación automática de migraciones de Entity Framework al iniciar
APPLY_MIGRATIONS=true

# Abortar el inicio si existen migraciones pendientes sin aplicar (true / false)
REQUIRE_NO_PENDING_MIGRATIONS=false
