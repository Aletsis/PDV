                        @if (block.ManifestOrderFields == null || !block.ManifestOrderFields.Any())
                        {
                            block.ManifestOrderFields = new List<string> { "Folio", "Client", "Address", "Phone", "Total" };
                        }

                        @for (int fIdx = 0; fIdx < block.ManifestOrderFields.Count; fIdx++)
                        {
                            var index = fIdx;
