                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" OnClick="() => MoveManifestOrderFieldUp(block, index)" Disabled="@(index == 0)" />
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" OnClick="() => MoveManifestOrderFieldDown(block, index)" Disabled="@(index == block.ManifestOrderFields.Count - 1)" />
                                </div>
                            </div>
                        }

                        @if (block.ManifestOrderFields.Count < _availableManifestOrderFields.Count)
                        {
                            var missingFields = _availableManifestOrderFields.Keys.Where(k => !block.ManifestOrderFields.Contains(k)).ToList();
                            if (missingFields.Any())
                            {
                                <MudSelect T="string" Label="Añadir Campo de Pedido" Variant="Variant.Outlined" Dense="true" Class="mt-3" ValueChanged="@((val) => AddManifestOrderField(block, val))">
                                    <MudSelectItem Value='("")'>-- Selecciona --</MudSelectItem>
                                    @foreach (var mField in missingFields)
                                    {
                                        <MudSelectItem Value='mField'>@_availableManifestOrderFields[mField]</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                        }
                        break;

                    case "manifesttotals":
                        <MudText Typo="Typo.subtitle2" Class="mb-2 font-weight-bold">Variables de Totales de Manifiesto</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3 d-block">Selecciona qué variables mostrar y reordénalas:</MudText>

                        @if (block.ManifestTotalsFields == null || !block.ManifestTotalsFields.Any())
                        {
                            block.ManifestTotalsFields = new List<string> { "CashTotal", "OrderCount", "CardTotal", "CombinedTotal" };
                        }

                        @for (int fIdx = 0; fIdx < block.ManifestTotalsFields.Count; fIdx++)
                        {
                            var index = fIdx;
                            var field = block.ManifestTotalsFields[index];
                            string displayName = _availableManifestTotalsFields.TryGetValue(field, out var dName) ? dName : field;

                            <div class="d-flex align-center justify-between mb-2 pa-2" style="background: rgba(0,0,0,0.05); border-radius: 4px;">
                                <div class="d-flex align-center">
                                    <MudCheckBox T="bool" Value="true" ValueChanged="@((val) => ToggleManifestTotalsField(block, field, val))" Color="Color.Primary" Label="@displayName" Dense="true" />
                                </div>
                                <div class="d-flex align-center">
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" OnClick="() => MoveManifestTotalsFieldUp(block, index)" Disabled="@(index == 0)" />
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" OnClick="() => MoveManifestTotalsFieldDown(block, index)" Disabled="@(index == block.ManifestTotalsFields.Count - 1)" />
                                </div>
                            </div>
                        }

                        @if (block.ManifestTotalsFields.Count < _availableManifestTotalsFields.Count)
                        {
                            var missingFields = _availableManifestTotalsFields.Keys.Where(k => !block.ManifestTotalsFields.Contains(k)).ToList();
                            if (missingFields.Any())
                            {
                                <MudSelect T="string" Label="Añadir Variable de Totales" Variant="Variant.Outlined" Dense="true" Class="mt-3" ValueChanged="@((val) => AddManifestTotalsField(block, val))">
                                    <MudSelectItem Value='("")'>-- Selecciona --</MudSelectItem>
                                    @foreach (var mField in missingFields)
                                    {
                                        <MudSelectItem Value='mField'>@_availableManifestTotalsFields[mField]</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                        }
                        break;

                    case "barcodeorqr":
                        <MudSelect @bind-Value="block.CodeType" Label="Tipo de Código" Variant="Variant.Outlined" Class="mb-3">
                            <MudSelectItem Value='("QR")'>Código QR</MudSelectItem>
                            <MudSelectItem Value='("Barcode")'>Código de Barras</MudSelectItem>
                        </MudSelect>
                        <MudTextField @bind-Value="block.CodifiedValue" Label="Valor a Codificar" Variant="Variant.Outlined" Class="mb-3" HelperText="Usa placeholders como {Folio} o {Uuid}" />
                        <MudNumericField @bind-Value="block.ModuleSize" Label="Tamaño de Módulo" Variant="Variant.Outlined" Min="1" Max="10" />
                        break;
                }

                <div class="d-flex gap-2 mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowUpward" FullWidth="true" OnClick="() => MoveBlockUp(_selectedBlockIndex)" Disabled="@(_selectedBlockIndex == 0)">Subir Bloque</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowDownward" FullWidth="true" OnClick="() => MoveBlockDown(_selectedBlockIndex)" Disabled="@(_selectedBlockIndex == _templateJson.Blocks.Count - 1)">Bajar Bloque</MudButton>
                </div>
                <div class="mt-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" FullWidth="true" OnClick="() => DeleteBlock(_selectedBlockIndex)">Eliminar Bloque</MudButton>
                </div>

                <MudDivider Class="my-4" />

                <!-- Listado de Placeholders Disponibles de Forma Contextual -->
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2">Variables del Sistema</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3 d-block">Haz clic en una variable para insertarla o copiarla:</MudText>
                <div class="d-flex flex-wrap gap-1" style="max-height: 150px; overflow-y: auto;">
                    @foreach (var key in GetAvailableVariables())
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Dark" OnClick="() => InsertVariable(key)">@key</MudChip>
                    }
