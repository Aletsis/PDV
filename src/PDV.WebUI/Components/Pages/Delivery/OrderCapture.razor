@page "/orders/verify"
@page "/orders/capture"
@layout PDV.WebUI.Components.Layout.LoginLayout
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using MediatR
@using Microsoft.AspNetCore.Identity
@using PDV.Domain.Enums
@using PDV.Domain.Entities
@using PDV.Infrastructure.Identity
@using PDV.Application.Common.Helpers
@using PDV.Application.Features.Clients.Dtos
@using PDV.Application.Features.Clients.Queries.GetClient
@using PDV.Application.Features.CashRegisters.Dtos
@using PDV.Application.Features.CashRegisters.Queries.GetCashRegisterByIp
@using PDV.Application.Features.CashRegisters.Queries.GetCashRegister
@using PDV.Application.Features.CashRegisters.Queries.ListCashRegisters
@using PDV.Application.Features.Orders.Dtos
@using PDV.Application.Features.Orders.Commands.UpdateOrderItemPrice
@using PDV.Application.Features.Orders.Commands.ConfirmOrder
@using PDV.Application.Features.Orders.Commands.VerifyAndConfirmOrder
@using PDV.Application.Features.Orders.Commands.CancelOrder
@using PDV.Application.Features.Orders.Commands.PrintOrderTicket
@using PDV.Application.Features.Orders.Queries.GetNextFolio
@using PDV.Application.Features.Orders.Queries.GetOpenOrders
@using PDV.Application.Features.Orders.Queries.GetDraftOrder
@using PDV.Application.Features.Orders.Queries.GetOrders
@using PDV.Application.Features.DeliveryZones.Queries.GetDeliveryZones
@using PDV.Application.Features.Shifts.Dtos
@using PDV.Application.Features.Shifts.Queries.GetActiveShiftByUserId
@using PDV.Application.Features.Shifts.Queries.GetActiveShift
@using PDV.WebUI.Components.Pages.Auth
@using PDV.WebUI.Components.Pages.Sales
@inject PDV.WebUI.Services.ShiftSessionService ShiftSession
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IHttpContextAccessor HttpContextAccessor
@inject IMediator Mediator
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Verificación de Pedidos</PageTitle>

@if (!ShiftSession.HasActiveShift)
{
    <div class="d-flex flex-column align-center justify-center" style="min-height: 60vh;">
        <MudIcon Icon="@Icons.Material.Filled.Lock" Style="font-size: 4rem; color: var(--mud-palette-warning);" />
        <MudText Typo="Typo.h5" Class="mt-4 font-weight-bold">Sin turno activo</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">Debes abrir un turno de caja antes de registrar pedidos.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo("/shift/open"))">
            <MudIcon Icon="@Icons.Material.Filled.LockOpen" Class="mr-2" /> Abrir Turno
        </MudButton>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3" style="outline: none; height: 100vh; max-height: 100vh; overflow: hidden; padding: 12px; box-sizing: border-box;" tabindex="0" @onkeydown="HandleKeyDown">
        <!-- Sección 1: Datos del Ticket (Header) -->
        <OrdersHeader CurrentCashRegister="@currentCashRegister"
                       CurrentCashierName="@currentUserName"
                       ActiveSeries="@activeSeries"
                       ProjectedFolio="@projectedFolio"
                       SelectedClientName="@SelectedClientName"
                       SelectedClientId="@selectedClientId"
                       SuspendedOrders="@suspendedOrders"
                       OnCatalogClicked="OpenProductLookup"
                       OnClientSearchClicked="OpenClientSearchDialog"
                       OnOpenVerifyOrdersList="OpenVerifyOrdersList"
                       OnResumeOrder="ResumeOrder"
                       OnOpenSalesAction="OpenSalesAction"
                       OnOpenRuteAction="OpenRuteAction"
                       OnOpenRuteCut="OpenRuteCut"
                       OnOpenNotesHistory="OpenNotesHistory" />


        @if (isHistoricalView)
        {
            <MudPaper Class="pa-3 mb-2 mud-theme-info d-flex align-center justify-space-between" Style="background-color: var(--mud-palette-info-hover); border-radius: 8px;">
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">
                    <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" />
                    Editando Pedido Histórico: Estado @(activeOrderStatus?.ToString())
                </MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" OnClick="CloseHistoricalView" Style="text-transform: none;">
                    Cerrar y Volver a Captura
                </MudButton>
            </MudPaper>
        }

        <MudGrid Class="flex-grow-1" Style="min-height: 0; overflow: hidden; margin-top: 0px; margin-bottom: 0px;">
            <!-- Sección 2: Escáner y buscador de productos -->
            <MudItem xs="12" md="4" Class="d-flex flex-column" Style="height: 100%; overflow: hidden;">
                @if (isHistoricalView && activeOrderStatus != OrderStatus.Pending && activeOrderStatus != OrderStatus.Confirmed)
                {
                    <MudPaper Elevation="3" Class="pa-4 flex-grow-1 d-flex flex-column justify-center align-center text-center mud-text-secondary" Style="border-radius: 8px;">
                        <MudIcon Icon="@Icons.Material.Filled.EditOff" Size="Size.Large" Class="mb-2" />
                        <MudText Typo="Typo.subtitle1">El pedido no se puede editar en su estado actual (@activeOrderStatus)</MudText>
                    </MudPaper>
                }
                else
                {
                    <OrdersScanner @ref="scannerComponent"
                                   ActiveOrderId="@activeOrderId"
                                   SelectedClientId="@selectedClientId"
                                   SelectedClientType="@selectedClient?.ClientType"
                                   CashRegisterId="@ShiftSession.ActiveCashRegisterId"
                                   UserId="@currentUserId"
                                   OnOrderCreated="OnOrderCreated"
                                   OnCartUpdated="OnCartUpdated" />
                }
            </MudItem>

            <!-- Sección 3 y 4: Carrito y Totales -->
            <MudItem xs="12" md="8" Class="d-flex flex-column gap-3" Style="height: 100%; max-height: 100%; overflow: hidden;">
                <!-- Tarjeta Carrito -->
                <MudPaper Elevation="3" Class="pa-4 flex-grow-1 d-flex flex-column" Style="overflow: hidden; min-height: 0; display: flex; flex-direction: column; border-radius: 8px;">
                    <MudText Typo="Typo.h5" Class="font-weight-bold mb-3 d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Color="Color.Primary" />
                        Detalle del Pedido
                    </MudText>
                    
                    <div class="flex-grow-1" style="overflow-y: auto; min-height: 0;">
                        <OrdersCart IsReadOnly="@(isHistoricalView && activeOrderStatus != OrderStatus.Pending && activeOrderStatus != OrderStatus.Confirmed)"
                                    ActiveOrderId="@activeOrderId"
                                    Items="@cart"
                                    OnCartUpdated="OnCartUpdated" />
                    </div>
                </MudPaper>

                <!-- Tarjeta Totales -->
                <MudPaper Elevation="3" Class="pa-4 flex-shrink-0" Style="border-radius: 8px;">
                    <OrdersTotals ActiveOrderId="@activeOrderId"
                                  ActiveOrderStatus="@activeOrderStatus"
                                  Subtotal="@subtotal"
                                  TotalTax="@totalTax"
                                  DeliveryCost="@deliveryCost"
                                  TotalAmount="@totalAmount"
                                  HasItems="@cart.Any()"
                                  IsHistoricalView="@isHistoricalView"
                                  OnRegisterClicked="SubmitOrder"
                                  OnCancelClicked="CancelActiveOrder"
                                  OnNewOrderClicked="ClearScreen"
                                  OnCloseViewClicked="CloseHistoricalView"
                                  OnReprintClicked="ReprintTicket" />
                </MudPaper>
            </MudItem>
        </MudGrid>
    </div>
}

@code
{
    private string? redirectPath = null;
    private string currentUserId = "Anonymous";
    private string currentUserName = "Empleado General";
    private bool _initComplete = false;

    private CashRegisterDto? currentCashRegister;
    private ShiftDto? currentShift;
    private string activeSeries = "PED";
    private int projectedFolio = 1;
    private Guid? activeOrderId;
    private List<OpenOrderDto> suspendedOrders = new();
    private readonly System.Threading.SemaphoreSlim _persistSemaphore = new(1, 1);
    private List<CartItemDto> cart = new();
    private Guid? selectedClientId = null;
    private ClientDto? selectedClient;
    private decimal subtotal = 0;
    private decimal totalAmount = 0;
    private decimal totalTax = 0;
    private decimal deliveryCost = 0m;
    private List<DeliveryZone> zones = new();
    private bool isHistoricalView = false;
    private OrderStatus? activeOrderStatus;
    private OrdersScanner scannerComponent = null!;
    private string SelectedClientName => selectedClient?.Name ?? "Público General (Menudeo)";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user == null || user.Identity?.IsAuthenticated != true)
        {
            redirectPath = $"/login?returnUrl={System.Uri.EscapeDataString(Navigation.Uri)}";
            return;
        }
        currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "Anonymous";
        var appUser = await UserManager.FindByIdAsync(currentUserId);
        currentUserName = appUser?.FullName ?? user.Identity?.Name ?? "Empleado General";

        var httpContext = HttpContextAccessor.HttpContext;
        var rawIp = httpContext?.Connection.RemoteIpAddress?.MapToIPv4().ToString();
        var clientIp = IpAddressHelper.ResolveClientIp(rawIp);

        // Jerarquía de selección de caja:
        // 1) Vinculación por IP física de la terminal (Máxima prioridad)
        if (!string.IsNullOrEmpty(clientIp))
        {
            currentCashRegister = await Mediator.Send(new GetCashRegisterByIpQuery(clientIp));
        }

        // 2) Si no hay caja fija por IP, verificar si el usuario ya tiene un turno activo
        if (currentCashRegister == null)
        {
            var userActiveShift = await Mediator.Send(new GetActiveShiftByUserIdQuery(currentUserId));
            if (userActiveShift != null)
            {
                currentCashRegister = await Mediator.Send(new GetCashRegisterQuery(userActiveShift.CashRegisterId));
            }
        }

        // 3) Asignación directa por usuario
        if (currentCashRegister == null)
        {
            var registers = await Mediator.Send(new ListCashRegistersQuery());
            currentCashRegister = registers.FirstOrDefault(r => r.AssignedUserId == currentUserId);
        }

        // 4) Fallback: Cookie de terminal
        if (currentCashRegister == null)
        {
            if (httpContext != null && httpContext.Request.Cookies.TryGetValue("pos_cash_register_id", out var idStr) && Guid.TryParse(idStr, out var id))
            {
                var candidate = await Mediator.Send(new GetCashRegisterQuery(id));
                if (candidate != null && (string.IsNullOrEmpty(candidate.IpAddress) || candidate.IpAddress == clientIp))
                {
                    currentCashRegister = candidate;
                }
            }
        }

        if (currentCashRegister == null)
        {
            redirectPath = "/?error=NotACashRegisterTerminal";
            return;
        }

        currentShift = await Mediator.Send(new GetActiveShiftByCashRegisterQuery(currentCashRegister.Id));
        if (currentShift == null || currentShift.UserId != currentUserId)
        {
            ShiftSession.Clear();
            redirectPath = $"/open-shift?cashRegisterId={currentCashRegister.Id}";
            return;
        }

        if (!ShiftSession.HasActiveShift || ShiftSession.ActiveShiftId != currentShift.Id)
        {
            ShiftSession.SetActive(
                currentShift.Id,
                currentShift.CashRegisterId,
                currentShift.CashRegisterName,
                currentShift.InitialCash,
                currentShift.StartTime,
                currentShift.BranchId ?? currentCashRegister.BranchId);
        }


        // Cargar zonas de reparto
        zones = await Mediator.Send(new GetDeliveryZonesQuery
        {
            BranchId = currentCashRegister.BranchId,
            OnlyActive = true
        });
        // LoadFolioProjection y RefreshSuspendedOrders se ejecutan en OnAfterRenderAsync
        // para evitar concurrencia del DbContext con el circuito Blazor Server
        _initComplete = true;
    }



    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _initComplete)
        {
            if (!string.IsNullOrEmpty(redirectPath))
            {
                Navigation.NavigateTo(redirectPath, forceLoad: redirectPath.Contains("/login"));
                return;
            }

            await LoadFolioProjection();
            await SyncTerminalCookiesAndLocalStorage();
            await LoadPersistedCarts();
        }
    }

    private async Task SyncTerminalCookiesAndLocalStorage()
    {
        try
        {
            if (currentCashRegister != null)
            {
                var regId = currentCashRegister.Id.ToString();
                var localIdStr = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "pos_cash_register_id");
                string? cookieIdStr = null;
                var httpContext = HttpContextAccessor.HttpContext;
                if (httpContext != null && httpContext.Request.Cookies.TryGetValue("pos_cash_register_id", out var idStr))
                {
                    cookieIdStr = idStr;
                }

                if (localIdStr != regId)
                {
                    await JSRuntime.InvokeVoidAsync("localStorage.setItem", "pos_cash_register_id", regId);
                }
                if (cookieIdStr != regId)
                {
                    await JSRuntime.InvokeVoidAsync("eval", $"document.cookie = 'pos_cash_register_id={regId}; path=/; max-age=2592000; Secure; SameSite=Lax'");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error syncing terminal storage: {ex.Message}");
        }
    }

    private async Task LoadPersistedCarts()
    {
        await _persistSemaphore.WaitAsync();
        try
        {
            var activeOrderIdStr = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "pos_active_order_id");
            if (Guid.TryParse(activeOrderIdStr, out var orderId))
            {
                activeOrderId = orderId;
                await RefreshActiveOrderFromDb();
            }
            await RefreshSuspendedOrders();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar desde base de datos: {ex.Message}");
        }
        finally
        {
            _persistSemaphore.Release();
        }
    }

    private async Task RefreshActiveOrderFromDb()
    {
        if (activeOrderId.HasValue)
        {
            var draft = await Mediator.Send(new GetDraftOrderQuery(activeOrderId.Value));
            if (draft != null)
            {
                cart = draft.Items;
                selectedClientId = draft.ClientId;
                if (selectedClientId.HasValue)
                {
                    selectedClient = await Mediator.Send(new GetClientQuery(selectedClientId.Value));
                }
                else
                {
                    selectedClient = null;
                }

                UpdateDeliveryCost();

                // Recalcular subtotales, IVA e importes a partir de la fotografía de base de datos
                subtotal = cart.Sum(i => i.Total);

                // Para obtener impuestos exactos, sumamos el desglose correspondiente
                totalTax = cart.Sum(i => {
                    decimal taxRate = 0m;
                    switch (i.Product.TaxRate)
                    {
                        case TaxRateType.Rate16: taxRate = 0.16m; break;
                        case TaxRateType.Rate8: taxRate = 0.08m; break;
                    }
                    decimal price = i.PriceOverride ?? i.Product.Price;
                    decimal qty = i.Product.SaleType == SaleType.Bulk ? i.Weight : i.Quantity;
                    return i.Product.TaxRate == TaxRateType.Exempt ? 0m : (price * qty) * taxRate;
                });

                subtotal = subtotal - totalTax;
                totalAmount = subtotal + totalTax + deliveryCost;

                // Buscar el estado real de la orden activa
                var orderDetails = await Mediator.Send(new GetOrderQuery(activeOrderId.Value));
                if (orderDetails != null)
                {
                    activeOrderStatus = orderDetails.Status;
                }
            }
            else
            {
                await ClearScreen();
            }
        }
        else
        {
            cart.Clear();
            selectedClientId = null;
            selectedClient = null;
            subtotal = 0;
            totalTax = 0;
            totalAmount = 0;
            deliveryCost = 0;
        }
    }

    private void UpdateDeliveryCost()
    {
        if (selectedClient != null && selectedClient.DeliveryZoneId.HasValue)
        {
            var zone = zones.FirstOrDefault(z => z.Id == selectedClient.DeliveryZoneId.Value);
            deliveryCost = zone?.DeliveryCost ?? 0m;
        }
        else
        {
            deliveryCost = 0m;
        }
    }

    private async Task LoadFolioProjection()
    {
        if (currentCashRegister != null)
        {
            var (series, nextFolio) = await Mediator.Send(new GetNextFolioQuery(currentCashRegister.BranchId));
            activeSeries = series;
            projectedFolio = nextFolio;
        }
    }

    private async Task RefreshSuspendedOrders()
    {
        if (currentShift != null)
        {
            var allOpen = await Mediator.Send(new GetOpenOrdersQuery(currentShift.Id));
            if (activeOrderId.HasValue)
            {
                suspendedOrders = allOpen.Where(o => o.OrderId != activeOrderId.Value).ToList();
            }
            else
            {
                suspendedOrders = allOpen;
            }
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "F3")
        {
            await OpenProductLookup();
        }
        else if (e.Key == "F4")
        {
            await OpenClientSearchDialog();
        }
        else if (e.Key == "F7")
        {
            await OpenVerifyOrdersList();
        }
        else if (e.Key == "F8")
        {
            await SubmitOrder();
        }
        else if (e.Key == "F9")
        {
            if (scannerComponent != null)
            {
                await scannerComponent.TriggerScaleRead();
            }
        }
    }

    private async Task OpenProductLookup()
    {
        var parameters = new DialogParameters<ProductLookupDialog>();
        if (currentCashRegister != null)
        {
            parameters.Add(x => x.BranchId, currentCashRegister.BranchId);
        }
        var dialog = await DialogService.ShowAsync<ProductLookupDialog>("Buscar Producto", parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is ProductLookupDialog.ProductLookupResult lookupResult)
        {
            var product = lookupResult.Product;
            var qty = lookupResult.QuantityOrWeight;

            if (scannerComponent != null)
            {
                await scannerComponent.AddProductDirectly(product, qty);
            }
        }
    }

    private async Task OpenClientSearchDialog()
    {
        var parameters = new DialogParameters();
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ClientSearchDialog>("Buscar Cliente", parameters, options);
        var result = await dialog.Result;
        
        if (result != null && !result.Canceled)
        {
            var client = result.Data as ClientDto;
            await HandleClientSelection(client?.Id);
        }
    }

    private async Task HandleClientSelection(Guid? clientId)
    {
        selectedClientId = clientId;
        
        if (!clientId.HasValue)
        {
            selectedClient = null;
            foreach (var item in cart)
            {
                item.PriceOverride = null;
            }
            Snackbar.Add("Precios restablecidos a Menudeo (Público General)", Severity.Info);
        }
        else
        {
            selectedClient = await Mediator.Send(new GetClientQuery(clientId.Value));
            var client = selectedClient;
            if (client != null)
            {
                if (client.ClientType == ClientType.Wholesale)
                {
                    int modifiedCount = 0;
                    foreach (var item in cart)
                    {
                        if (item.Product.WholesalePrice.HasValue)
                        {
                            item.PriceOverride = item.Product.WholesalePrice.Value;
                            modifiedCount++;
                        }
                    }
                    Snackbar.Add($"Precios de Mayoreo aplicados a {modifiedCount} artículos ({client.Name})", Severity.Success);
                }
                else
                {
                    foreach (var item in cart)
                    {
                        item.PriceOverride = null;
                    }
                    Snackbar.Add($"Precios de Menudeo aplicados ({client.Name})", Severity.Info);
                }
            }
        }

        UpdateDeliveryCost();

        // Persistir overrides granulares en la BD SQLite
        if (activeOrderId.HasValue)
        {
            await _persistSemaphore.WaitAsync();
            try
            {
                foreach (var item in cart)
                {
                    var command = new UpdateOrderItemPriceCommand(activeOrderId.Value, item.SaleItemId, item.PriceOverride);
                    await Mediator.Send(command);

                }
                await RefreshActiveOrderFromDb();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error al actualizar precios en base de datos: {ex.Message}", Severity.Error);
            }
            finally
            {
                _persistSemaphore.Release();
            }
        }
        
        StateHasChanged();
    }

    private async Task ResumeOrder(OpenOrderDto saleDto)
    {
        await _persistSemaphore.WaitAsync();
        try
        {
            activeOrderId = saleDto.OrderId;
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "pos_active_order_id", activeOrderId.Value.ToString());

            await RefreshActiveOrderFromDb();
            Snackbar.Add($"Nota #{saleDto.Series}-{saleDto.Folio} restaurada", Severity.Success);
            await RefreshSuspendedOrders();
        }
        finally
        {
            _persistSemaphore.Release();
        }
        StateHasChanged();
    }

    private void OpenSalesAction()
    {
        Navigation.NavigateTo("/pos");
    }

    private void OpenRuteAction()
    {
        Navigation.NavigateTo("/orders/routes");
    }

    private void OpenRuteCut()
    {
        Navigation.NavigateTo("/orders/settlement");
    }

    private async Task OpenVerifyOrdersList()
    {
        if (currentCashRegister == null) return;

        var parameters = new DialogParameters<VerifyOrdersListDialog>
        {
            { x => x.BranchId, currentCashRegister.BranchId }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<VerifyOrdersListDialog>("Pedidos para Verificación", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is OrderDetailDto orderDetail)
        {
            await LoadHistoricalOrder(orderDetail.Id);
        }
        else
        {
            await RefreshSuspendedOrders();
            await RefreshActiveOrderFromDb();
        }
        StateHasChanged();
    }

    private async Task OpenNotesHistory()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<OrdersListDialog>("Historial de Pedidos y Cancelaciones", options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is OrderDto selectedSale)
        {
            await LoadHistoricalOrder(selectedSale.Id);
        }
        else
        {
            await RefreshSuspendedOrders();
            await RefreshActiveOrderFromDb();
        }
        StateHasChanged();
    }

    private async Task LoadHistoricalOrder(Guid orderId)
    {
        await _persistSemaphore.WaitAsync();
        try
        {
            activeOrderId = orderId;
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "pos_active_order_id", activeOrderId.Value.ToString());

            await RefreshActiveOrderFromDb();

            var orderDetails = await Mediator.Send(new GetOrderQuery(orderId));
            if (orderDetails != null)
            {
                activeOrderStatus = orderDetails.Status;
                isHistoricalView = true;
                Snackbar.Add($"Pedido #{orderDetails.Series}-{orderDetails.Folio} cargado para verificación y ajuste", Severity.Success);
            }
            
            await RefreshSuspendedOrders();
        }
        finally
        {
            _persistSemaphore.Release();
        }
        StateHasChanged();
    }

    private async Task CloseHistoricalView()
    {
        await ClearScreen();
    }

    private async Task ClearScreen()
    {
        activeOrderId = null;
        activeOrderStatus = null;
        isHistoricalView = false;
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "pos_active_order_id");
        cart.Clear();
        selectedClientId = null;
        selectedClient = null;
        subtotal = 0;
        totalTax = 0;
        totalAmount = 0;
        deliveryCost = 0;
        await LoadFolioProjection();
        await RefreshSuspendedOrders();
        StateHasChanged();
    }

    private async Task SubmitOrder()
    {
        if (cart.Count == 0 || !activeOrderId.HasValue)
        {
            Snackbar.Add("No hay artículos en el pedido", Severity.Warning);
            return;
        }

        try
        {
            if (activeOrderId.HasValue && ShiftSession.ActiveShiftId.HasValue && ShiftSession.ActiveCashRegisterId.HasValue)
            {
                var verifyCommand = new VerifyAndConfirmOrderCommand
                {
                    OrderId = activeOrderId.Value,
                    UserId = currentUserId,
                    CashRegisterId = ShiftSession.ActiveCashRegisterId.Value,
                    ShiftId = ShiftSession.ActiveShiftId.Value,
                    DeliveryZoneId = selectedClient?.DeliveryZoneId,
                    UpdatedItems = cart.Select(i => new VerifyOrderItemDto
                    {
                        ItemId = i.SaleItemId,
                        RealQuantity = i.QuantityDisplay,
                        PriceOverride = i.PriceOverride
                    }).ToList()
                };

                var success = await Mediator.Send(verifyCommand);
                if (success)
                {
                    Snackbar.Add("¡Pedido verificado, confirmado y enrutado con éxito!", Severity.Success);
                    
                    if (currentCashRegister != null)
                    {
                        await Mediator.Send(new PrintOrderTicketCommand(activeOrderId.Value, currentCashRegister.Id));
                    }

                    await ClearScreen();
                }
            }
            else
            {
                var success = await Mediator.Send(new ConfirmOrderCommand(activeOrderId.Value));
                if (success)
                {
                    Snackbar.Add("Pedido registrado con éxito", Severity.Success);
                    
                    if (currentCashRegister != null)
                    {
                        await Mediator.Send(new PrintOrderTicketCommand(activeOrderId.Value, currentCashRegister.Id));
                    }

                    await ClearScreen();
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al registrar pedido: {ex.Message}", Severity.Error);
        }
    }

    private async Task CancelActiveOrder()
    {
        if (!activeOrderId.HasValue) return;

        var auth = await RequestAuthorizationAsync("Cancelar Pedido completo", "orders.cancel");
        if (!auth.Success) return;

        try
        {
            var command = new CancelOrderCommand(activeOrderId.Value, "Cancelado desde Captura de Pedidos", currentUserId, auth.Username, auth.Password);
            var success = await Mediator.Send(command);
            if (success)
            {
                Snackbar.Add("Pedido cancelado con éxito", Severity.Success);
                await ClearScreen();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cancelar pedido: {ex.Message}", Severity.Error);
        }
    }

    private async Task ReprintTicket()
    {
        if (activeOrderId.HasValue && currentCashRegister != null)
        {
            try
            {
                await Mediator.Send(new PrintOrderTicketCommand(activeOrderId.Value, currentCashRegister.Id));
                Snackbar.Add("Ticket de pedido enviado a impresión", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error al imprimir: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task OnOrderCreated(Guid newOrderId)
    {
        await _persistSemaphore.WaitAsync();
        try
        {
            activeOrderId = newOrderId;
            activeOrderStatus = OrderStatus.Pending;
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "pos_active_order_id", activeOrderId.Value.ToString());

            await RefreshActiveOrderFromDb();
            await RefreshSuspendedOrders();
        }
        finally
        {
            _persistSemaphore.Release();
        }
        StateHasChanged();
    }

    private async Task OnCartUpdated()
    {
        await RefreshActiveOrderFromDb();
        await RefreshSuspendedOrders();
        StateHasChanged();
    }


    private async Task<AuthorizationDialog.AuthorizationResult> RequestAuthorizationAsync(string actionName, string requiredPermissionCode)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true && (user.IsInRole("Admin") || user.IsInRole("Manager")))
        {
            return new AuthorizationDialog.AuthorizationResult(true, null, null);
        }

        var parameters = new DialogParameters { ["ActionName"] = actionName };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = false, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<AuthorizationDialog>("Autorización Requerida", parameters, options);
        var result = await dialog.Result;
        
        if (result != null && !result.Canceled && result.Data is AuthorizationDialog.AuthorizationResult authResult && authResult.Success)
        {
            return authResult;
        }

        return new AuthorizationDialog.AuthorizationResult(false, null, null);
    }
}