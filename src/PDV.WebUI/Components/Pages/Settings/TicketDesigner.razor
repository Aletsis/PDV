                                <div class="d-flex align-center">
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" OnClick="() => MoveTotalsFieldUp(block, index)" Disabled="@(index == 0)" />
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" OnClick="() => MoveTotalsFieldDown(block, index)" Disabled="@(index == block.TotalsFields.Count - 1)" />
                                </div>
                            </div>
                        }

                        @if (block.TotalsFields.Count < _availableTotals.Count)
                        {
