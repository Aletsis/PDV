@using MediatR
@using PDV.Application.Features.SystemConfiguration.Commands.UpdateInvoiceSettings
@using PDV.Application.Features.SystemConfiguration.Dtos
@using System.IO
@inject IMediator Mediator
@inject ISnackbar Snackbar

<div class="settings-card">
    <div class="settings-section-title">
        <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" />
        Configuración de Facturación CFDI 4.0
    </div>
    
    <MudText Typo="Typo.body2" Class="mb-6" Style="color: rgba(255,255,255,0.5);">
        Carga tus archivos de Certificado de Sello Digital (CSD) emitidos por el SAT y configura el PAC para firmar y timbrar comprobantes directamente desde el sistema.
    </MudText>

    <MudGrid>
        <!-- ── Estado del CSD ── -->
        <MudItem xs="12">
            <div style="background: rgba(255,255,255,0.02); padding: 18px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05); margin-bottom: 8px;">
                <MudText Typo="Typo.subtitle2" Class="mb-3" Style="font-weight: 600; color: #64b5f6;">Estado del Certificado</MudText>
                
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
                    @if (Configuration.HasCsdCertificate && Configuration.HasCsdPrivateKey && IsCsdDateValid)
                    {
                        <MudChip T="string" Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Variant="Variant.Outlined" Style="border-radius: 8px;">
                            CSD Activo y Válido
                        </MudChip>
                        <MudText Typo="Typo.body2" Style="color: rgba(105, 240, 174, 0.8);">
                            Listo para facturar. Serie: <strong>@Configuration.CsdSerialNumber</strong> | Vence el: <strong>@Configuration.CsdExpiresAt?.ToString("g")</strong>
                        </MudText>
                    }
                    else
                    {
                        <MudChip T="string" Icon="@Icons.Material.Filled.Error" Color="Color.Warning" Variant="Variant.Outlined" Style="border-radius: 8px;">
                            CSD Pendiente o Inactivo
                        </MudChip>
                        <MudText Typo="Typo.body2" Style="color: rgba(255, 183, 77, 0.8);">
                            Carga los archivos de certificado (.cer), llave privada (.key) y contraseña para habilitar el timbrado local de facturas.
                        </MudText>
                    }
                </MudStack>
            </div>
        </MudItem>

        <!-- ── Archivos del CSD ── -->
        <MudItem xs="12" md="6">
            <div class="logo-upload-container" style="min-height: 140px; display:flex; flex-direction:column; justify-content:center; align-items:center;">
                <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight:600;">Certificado CSD (.cer)</MudText>
                
                <MudFileUpload T="IBrowserFile" Accept=".cer" OnFilesChanged="OnCertChanged">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.CloudUpload" Size="Size.Small">
                            @(_certFile == null ? "Seleccionar .cer" : "Cambiar .cer")
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>

                @if (_certFile != null)
                {
                    <MudText Typo="Typo.caption" Class="mt-2" Color="Color.Success">
                        Archivo seleccionado: @_certFile.Name
                    </MudText>
                }
                else if (Configuration.HasCsdCertificate)
                {
                    <MudText Typo="Typo.caption" Class="mt-2" Style="color: rgba(255,255,255,0.4);">
                        Certificado previamente cargado en base de datos.
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mt-2" Style="color: rgba(255,255,255,0.2);">
                        No se ha cargado archivo.
                    </MudText>
                }
            </div>
        </MudItem>

        <MudItem xs="12" md="6">
            <div class="logo-upload-container" style="min-height: 140px; display:flex; flex-direction:column; justify-content:center; align-items:center;">
                <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight:600;">Llave Privada (.key)</MudText>
                
                <MudFileUpload T="IBrowserFile" Accept=".key" OnFilesChanged="OnKeyChanged">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.CloudUpload" Size="Size.Small">
                            @(_keyFile == null ? "Seleccionar .key" : "Cambiar .key")
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>

                @if (_keyFile != null)
                {
                    <MudText Typo="Typo.caption" Class="mt-2" Color="Color.Success">
                        Archivo seleccionado: @_keyFile.Name
                    </MudText>
                }
                else if (Configuration.HasCsdPrivateKey)
                {
                    <MudText Typo="Typo.caption" Class="mt-2" Style="color: rgba(255,255,255,0.4);">
                        Llave privada previamente cargada en base de datos.
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mt-2" Style="color: rgba(255,255,255,0.2);">
                        No se ha cargado archivo.
                    </MudText>
                }
            </div>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="_csdPassword" 
                          Label="Contraseña de la Llave Privada" 
                          Variant="Variant.Outlined" 
                          InputType="InputType.Password" 
                          Required="true"
                          Adornment="Adornment.Start" 
                          AdornmentIcon="@Icons.Material.Filled.Password" />
        </MudItem>

        <MudItem xs="12">
            <MudDivider Class="my-4" />
        </MudItem>

        <!-- ── PAC Settings ── -->
        <MudItem xs="12">
            <div class="settings-section-title" style="color: #ffb74d;">
                <MudIcon Icon="@Icons.Material.Filled.CloudSync" />
                Configuración del PAC (Timbrado de Invoices)
            </div>
        </MudItem>

        <MudItem xs="12" md="8">
            <MudTextField @bind-Value="_pacUrl" 
                          Label="URL del Webservice del PAC" 
                          Variant="Variant.Outlined" 
                          Required="true"
                          HelperText="Dirección de la API del PAC para enviar el timbrado"
                          Adornment="Adornment.Start" 
                          AdornmentIcon="@Icons.Material.Filled.Language" />
        </MudItem>

        <MudItem xs="12" md="4">
            <MudTextField @bind-Value="_pacApiUser" 
                          Label="Usuario de API PAC" 
                          Variant="Variant.Outlined" 
                          Required="true"
                          HelperText="Identificador de cuenta con el PAC"
                          Adornment="Adornment.Start" 
                          AdornmentIcon="@Icons.Material.Filled.AccountCircle" />
        </MudItem>

        <MudItem xs="12" md="6">
            <MudTextField @bind-Value="_pacApiKey" 
                          Label="API Key / Contraseña PAC" 
                          Variant="Variant.Outlined" 
                          InputType="InputType.Password" 
                          HelperText="Clave secreta asociada al usuario del PAC"
                          Adornment="Adornment.Start" 
                          AdornmentIcon="@Icons.Material.Filled.VpnKey" />
        </MudItem>

        <!-- ── Acciones de Guardar ── -->
        <MudItem xs="12" Class="d-flex justify-end mt-4">
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.Save" 
                       OnClick="SaveInvoiceSettings" 
                       Disabled="_isSaving" 
                       Style="border-radius: 8px; text-transform:none; font-weight:600; height: 44px; width: 220px;">
                @(_isSaving ? "Guardando..." : "Guardar Datos Fiscales")
            </MudButton>
        </MudItem>
    </MudGrid>
</div>

@code {
    [Parameter] public SystemConfigurationDto Configuration { get; set; } = null!;
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool _isSaving = false;

    // Form inputs
    private string _pacUrl = string.Empty;
    private string _pacApiUser = string.Empty;
    private string _pacApiKey = string.Empty;
    private string _csdPassword = string.Empty;

    // Files state
    private IBrowserFile? _certFile;
    private IBrowserFile? _keyFile;
    private byte[]? _certBytes;
    private byte[]? _keyBytes;

    private bool IsCsdDateValid => Configuration.CsdExpiresAt.HasValue && Configuration.CsdExpiresAt.Value > DateTime.UtcNow;

    protected override void OnInitialized()
    {
        if (Configuration != null)
        {
            _pacUrl = Configuration.PacUrl ?? "https://mock-pac.sat.gob.mx";
            _pacApiUser = Configuration.PacApiUser ?? "MOCK_USER";
            _pacApiKey = Configuration.PacApiKey ?? "";
            _csdPassword = Configuration.CsdPassword ?? "";
        }
    }

    private async Task OnCertChanged(InputFileChangeEventArgs e)
    {
        _certFile = e.File;
        if (_certFile == null) return;

        if (_certFile.Size > 1024 * 1024)
        {
            Snackbar.Add("El archivo del certificado supera el límite de 1MB.", Severity.Error);
            _certFile = null;
            return;
        }

        try
        {
            using var stream = _certFile.OpenReadStream(maxAllowedSize: 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _certBytes = ms.ToArray();
            Snackbar.Add("Certificado cargado en memoria.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al leer certificado: {ex.Message}", Severity.Error);
            _certFile = null;
        }
    }

    private async Task OnKeyChanged(InputFileChangeEventArgs e)
    {
        _keyFile = e.File;
        if (_keyFile == null) return;

        if (_keyFile.Size > 1024 * 1024)
        {
            Snackbar.Add("El archivo de la llave privada supera el límite de 1MB.", Severity.Error);
            _keyFile = null;
            return;
        }

        try
        {
            using var stream = _keyFile.OpenReadStream(maxAllowedSize: 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _keyBytes = ms.ToArray();
            Snackbar.Add("Llave privada cargada en memoria.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al leer la llave privada: {ex.Message}", Severity.Error);
            _keyFile = null;
        }
    }

    private async Task SaveInvoiceSettings()
    {
        if (string.IsNullOrWhiteSpace(_pacUrl))
        {
            Snackbar.Add("La URL del PAC es requerida.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_pacApiUser))
        {
            Snackbar.Add("El usuario de API del PAC es requerido.", Severity.Warning);
            return;
        }

        if (_certBytes == null && !Configuration.HasCsdCertificate)
        {
            Snackbar.Add("Debes cargar el archivo del certificado CSD (.cer).", Severity.Warning);
            return;
        }

        if (_keyBytes == null && !Configuration.HasCsdPrivateKey)
        {
            Snackbar.Add("Debes cargar el archivo de la llave privada (.key).", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_csdPassword))
        {
            Snackbar.Add("La contraseña de la llave privada es requerida para el firmado local.", Severity.Warning);
            return;
        }

        _isSaving = true;
        try
        {
            var command = new UpdateInvoiceSettingsCommand(
                PacUrl: _pacUrl,
                PacApiUser: _pacApiUser,
                PacApiKey: string.IsNullOrEmpty(_pacApiKey) ? null : _pacApiKey,
                CsdCertificateData: _certBytes,
                CsdPrivateKeyData: _keyBytes,
                CsdPassword: _csdPassword
            );

            await Mediator.Send(command);
            
            Snackbar.Add("Configuración de facturación guardada exitosamente.", Severity.Success);
            _certFile = null;
            _keyFile = null;
            _certBytes = null;
            _keyBytes = null;

            if (OnSaved.HasDelegate)
            {
                await OnSaved.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar configuración fiscal: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
