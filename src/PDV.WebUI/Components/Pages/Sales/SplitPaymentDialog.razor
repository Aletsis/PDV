@using MudBlazor
@using PDV.Application.Common.Interfaces
@inject ISnackbar Snackbar
@inject IPaymentTerminalService PaymentTerminalService
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5" Class="d-flex align-center gap-2 font-weight-bold mud-text-primary">
            <MudIcon Icon="@Icons.Material.Filled.Payments" />
            Cobro Multipago (Split Payment)
        </MudText>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-4">
            <!-- Resumen de Cuenta -->
            <MudPaper Outlined="true" Class="pa-4 bg-light d-flex justify-space-between align-center border-solid border mud-border-primary">
                <div>
                    <MudText Typo="Typo.subtitle1" Class="mud-text-secondary">TOTAL A COBRAR</MudText>
                    <MudText Typo="Typo.h4" Class="font-weight-bold mud-text-primary">$@TotalAmount.ToString("F2")</MudText>
                </div>
                <div class="text-right">
                    <MudText Typo="Typo.subtitle2" Class="@($"font-weight-bold {(RemainingAmount <= 0 ? "mud-text-success" : "mud-text-error")}")">
                        @(RemainingAmount <= 0 ? "✓ Cubierto" : $"Pendiente: ${RemainingAmount.ToString("F2")}")
                    </MudText>
                    @if (ChangeAmount > 0)
                    {
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold mud-text-success mt-1">Cambio: $@ChangeAmount.ToString("F2")</MudText>
                    }
                </div>
            </MudPaper>

            <!-- Inputs de pago -->
            <MudForm @ref="form">
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudNumericField T="decimal"
                                         Label="Efectivo (Cash)"
                                         @bind-Value="cashAmount"
                                         Format="C2"
                                         Min="0"
                                         Variant="Variant.Outlined"
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.AttachMoney"
                                         HideSpinButtons="true"
                                         Immediate="true"
                                         OnBlur="Recalculate" />
                    </MudItem>

                    <MudItem xs="12">
                        <div class="d-flex flex-column gap-2">
                            <div class="d-flex align-center gap-2">
                                <MudNumericField T="decimal"
                                                 Label="Tarjeta (Debit/Credit Card)"
                                                 @bind-Value="cardAmount"
                                                 Format="C2"
                                                 Min="0"
                                                 Variant="Variant.Outlined"
                                                 Adornment="Adornment.Start"
                                                 AdornmentIcon="@Icons.Material.Filled.CreditCard"
                                                 HideSpinButtons="true"
                                                 Immediate="true"
                                                 Disabled="isCardAuthorized"
                                                 OnBlur="Recalculate"
                                                 Class="flex-grow-1" />
                                
                                @if (cardAmount > 0 && !isCardAuthorized)
                                {
                                    <MudButton Variant="Variant.Filled" 
                                               Color="Color.Primary" 
                                               OnClick="ProcessCardPayment"
                                               Style="height: 56px;"
                                               Class="font-weight-bold"
                                               StartIcon="@Icons.Material.Filled.PowerInput">
                                        Procesar Terminal
                                    </MudButton>
                                }
                            </div>

                            @if (isCardAuthorized)
                            {
                                <MudAlert Severity="Severity.Success" 
                                          Variant="Variant.Filled" 
                                          Style="border-radius: 8px;"
                                          Class="py-1">
                                    <div class="d-flex justify-space-between align-center w-100">
                                        <span>
                                            <strong>Pago Aprobado:</strong> @cardBrand *xxxx-@cardLastFour (Aut: @cardAuthCode, ID: @cardTxId)
                                        </span>
                                        <MudButton Variant="Variant.Text" 
                                                   Color="Color.Inherit" 
                                                   Size="Size.Small" 
                                                   OnClick="CancelCardPayment"
                                                   Class="ml-4 font-weight-bold">
                                            Deshacer
                                        </MudButton>
                                    </div>
                                </MudAlert>
                            }
                        </div>
                    </MudItem>

                    <MudItem xs="12">
                        <MudNumericField T="decimal"
                                         Label="Transferencia (Transfer)"
                                         @bind-Value="transferAmount"
                                         Format="C2"
                                         Min="0"
                                         Variant="Variant.Outlined"
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.AccountBalance"
                                         HideSpinButtons="true"
                                         Immediate="true"
                                         OnBlur="Recalculate" />
                    </MudItem>
                </MudGrid>
            </MudForm>

            <!-- Quick payment helpers for cash -->
            @if (RemainingAmount > 0)
            {
                <div class="d-flex flex-wrap gap-2 mt-2">
                    <MudText Typo="Typo.caption" Class="w-100 mud-text-secondary">Efectivo rápido:</MudText>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => AddQuickCash(RemainingAmount))">Exacto ($@RemainingAmount.ToString("F2"))</MudButton>
                    @foreach (var bill in QuickBills)
                    {
                        @if (bill > RemainingAmount)
                        {
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => AddQuickCash(bill))">$@bill.ToString("F0")</MudButton>
                        }
                    }
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Secondary" Variant="Variant.Outlined">Cancelar</MudButton>
        <MudButton OnClick="Submit" 
                   Color="Color.Success" 
                   Variant="Variant.Filled" 
                   Disabled="@(RemainingAmount > 0)"
                   Class="px-6 font-weight-bold">
            Confirmar Cobro
        </MudButton>
    </DialogActions>
</MudDialog>

<MudOverlay Visible="processingPayment" DarkBackground="true" Absolute="true" ZIndex="9999">
    <div class="d-flex flex-column align-center justify-center gap-4 pa-6" style="max-width: 400px; text-align: center; background: #1a1a2e; border-radius: 12px; border: 2px solid var(--mud-palette-primary);">
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        <MudText Typo="Typo.h6" Class="font-weight-bold text-white">Procesando Pago</MudText>
        <MudText Typo="Typo.body1" Class="text-white">Monto: <strong>$@cardAmount.ToString("F2")</strong></MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Por favor, aproxima, inserta o desliza la tarjeta en la terminal bancaria...</MudText>
        
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Error" 
                   OnClick="CancelProcessing" 
                   Class="mt-2 font-weight-bold"
                   StartIcon="@Icons.Material.Filled.Cancel">
            Cancelar Operación
        </MudButton>
    </div>
</MudOverlay>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public decimal TotalAmount { get; set; }

    private decimal cashAmount;
    private decimal cardAmount;
    private decimal transferAmount;
    
    private MudForm form = default!;

    private decimal TotalPaid => cashAmount + cardAmount + transferAmount;
    private decimal RemainingAmount => Math.Max(0, TotalAmount - TotalPaid);
    
    // Change is calculated ONLY from cash payments when the total paid exceeds total amount
    private decimal ChangeAmount
    {
        get
        {
            if (TotalPaid <= TotalAmount) return 0;
            var excess = TotalPaid - TotalAmount;
            return Math.Min(cashAmount, excess);
        }
    }

    private readonly decimal[] QuickBills = { 20, 50, 100, 200, 500, 1000 };

    private bool isCardAuthorized = false;
    private string cardAuthCode = string.Empty;
    private string cardTxId = string.Empty;
    private string cardBrand = string.Empty;
    private string cardLastFour = string.Empty;
    
    private bool processingPayment = false;
    private CancellationTokenSource? paymentCts;

    private void AddQuickCash(decimal amount)
    {
        cashAmount = amount;
        Recalculate();
    }

    private void Recalculate()
    {
        // Force Blazor re-render of calculated values
        StateHasChanged();
    }

    private async Task ProcessCardPayment()
    {
        if (processingPayment) return;
        
        processingPayment = true;
        paymentCts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            var port = Configuration["Hardware:PaymentTerminal:Port"] ?? "MOCK";
            var protocol = Configuration["Hardware:PaymentTerminal:Protocol"] ?? "Mock";
            var reference = $"REF-{DateTime.UtcNow.Ticks.ToString()[..8]}";

            var result = await PaymentTerminalService.ProcessPaymentAsync(
                cardAmount, 
                reference, 
                "Sale", 
                protocol, 
                port, 
                paymentCts.Token);

            if (result.Success)
            {
                isCardAuthorized = true;
                cardAuthCode = result.AuthorizationCode;
                cardTxId = result.TransactionId;
                cardBrand = result.Brand;
                cardLastFour = result.LastFour;
                
                Snackbar.Add($"Pago con tarjeta aprobado. Aut: {result.AuthorizationCode}", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Transacción declinada: {result.Message}", Severity.Error);
            }
        }
        catch (OperationCanceledException)
        {
            Snackbar.Add("Operación cancelada por el usuario.", Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al procesar pago: {ex.Message}", Severity.Error);
        }
        finally
        {
            processingPayment = false;
            paymentCts?.Dispose();
            paymentCts = null;
            StateHasChanged();
        }
    }

    private async Task CancelCardPayment()
    {
        if (!isCardAuthorized) return;
        
        processingPayment = true;
        StateHasChanged();

        try
        {
            var port = Configuration["Hardware:PaymentTerminal:Port"] ?? "MOCK";
            var protocol = Configuration["Hardware:PaymentTerminal:Protocol"] ?? "Mock";

            var result = await PaymentTerminalService.CancelPaymentAsync(
                cardTxId, 
                protocol, 
                port);

            if (result.Success)
            {
                isCardAuthorized = false;
                cardAuthCode = string.Empty;
                cardTxId = string.Empty;
                cardBrand = string.Empty;
                cardLastFour = string.Empty;
                cardAmount = 0; // reset
                
                Snackbar.Add("Cobro con tarjeta cancelado / devuelto exitosamente.", Severity.Info);
            }
            else
            {
                Snackbar.Add($"No se pudo cancelar el cobro: {result.Message}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cancelar cobro: {ex.Message}", Severity.Error);
        }
        finally
        {
            processingPayment = false;
            StateHasChanged();
        }
    }

    private void CancelProcessing()
    {
        paymentCts?.Cancel();
    }

    private void Submit()
    {
        if (TotalPaid < TotalAmount)
        {
            Snackbar.Add("El monto pagado es insuficiente.", Severity.Error);
            return;
        }

        // Determine the primary payment method for database compatibility
        string primaryMethod = "Cash";
        decimal maxAmount = cashAmount;

        if (cardAmount > maxAmount)
        {
            primaryMethod = "CreditCard"; // Maps to DebitCard or CreditCard
            maxAmount = cardAmount;
        }
        if (transferAmount > maxAmount)
        {
            primaryMethod = "Transfer";
        }

        var result = new SplitPaymentResult(
            CashAmount: cashAmount,
            CardAmount: cardAmount,
            TransferAmount: transferAmount,
            PrimaryMethod: primaryMethod,
            Change: ChangeAmount,
            CardTransactionId: cardTxId,
            CardAuthCode: cardAuthCode
        );

        MudDialog.Close(DialogResult.Ok(result));
    }

    private async Task Cancel()
    {
        if (isCardAuthorized)
        {
            var confirm = await DialogService.ShowMessageBox(
                "Pago Autorizado Activo",
                "Ya se ha procesado un cargo a la tarjeta. Para salir, primero debes deshacer/cancelar el cobro con tarjeta. ¿Deseas deshacerlo ahora?",
                yesText: "Sí, Deshacer", noText: "No");

            if (confirm == true)
            {
                await CancelCardPayment();
            }
            return;
        }
        MudDialog.Cancel();
    }

    public record SplitPaymentResult(
        decimal CashAmount,
        decimal CardAmount,
        decimal TransferAmount,
        string PrimaryMethod,
        decimal Change,
        string? CardTransactionId = null,
        string? CardAuthCode = null
    );
}
